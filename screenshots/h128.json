  "reserve_stock": [
   "73: public function reserve_stock_for_order( $order, $minutes = 60 ) {",
   "74: if ( ! $this->is_enabled() ) {",
   "75: return;",
   "76: }",
   "77: ",
   "78: /**",
   "79: * Filters the number of minutes an order should reserve stock for.",
   "80: *",
   "81: * This hook allows the number of minutes that stock in an order should be reserved for to be filtered, useful for third party developers to increase/reduce t",
   "82: *",
   "83: * @since 8.8.0",
   "84: *",
   "85: * @param int       $minutes How long to reserve stock for the order in minutes.",
   "86: * @param \\WC_Order $order Order object.",
   "87: */",
   "88: $minutes = (int) apply_filters( 'woocommerce_order_hold_stock_minutes', $minutes, $order );",
   "89: if ( ! $minutes ) {",
   "90: return;",
   "91: }",
   "92: ",
   "93: $held_stock_notes = array();",
   "94: try {",
   "95: $rows = array();",
   "96: ",
   "97: foreach ( $order->get_items() as $item ) {",
   "98: $is_target_item = $item->is_type( OrderItemType::LINE_ITEM ) && $item->get_quantity() > 0;",
   "99: if ( ! $is_target_item ) {",
   "100: continue;",
   "101: }",
   "102: ",
   "103: /** @var \\WC_Order_Item_Product $item */ // phpcs:ignore Generic.Commenting.DocComment.MissingShort",
   "104: $product = $item->get_product();",
   "105: if ( ! $product instanceof \\WC_Product ) {",
   "106: continue;",
   "107: }",
   "108: ",
   "109: if ( ! $product->is_in_stock() ) {",
   "110: throw new ReserveStockException(",
   "111: 'woocommerce_product_out_of_stock',",
   "112: sprintf(",
   "113: /* translators: %s: product name */",
   "114: __( '&quot;%s&quot; is out of stock and cannot be purchased.', 'woocommerce' ),",
   "115: $product->get_name()",
   "116: ),",
   "117: 403",
   "118: );",
   "119: }",
   "120: ",
   "121: // If stock management is off, no need to reserve any stock here.",
   "122: if ( ! $product->managing_stock() || $product->backorders_allowed() ) {",
   "123: continue;",
   "124: }",
   "125: ",
   "126: $managed_by_id = $product->get_stock_managed_by_id();",
   "127: ",
   "128: /**",
   "129: * Filter order item quantity.",
   "130: *",
   "131: * @since 4.5.0",
   "132: * @param int|float              $quantity Quantity.",
   "133: * @param \\WC_Order              $order    Order data.",
   "134: * @param \\WC_Order_Item_Product $item     Order item data.",
   "135: */",
   "136: $item_quantity = apply_filters( 'woocommerce_order_item_quantity', $item->get_quantity(), $order, $item );",
   "137: ",
   "138: $rows[ $managed_by_id ] = $item_quantity + ( $rows[ $managed_by_id ] ?? 0 );",
   "139: ",
   "140: if ( count( $held_stock_notes ) < 5 ) {",
   "141: // translators: %1$s is a product's formatted name, %2$d: is the quantity of said product to which the stock hold applied.",
   "142: $held_stock_notes[] = sprintf( _x( '- %1$s &times; %2$d', 'held stock note', 'woocommerce' ), $product->get_formatted_name(), $rows[ $managed_by_id ] );",
   "143: }",
   "144: }",
   "145: ",
   "146: if ( ! empty( $rows ) ) {",
   "147: // Reliability: consistent lock order = no cross-product ordering deadlocks from concurrent orders with same products added in different sequences.",
   "148: ksort( $rows );",
   "149: foreach ( $rows as $product_id => $quantity ) {",
   "150: $this->reserve_stock_for_product( $product_id, $quantity, $order, $minutes );",
   "151: }",
   "152: }",
   "153: } catch ( ReserveStockException $e ) {",
   "154: $this->release_stock_for_order( $order );",
   "155: throw $e;",
   "156: }",
   "157: ",
   "158: // Add order note after successfully holding the stock.",
   "159: if ( ! empty( $held_stock_notes ) ) {",
   "160: $remaining_count = count( $rows ) - count( $held_stock_notes );",
   "161: if ( $remaining_count > 0 ) {",
   "162: $held_stock_notes[] = sprintf(",
   "163: // translators: %d is the remaining order items count.",
   "164: _nx( '- ...and %d more item.', '- ... and %d more items.', $remaining_count, 'held stock note', 'woocommerce' ),",
   "165: $remaining_count",
   "166: );",
   "167: }",
   "168: ",
   "169: $order->add_order_note(",
   "170: sprintf(",
   "171: // translators: %1$s is a time in minutes, %2$s is a list of products and quantities.",
   "172: _x( 'Stock hold of %1$s minutes applied to: %2$s', 'held stock note', 'woocommerce' ),",
   "173: $minutes,",
   "174: '<br>' . implode( '<br>', $held_stock_notes )",
   "175: ),",
   "176: false,",
   "177: false,",
   "178: array(",
   "179: 'note_group' => OrderNoteGroup::PRODUCT_STOCK,",
   "180: )",
   "181: );",
   "182: }",
   "183: }"
