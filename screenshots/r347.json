   "177: \t\t\t\treturn new WP_REST_Response(array('status'=>'system_error','reason_codes'=>array('SYSTEM_ERROR'),'message_lt'=>'Sistemos klaida.'), 200);",
   "178: \t\t\t}",
   "179: \t\t\t$p = $req->get_json_params(); if ( ! is_array($p) ) $p = array();",
   "180: \t\t\t// S278: faktinės porcijos kelias — svorio nereikia.",
   "181: \t\t\tif ( isset($p['portion_g']) && $p['portion_g'] !== '' && $p['portion_g'] !== null ) {",
