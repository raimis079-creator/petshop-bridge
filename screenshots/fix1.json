   "489 // Prevents stale session data from being saved when user switched to a non-terminal method.",
   "490 $order_instance_id = null;",
   "491 foreach ($order->get_shipping_methods() as $item) {",
   "492 if ($item->get_method_id() === 'woo_lithuaniapost_lpexpress_terminal') {",
   "493 $order_instance_id = $item->get_instance_id();",
   "494 break;",
   "495 }",
   "496 }",
   "497 $order_plan = $order_instance_id ? $this->get_method_settings_value($order_instance_id, 'plan') : null;",
   "498 ",
   "499 $saved_terminal_id = $this->get_selected_terminal_id();",
   "500 // Save terminal id",
   "501 if ($order_plan === 'TERMINAL' && isset ($saved_terminal_id)) {",
   "502 ",
   "503 $terminal_id = sanitize_text_field($saved_terminal_id);",
   "504 ",
   "505 $terminal = apply_filters('woo_lithuaniapost_terminal_service_get_terminal_by_id', $terminal_id);",
   "506 ",
   "507 if ($terminal) {",
   "508 $order->update_meta_data('_woo_lithuaniapost_lpexpress_terminal_id', $terminal_id);",
   "509 $order->update_meta_data('_woo_lithuaniapost_lpexpress_terminal', sprintf('%s - %s, %s', $terminal [0]->name, $terminal [0]->addre",
   "510 }",
   "511 }",
   "512 $order->save();",
   "513 }",
   "514 ",
   "515 /**"
