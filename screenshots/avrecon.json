  "avatar_kodas": "<?php\n/**\n * Petshop_Account_Avatar — paskyros avataras.\n *\n * PROBLEMA: WordPress numatytasis „mystery person\" pilkas šešėlis paskyros\n * šone atrodo nebaigtas.\n *\n * SPRENDIMAS be naujos infrastruktūros:\n *  1) jei augintinis turi nuotrauką — rodom JĄ (šiluma ateina iš augintinio,\n *     o ne iš savininko; tai ir yra Petshop skirtumas);\n *  2) kitu atveju — inicialas žaliame apskritime.\n *\n * SĄMONINGAI NEDAROM savininko nuotraukos įkėlimo: tai asmens duomenys,\n * reikalaujantys privatumo politikos peržiūros, o vertė maža — tą avatarą\n * mato tik pats žmogus savo paskyroje.\n */\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nclass Petshop_Account_Avatar {\n\n\tpublic static function init() {\n\t\tadd_filter( 'get_avatar', array( __CLASS__, 'avatar' ), 20, 6 );\n\t}\n\n\t/** Vardas rodymui: tikras vardas pirmiau nei prisijungimo vardas. */\n\tpublic static function display_name( $user_id ) {\n\t\t$u = get_userdata( $user_id );\n\t\tif ( ! $u ) { return ''; }\n\t\t$name = trim( (string) $u->first_name . ' ' . (string) $u->last_name );\n\t\tif ( $name === '' ) { $name = (string) $u->display_name; }\n\t\tif ( $name === '' || strtolower( $name ) === 'admin' ) { $name = (string) $u->user_login; }\n\t\treturn $name;\n\t}\n\n\tprivate static function initial( $user_id ) {\n\t\t$n = self::display_name( $user_id );\n\t\t$n = trim( $n );\n\t\tif ( $n === '' ) { return '?'; }\n\t\treturn function_exists( 'mb_strtoupper' )\n\t\t\t? mb_strtoupper( mb_substr( $n, 0, 1 ) )\n\t\t\t: strtoupper( substr( $n, 0, 1 ) );\n\t}\n\n\t/** Pirmojo (pagrindinio) augintinio nuotrauka, jei tokia yra. */\n\tprivate static function pet_photo_url( $user_id ) {\n\t\tglobal $wpdb;\n\t\t$t = $wpdb->prefix . 'ps_pets';\n\t\tif ( ! $wpdb->get_var( \"SHOW TABLES LIKE '$t'\" ) ) { return null; }\n\t\t$att = $wpdb->get_var( $wpdb->prepare(\n\t\t\t\"SELECT photo_file_id FROM $t\n\t\t\t WHERE user_id = %d AND deleted_at IS NULL AND photo_file_id IS NOT NULL AND photo_file_id > 0\n\t\t\t ORDER BY is_primary DESC, id ASC LIMIT 1\", $user_id ) );\n\t\tif ( ! $att ) { return null; }\n\t\t$src = wp_get_attachment_image_src( (int) $att, 'thumbnail' );\n\t\treturn $src ? $src[0] : null;\n\t}\n\n\tpublic static function avatar( $avatar, $id_or_email, $size, $default, $alt, $args = array() ) {\n\t\t// TIK paskyros puslapiuose. Komentaruose ir wp-admin nieko nekeičiam.\n\t\tif ( is_admin() || ! function_exists( 'is_account_page' ) || ! is_account_page() ) {\n\t\t\treturn $avatar;\n\t\t}\n\t\t$user_id = 0;\n\t\tif ( is_numeric( $id_or_email ) ) { $user_id = (int) $id_or_email; }\n\t\telseif ( $id_or_email instanceof WP_User ) { $user_id = (int) $id_or_email->ID; }\n\t\telseif ( is_string( $id_or_email ) && is_email( $id_or_email ) ) {\n\t\t\t$u = get_user_by( 'email', $id_or_email );\n\t\t\tif ( $u ) { $user_id = (int) $u->ID; }\n\t\t}\n\t\tif ( ! $user_id ) { return $avatar; }\n\n\t\t$px  = max( 40, (int) $size );\n\t\t$css = 'width:' . $px . 'px;height:' . $px . 'px;border-radius:50%;display:inline-flex;'\n\t\t\t. 'align-items:center;justify-content:center;overflow:hidden;flex:0 0 auto;vertical-align:middle;';\n\n\t\t$photo = self::pet_photo_url( $user_id );\n\t\tif ( $photo ) {\n\t\t\treturn '<span class=\"ps-avatar\" style=\"' . esc_attr( $css ) . 'background:#F4F8F5\">'\n\t\t\t\t. '<img src=\"' . esc_url( $photo ) . '\" alt=\"\" '\n\t\t\t\t. 'style=\"width:100%;height:100%;object-fit:cover\" /></span>';\n\t\t}\n\n\t\t$fs = max( 15, (int) round( $px * 0.42 ) );\n\t\treturn '<span class=\"ps-avatar\" style=\"' . esc_attr( $css )\n\t\t\t. 'background:#2F6B4F;color:#fff;font-weight:700;letter-spacing:.01em;'\n\t\t\t. 'font-size:' . $fs . 'px;line-height:1\">'\n\t\t\t. esc_html( self::initial( $user_id ) ) . '</span>';\n\t}\n}\n",
