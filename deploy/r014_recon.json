   "10:  *",
   "11:  * SPRENDIMAS: kaupiam VISUS unikalius numerius SAVO lenteleje.",
   "12:  * Plugin'as gali perrasineti savo lauka kiek nori — musu istorija auga.",
   "13:  *",
   "14:  * SAMONINGAI NESAUGOM: sandelio, konkreciu prekiu ID. Ju patikimo saltinio",
   "15:  * NETURIME (Venipak raso pack_numbers visam uzsakymui), o „inferred\" reiksmes",
   "16:  * veliau taptu melagingais duomenimis.",
   "17:  *",
   "18:  * SAMONINGAI NEDAROM: naujo WooCommerce order statuso (Pragma eksporto ir",
   "19:  * saskaitu seriju rizika pries launch) ir papildomu automatiniu laisku.",
   "20:  *",
   "21:  * @package petshop-core",
   "22:  * @since 0.20.0 (S319, 2026-07-31)",
   "23:  */",
   "24: ",
   "25: if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "26: ",
   "27: class Petshop_Shipments {",
   "28: ",
   "29: \tconst DB_VERSION = '1.0.0';",
   "30: \tconst OPT_DB_VER = 'petshop_shipments_db';",
   "31: ",
   "32: \t/* ------------------------------------------------------------------ */",
   "33: \t/* Lentele                                                            */",
   "34: \t/* ------------------------------------------------------------------ */",
   "35: ",
   "36: \tpublic static function table() {",
   "37: \t\tglobal $wpdb; return $wpdb->prefix . 'ps_shipments';",
   "38: \t}",
   "39: ",
   "40: \tpublic static function install() {",
   "41: \t\tglobal $wpdb;",
   "42: \t\trequire_once ABSPATH . 'wp-admin/includes/upgrade.php';",
   "43: \t\t$t  = self::table();",
   "44: \t\t$cs = $wpdb->get_charset_collate();",
   "45: \t\tdbDelta( \"CREATE TABLE $t (",
   "46: \t\t\tid BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,",
   "47: \t\t\tshipment_id VARCHAR(64) NOT NULL,",
   "48: \t\t\torder_id BIGINT UNSIGNED NOT NULL,",
   "49: \t\t\tcarrier VARCHAR(32) NOT NULL,",
   "50: \t\t\ttracking_number VARCHAR(64) NOT NULL,",
   "51: \t\t\ttracking_url VARCHAR(255) NULL DEFAULT NULL,",
   "52: \t\t\tsource VARCHAR(32) NOT NULL DEFAULT 'venipak_plugin',",
   "53: \t\t\tcreated_at DATETIME NOT NULL,",
   "54: \t\t\tnotified_at DATETIME NULL DEFAULT NULL,",
   "55: \t\t\tPRIMARY KEY (id),",
   "56: \t\t\tUNIQUE KEY order_carrier_nr (order_id, carrier, tracking_number),",
   "57: \t\t\tKEY shipment_id (shipment_id),",
   "58: \t\t\tKEY order_idx (order_id),",
   "59: \t\t\tKEY notified (notified_at)",
   "60: \t\t) $cs;\" );",
   "61: \t\tupdate_option( self::OPT_DB_VER, self::DB_VERSION );",
   "62: \t}",
   "63: ",
   "64: \tpublic static function maybe_install() {",
   "65: \t\tif ( get_option( self::OPT_DB_VER ) !== self::DB_VERSION ) { self::install(); }",
   "66: \t}",
   "67: ",
   "68: \t/* ------------------------------------------------------------------ */",
   "69: \t/* Irasymas                                                           */",
   "70: \t/* ------------------------------------------------------------------ */",
   "71: ",
   "72: \t/**",
   "73: \t * Idempotentiskas: UNIQUE(order_id, carrier, tracking_number).",
   "74: \t * @return string added | exists | invalid",
   "75: \t */",
   "76: \tpublic static function record( $order_id, $carrier, $number, $url = '', $source = 'venipak_plugin' ) {",
   "77: \t\tglobal $wpdb;",
   "78: \t\t$order_id = (int) $order_id;",
   "79: \t\t$number   = trim( (string) $number );",
   "80: \t\t$carrier  = trim( (string) $carrier );",
   "81: \t\tif ( ! $order_id || '' === $number || '' === $carrier ) { return 'invalid'; }",
   "82: ",
   "83: \t\t$exists = $wpdb->get_var( $wpdb->prepare(",
   "84: \t\t\t\"SELECT id FROM \" . self::table() . \"",
   "85: \t\t\t WHERE order_id=%d AND carrier=%s AND tracking_number=%s LIMIT 1\",",
   "86: \t\t\t$order_id, $carrier, $number ) );",
   "87: \t\tif ( $exists ) { return 'exists'; }",
   "88: ",
   "89: \t\t$wpdb->insert( self::table(), array(",
   "90: \t\t\t'shipment_id'     => 'shp_' . substr( md5( $order_id . '|' . $carrier . '|' . $number ), 0, 16 ),",
   "91: \t\t\t'order_id'        => $order_id,",
   "92: \t\t\t'carrier'         => substr( $carrier, 0, 32 ),",
   "93: \t\t\t'tracking_number' => substr( $number, 0, 64 ),",
   "94: \t\t\t'tracking_url'    => $url ? substr( $url, 0, 255 ) : null,",
   "95: \t\t\t'source'          => substr( $source, 0, 32 ),",
   "96: \t\t\t'created_at'      => current_time( 'mysql', true ),",
   "97: \t\t) );",
   "98: \t\treturn $wpdb->insert_id ? 'added' : 'failed';",
   "99: \t}",
   "100: ",
   "101: \tpublic static function get_for_order( $order_id ) {",
   "102: \t\tglobal $wpdb;",
   "103: \t\treturn $wpdb->get_results( $wpdb->prepare(",
   "104: \t\t\t\"SELECT * FROM \" . self::table() . \" WHERE order_id=%d ORDER BY id ASC\", (int) $order_id ), ARRAY_A );",
   "105: \t}",
   "106: ",
   "107: \tpublic static function mark_notified( $order_id ) {",
   "108: \t\tglobal $wpdb;",
   "109: \t\treturn (int) $wpdb->query( $wpdb->prepare(",
   "110: \t\t\t\"UPDATE \" . self::table() . \" SET notified_at=%s WHERE order_id=%d AND notified_at IS NULL\",",
   "111: \t\t\tcurrent_time( 'mysql', true ), (int) $order_id ) );",
   "112: \t}",
   "113: ",
   "114: \t/* ------------------------------------------------------------------ */",
   "115: \t/* Sinchronizacija is plugin'u meta                                   */",
   "116: \t/* ------------------------------------------------------------------ */",
   "117: ",
   "118: \t/**",
   "119: \t * Nuskaito DABARTINE plugin'u meta busena ir ideda TRUKSTAMUS numerius.",
   "120: \t * Kvieciama kiekvieno uzsakymo issaugojimo metu — NEPRIKLAUSOMAI nuo to,",
   "121: \t * ar order_shipped eventas jau buvo emit'intas. Kitaip antra siunta",
   "122: \t * liktu nematoma.",
   "123: \t */",
   "124: \tpublic static function sync_from_meta( $order ) {",
   "125: \t\tif ( ! is_object( $order ) || ! method_exists( $order, 'get_id' ) ) { return array(); }",
   "126: \t\t$out = array();",
   "127: ",
   "128: \t\t// --- Venipak ---",
   "129: \t\t$raw = $order->get_meta( 'venipak_shipping_order_data', true );",
   "130: \t\tif ( $raw ) {",
   "131: \t\t\t$d = json_decode( (string) $raw, true );",
   "132: \t\t\t$packs = ( is_array( $d ) && ! empty( $d['pack_numbers'] ) && is_array( $d['pack_numbers'] ) )",
   "133: \t\t\t\t? $d['pack_numbers'] : array();",
   "134: \t\t\tforeach ( array_unique( array_map( 'strval', $packs ) ) as $pn ) {",
   "135: \t\t\t\tif ( '' === trim( $pn ) ) { continue; }",
   "136: \t\t\t\t$out[] = array( 'carrier' => 'venipak', 'number' => $pn,",
   "137: \t\t\t\t\t'url' => 'https://venipak.lt/tracking/track/' . rawurlencode( $pn ),",
   "138: \t\t\t\t\t'res' => self::record( $order->get_id(), 'venipak', $pn,",
   "139: \t\t\t\t\t\t'https://venipak.lt/tracking/track/' . rawurlencode( $pn ), 'venipak_plugin' ) );",
   "140: \t\t\t}",
   "141: \t\t}",
   "142: ",
   "143: \t\t// --- LP Express ---",
   "144: \t\t$lp = $order->get_meta( '_woo_lithuaniapost_barcode', true );",
   "145: \t\tif ( $lp ) {",
   "146: \t\t\tforeach ( array_unique( array_filter( (array) $lp ) ) as $bc ) {",
   "147: \t\t\t\t$bc = (string) $bc;",
   "148: \t\t\t\tif ( '' === trim( $bc ) ) { continue; }",
   "149: \t\t\t\t$url = 'https://www.post.lt/siuntu-sekimas?parcels=' . rawurlencode( $bc );",
   "150: \t\t\t\t$out[] = array( 'carrier' => 'lp_express', 'number' => $bc, 'url' => $url,",
   "151: \t\t\t\t\t'res' => self::record( $order->get_id(), 'lp_express', $bc, $url, 'lp_express_plugin' ) );",
   "152: \t\t\t}",
   "153: \t\t}",
   "154: ",
   "155: \t\treturn $out;",
   "156: \t}",
   "157: ",
   "158: \t/* ------------------------------------------------------------------ */",
   "159: \t/* Skaitymas laiskui                                                  */",
   "160: \t/* ------------------------------------------------------------------ */",
   "161: ",
   "162: \t/**",
   "163: \t * PAGRINDINIS saltinis — musu lentele.",
   "164: \t * FALLBACK — dabartine plugin'u meta (migracijai / praleistam hook'ui).",
   "165: \t * Trukstami numeriai ISKART irasomi i lentele.",
   "166: \t *",
   "167: \t * @return array siuntu sarasas: carrier, carrier_label, number, url",
   "168: \t */",
   "169: \tpublic static function resolve_all( $order ) {",
   "170: \t\tif ( ! is_object( $order ) ) { return array(); }",
   "171: ",
   "172: \t\t// 1) papildom is meta (idempotentiska)",
   "173: \t\tself::sync_from_meta( $order );",
   "174: ",
   "175: \t\t// 2) skaitom is lenteles",
   "176: \t\t$rows = self::get_for_order( $order->get_id() );",
   "177: \t\t$list = array();",
   "178: \t\t$seen = array();",
   "179: \t\tforeach ( (array) $rows as $r ) {",
   "180: \t\t\t$key = $r['carrier'] . '|' . $r['tracking_number'];",
   "181: \t\t\tif ( isset( $seen[ $key ] ) ) { continue; }",
   "182: \t\t\t$seen[ $key ] = 1;",
   "183: \t\t\t$list[] = array(",
   "184: \t\t\t\t'carrier'       => $r['carrier'],",
   "185: \t\t\t\t'carrier_label' => self::label( $r['carrier'] ),",
   "186: \t\t\t\t'number'        => $r['tracking_number'],",
   "187: \t\t\t\t'url'           => $r['tracking_url'],",
   "188: \t\t\t);",
   "189: \t\t}",
   "190: \t\treturn $list;",
   "191: \t}",
   "192: ",
   "193: \tpublic static function label( $carrier ) {",
   "194: \t\t$m = array( 'venipak' => 'Venipak', 'lp_express' => 'LP Express' );",
   "195: \t\treturn isset( $m[ $carrier ] ) ? $m[ $carrier ] : ucfirst( (string) $carrier );",
   "196: \t}",
   "197: ",
   "198: \tpublic static function stats() {",
   "199: \t\tglobal $wpdb; $t = self::table();",
   "200: \t\treturn array(",
   "201: \t\t\t'total'       => (int) $wpdb->get_var( \"SELECT COUNT(*) FROM $t\" ),",
   "202: \t\t\t'by_carrier'  => $wpdb->get_results( \"SELECT carrier, COUNT(*) c FROM $t GROUP BY carrier\", ARRAY_A ),",
   "203: \t\t\t'multi_orders'=> (int) $wpdb->get_var(",
   "204: \t\t\t\t\"SELECT COUNT(*) FROM ( SELECT order_id FROM $t GROUP BY order_id HAVING COUNT(*) > 1 ) x\" ),",
   "205: \t\t);",
   "206: \t}",
   "207: }"
  ]
