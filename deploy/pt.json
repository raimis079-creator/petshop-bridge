  "partijos_240_285": [
   "241: \t\t\t'partijos_id' => $partijos_id,",
   "242: \t\t\t'kiekis'      => $kiekis,",
   "243: \t\t\t'savikaina'   => $sav_eur,",
   "244: \t\t\t'likutis'     => $buvo + $kiekis,",
   "245: \t\t\t'savikaina_prekes' => $nauja_sav,",
   "246: \t\t);",
   "247: \t}",
   "248: ",
   "249: \t/* ============================================================",
   "250: \t *  AV LIKUTIS — kur rasyti",
   "251: \t * ============================================================ */",
   "252: ",
   "253: \t/**",
   "254: \t * S590 taisykle: preke be tiekejo -> `_stock`; su tiekeju -> `_own_stock_qty`.",
   "255: \t * Sis modulis ta pacia taisykle ir taiko, kad neatsirastu antro kelio.",
   "256: \t */",
   "257: \tpublic static function av_laukas( $pid ) {",
   "258: \t\tforeach ( array( '_vf_qty', '_zb_qty' ) as $k ) {",
   "259: \t\t\tif ( get_post_meta( $pid, $k, true ) !== '' ) { return '_own_stock_qty'; }",
   "260: \t\t}",
   "261: \t\treturn '_stock';",
   "262: \t}",
   "263: ",
   "264: \tpublic static function av_likutis( $pid ) {",
   "265: \t\t$v = get_post_meta( $pid, self::av_laukas( $pid ), true );",
   "266: \t\treturn ( $v === '' || $v === null ) ? 0 : (int) $v;",
   "267: \t}",
   "268: ",
   "269: \tprivate static function rasyti_av_likuti( $pid, $kiekis ) {",
   "270: \t\t$kiekis = max( 0, (int) $kiekis );",
   "271: \t\t$laukas = self::av_laukas( $pid );",
   "272: ",
   "273: \t\tif ( $laukas === '_stock' ) {",
   "274: \t\t\t/* Per WC CRUD, kad atsinaujintu lookup lentele ir transientai.",
   "275: \t\t\t   `update_post_meta` cia paliktu parduotuve rodancia sena likuti. */",
   "276: \t\t\t$prod = wc_get_product( $pid );",
   "277: \t\t\tif ( $prod ) {",
   "278: \t\t\t\t$prod->set_manage_stock( true );",
   "279: \t\t\t\t$prod->set_stock_quantity( $kiekis );",
   "280: \t\t\t\t$prod->save();",
   "281: \t\t\t\treturn;",
   "282: \t\t\t}",
   "283: \t\t}",
   "284: \t\tupdate_post_meta( $pid, $laukas, $kiekis );",
   "285: \t}"
  ],
