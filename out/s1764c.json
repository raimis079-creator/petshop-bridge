  "laisku_nuotraukos": {
   "md5": "5b2f644845d5683a4148ee3c996d3f29",
   "kodas": "<?php\n/**\n * Plugin Name: Petshop laiškų nuotraukos\n * Description: Svetainės laiškuose (wp_mail) nuotraukoms iš /wp-content/uploads/ prideda ?ps_mail=1 — uploads/.htaccess tokiam adresui WebP neatiduoda. Outlook (Windows) WebP nerodo.\n * Version: 1.0\n *\n * S1741 (2026-09-30). KODĖL: uploads/.htaccess „Petshop WebP (S1567)\" klientui su `Accept: image/webp` tuo pačiu .jpg/.png\n * adresu atiduoda šalia esantį .webp. Outlook siunčia tokį Accept, gauna WebP ir rodo tuščią langelį („The linked image\n * cannot be displayed\"). Užsakymo laiškuose (logotipas + prekių miniatiūros), refill/win-back laiškuose — visur.\n * DABAR: filtras `wp_mail` (prio 5) — <img src> į šios svetainės uploads .jpg/.jpeg/.png gauna `ps_mail=1`;\n * uploads/.htaccess WebP taisyklė su šiuo parametru nesuveikia → atiduodamas originalas. Naršyklėms nieko nekeičia.\n * IŠJUNGTI: opcija `ps_laisku_nuotraukos_isjungta` = 1 arba ištrinti failą (tada grąžinti ir .htaccess eilutę nebūtina).\n */\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class Petshop_Laisku_Nuotraukos {\n\tconst V = '1.0';\n\n\tpublic static function init() {\n\t\tadd_filter( 'wp_mail', array( __CLASS__, 'wp_mail' ), 5 );\n\t}\n\n\tpublic static function wp_mail( $a ) {\n\t\tif ( get_option( 'ps_laisku_nuotraukos_isjungta' ) || ! is_array( $a ) || empty( $a['message'] ) || ! is_string( $a['message'] ) ) {\n\t\t\treturn $a;\n\t\t}\n\t\tif ( false === stripos( $a['message'], '<img' ) ) {\n\t\t\treturn $a;\n\t\t}\n\t\t$a['message'] = self::html( $a['message'] );\n\t\treturn $a;\n\t}\n\n\t/** Visiems <img src=\"…\"> HTML tekste. */\n\tpublic static function html( $h ) {\n\t\t$out = preg_replace_callback(\n\t\t\t'#(<img\\b[^>]*?\\bsrc\\s*=\\s*)([\"\\'])([^\"\\']+)\\2#i',\n\t\t\tfunction ( $m ) {\n\t\t\t\treturn $m[1] . $m[2] . self::url( $m[3] ) . $m[2];\n\t\t\t},\n\t\t\t$h\n\t\t);\n\t\treturn is_string( $out ) ? $out : $h;\n\t}\n\n\t/** Tik šios svetainės uploads .jpg/.jpeg/.png; jau pažymėtų neliečia. */\n\tpublic static function url( $u ) {\n\t\t$host = wp_parse_url( home_url(), PHP_URL_HOST );\n\t\t$d    = html_entity_decode( $u, ENT_QUOTES );\n\t\t$re   = '#^(https?:)?//(www\\.)?' . preg_quote( (string) $host, '#' ) . '/wp-content/uploads/[^?\\#]+\\.(jpe?g|png)(\\?[^\\#]*)?$#i';\n\t\tif ( ! preg_match( $re, $d ) || preg_match( '/[?&]ps_mail=1(&|$)/', $d ) ) {\n\t\t\treturn $u;\n\t\t}\n\t\treturn $u . ( false === strpos( $u, '?' ) ? '?' : '&amp;' ) . 'ps_mail=1';\n\t}\n}\nPetshop_Laisku_Nuotraukos::init();\n"
  },
  "refill_sablonas": "<?php\n/**\n * Šablonas: refill_due — „Pakartoti užsakymą\" v1.7 (S1749 10-03: prekės be atskirų nuorodų — Sender su ~39 nuorodomis atsakydavo po 30 s 502 klaida; lieka 3 nuorodos) · v1.6 (S1685, Raimio tekstas 09-15; tema klausimu, footer brūkšnys): visos paskutinio užsakymo sekamos maisto prekės su miniatiūromis, kiekiais, kainomis, suma; vienas stiprus mygtukas į kasą (Petshop_Pakartoti::url).\n * Be įdėtų 100 % pločio lentelių (Outlook išmeta už paraščių); be augintinio vardo (linksniai); be nuolaidų (principas: Petshop prisimena, kada papildyti — ne „palauk laiško ir gausi −10 %\").\n * Kintamieji: $payload, $flow_class, $recipient. Nustato $subject.\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n$email = isset( $recipient ) ? $recipient : ''; $fc = isset( $flow_class ) ? $flow_class : 'service';\n$d = class_exists( 'Petshop_Pakartoti' ) ? Petshop_Pakartoti::duomenys( $payload, $email ) : array( 'prekes' => array(), 'nera' => array(), 'suma' => 0, 'data' => '', 'kasa' => '', 'optout' => '' );\n$fb_url = isset( $payload['feedback_url'] ) ? $payload['feedback_url'] : '';\n$n = count( $d['prekes'] ); $eur = function( $v ) { return number_format( (float) $v, 2, ',', ' ' ) . ' €'; };\n\n$subject = 'Ar ne laikas papildyti atsargas?';\n\n$body = Petshop_Email_Layout::p( 'Pagal ankstesnį užsakymą, ' . ( $d['data'] ? 'apie ' . esc_html( $d['data'] ) . ' ' : 'netrukus ' ) . 'gali būti laikas papildyti ' . ( $n > 1 ? 'šių prekių' : 'šios prekės' ) . ' atsargas.' );\nif ( $n ) {\n\t$eil = '';\n\tforeach ( $d['prekes'] as $pr ) {\n\t\t$img = ''; $po = wc_get_product( $pr['pid'] ); $iid = $po ? $po->get_image_id() : 0; $iu = $iid ? wp_get_attachment_image_url( $iid, 'thumbnail' ) : '';\n\t\tif ( $iu ) $img = '<img src=\"' . esc_url( $iu ) . '\" width=\"64\" height=\"64\" alt=\"\" align=\"left\" style=\"width:64px;height:64px;border:0;border-radius:6px;margin:0 12px 0 0;display:block;\">';\n\t\t$eil .= '<div style=\"padding:8px 0;border-bottom:1px solid #EEEEEE;overflow:hidden;\">' . $img . '<div style=\"min-height:64px;line-height:1.45;\"><span style=\"color:#1F2A24;\">' . esc_html( $pr['pav'] ) . '</span><br><span style=\"color:#7A867C;\">' . (int) $pr['kiekis'] . ' vnt. · ' . esc_html( $eur( $pr['kaina'] ) ) . '</span></div><div style=\"clear:both;\"></div></div>';\n\t}\n\tif ( $n > 1 ) $eil .= '<div style=\"padding:9px 0 0;font-weight:700;\">Iš viso: ' . esc_html( $eur( $d['suma'] ) ) . '</div>';\n\t$body .= Petshop_Email_Layout::p( $eil, 14 );\n}\nif ( $d['nera'] ) {\n\t$nera = array_values( array_unique( array_map( function( $x ) { return preg_replace( '/ \\(trūksta:.*\\)$/u', '', $x ); }, $d['nera'] ) ) ); $kn = count( $nera );\n\t$body .= Petshop_Email_Layout::p( ( $kn > 1 ? 'Kelių ankstesnio užsakymo prekių šiuo metu neturime, todėl jų neįtraukėme: ' : 'Vienos ankstesnio užsakymo prekės šiuo metu neturime, todėl jos neįtraukėme: ' ) . esc_html( implode( '; ', $nera ) ) . '.', 14 );\n}\n$body .= Petshop_Email_Layout::p( ( $n > 1 ? 'Turimas prekes' : 'Prekę' ) . ' galite pakartoti vienu paspaudimu. Kiekius prieš apmokėdami galėsite pakeisti.' );\nif ( $d['kasa'] && $n ) {\n\t$body .= '<tr><td style=\"padding:4px 0 26px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:separate;\"><tr><td align=\"center\" bgcolor=\"#2d6a35\" style=\"background:#2d6a35;border-radius:8px;\">'\n\t\t. '<a href=\"' . esc_url( $d['kasa'] ) . '\" style=\"display:inline-block;padding:14px 44px;font-size:16px;line-height:16px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:8px;\">Pakartoti užsakymą</a>'\n\t\t. '</td></tr></table></td></tr>';\n}\n$antr = array();\nif ( $fb_url ) $antr['Keisti priminimą'] = $fb_url;\nif ( ! empty( $d['optout'] ) ) $antr['Nenoriu tokių priminimų'] = $d['optout'];\nif ( $antr ) $body .= Petshop_Email_Layout::secondary( $antr );\n\necho Petshop_Email_Layout::wrap( array(\n\t'subject'    => $subject,\n\t'preheader'  => 'Turimas prekes galite pakartoti vienu paspaudimu.',\n\t'body'       => $body,\n\t'flow_class' => $fc,\n\t'email'      => $email,\n\t'reason'     => 'Gavote šį laišką, nes pirkote šias prekes petshop.lt. Priminimų galite atsisakyti – nuoroda aukščiau.',\n) );\n"
 },
