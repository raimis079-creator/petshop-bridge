   "122: ",
   "123: \t/** Ar prekė šiuo kiekiu eitų iš AV. */",
   "124: \t/** v1.3: tiekėjo likutis šiai prekei (DP pakui — bazinės). null = nežinomas. */",
   "125: \tpublic static function tiekejo_likutis( $product_id, $tiekejas ) {",
   "126: \t\t$dp = self::dp( $product_id ); $pid = $dp ? $dp['base'] : (int) $product_id;",
   "127: \t\tif ( ! $tiekejas || 'av' === $tiekejas || 'legacy' === $tiekejas ) { return null; }",
   "128: \t\tif ( class_exists( 'Petshop_Sources' ) && method_exists( 'Petshop_Sources', 'gyvi' ) ) {",
   "129: \t\t\t$g = Petshop_Sources::gyvi( $pid, $tiekejas );",
   "130: \t\t\treturn ( isset( $g['stock_qty'] ) && null !== $g['stock_qty'] ) ? (int) $g['stock_qty'] : null;",
   "131: \t\t}",
   "132: \t\t$m = array( 'vf' => '_vf_qty', 'zb' => '_zb_qty' );",
   "133: \t\t$v = get_post_meta( $pid, isset( $m[ $tiekejas ] ) ? $m[ $tiekejas ] : '_stock', true );",
   "134: \t\treturn ( '' === $v || null === $v ) ? null : (int) $v;",
   "135: \t}",
   "136: ",
   "137: \t/**",
   "138: \t * v1.3: UŽSAKYMO eilutės šaltinis pagal Raimio taisyklę. $misrus — ar užsakyme yra grynai AV prekių.",
   "139: \t * Grąžina tą pačią struktūrą kaip resolve() + 'tiekejo_qty', 'taisykle'.",
   "140: \t */",
   "141: \tpublic static function parinkti( $product_id, $qty = 1, $misrus = false ) {",
   "142: \t\t$qty = max( 1, (int) $qty );",
   "143: \t\t$r = self::resolve( $product_id, $qty );",
   "144: \t\t$tiek = isset( $r['tiekejas'] ) ? $r['tiekejas'] : 'av';",
   "145: \t\t$r['tiekejo_qty'] = null; $r['taisykle'] = 'grynai AV';",
   "146: \t\tif ( 'av' === $tiek || 'legacy' === $tiek ) { return $r; } // be tiekėjo — tik AV",
   "147: \t\t$dp = self::dp( $product_id ); $n = $dp ? $dp['n'] : 1;",
   "148: \t\t$tq = self::tiekejo_likutis( $product_id, $tiek ); $r['tiekejo_qty'] = $tq;",
   "149: \t\t$tiekejas_turi = ( null === $tq ) ? true : ( $tq >= $qty * $n ); // nežinomas likutis = laikom, kad turi (feed'o nėra → senas elgesys)",
   "150: \t\t$av_turi = ! empty( $r['av_uztenka'] ) && null !== $r['av_qty'];",
   "151: \t\tif ( $tiekejas_turi && ! $misrus ) {",
