  "av_reduce_30_120": [
   "1: <?php",
   "2: /**",
   "3:  * Petshop AV Reduce v1.2 (S1676) — AV likučio nurašymas.",
   "4:  *",
   "5:  * v1.2 (S1676): DP pakas (Daugiau=pigiau) nurašomas/grąžinamas per BAZINĘ prekę × pako kiekį",
   "6:  *   (bendras principas visoms bazinėms rūšims). Eilutėje `_ps_av_reduced_pid` = bazinės ID,",
   "7:  *   `_ps_av_reduced_qty` = baziniais vienetais. Snippet 567 v1.3 AV eilutes praleidžia.",
   "8:  *",
   "9:  * PENKTAS SLUOKSNIS (REGISTRAS §17.7, §19.6).",
   "10:  *",
   "11:  * PROBLEMA (rasta s479): WooCommerce jau mažina `_stock` per",
   "12:  * `wc_maybe_reduce_stock_levels` (payment_complete / processing).",
   "13:  * Jei papildomai mažintume `_own_stock_qty`, AV prekei nusirašytų DU kartus.",
   "14:  *",
   "15:  * SPRENDIMAS — nurašymas pagal EILUTĖS šaltinį:",
   "16:  *   _ps_source = av   → mažinam `_own_stock_qty`, WC mažinimą PRALEIDŽIAM",
   "17:  *   kiti šaltiniai    → paliekam WC elgtis kaip įprasta",
   "18:  *",
   "19:  * KAIP SUSTABDOM WC eilutei: `woocommerce_order_item_quantity` filtras grąžina 0",
   "20:  * toms eilutėms, kurių šaltinis AV. WC tada nusirašo 0 vienetų iš `_stock`.",
   "21:  * Tai švariau nei `can_reduce_order_stock`, kuris veikia VISAM užsakymui.",
   "22:  *",
   "23:  * KADA MAŽINAM AV: tuo pačiu momentu kaip WC — payment_complete / processing.",
   "24:  * Idempotentiška per `_ps_av_reduced` žymę užsakyme.",
   "25:  *",
   "26:  * GRĄŽINIMAS: `woocommerce_order_status_cancelled` ir `..._refunded` — AV likutis",
   "27:  * grąžinamas atgal.",
   "28:  *",
   "29:  * PRIKLAUSO nuo 4 sluoksnio: eilutė turi turėti `_ps_source`. Jei jo nėra",
   "30:  * (senas užsakymas) — nieko nedarom, WC elgiasi kaip anksčiau.",
   "31:  */",
   "32: if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "33: ",
   "34: class Petshop_AV_Reduce {",
   "35: ",
   "36: \tpublic static function init() {",
   "37: \t\t// 1) sustabdom WC mažinimą AV eilutėms",
   "38: \t\tadd_filter( 'woocommerce_order_item_quantity', [ __CLASS__, 'wc_kiekis' ], 20, 3 );",
   "39: \t\t// 2) mažinam AV — PO WC (prioritetas 15, wc_maybe_reduce_stock_levels yra 10)",
   "40: \t\tadd_action( 'woocommerce_payment_complete', [ __CLASS__, 'mazinti' ], 15, 1 );",
   "41: \t\tadd_action( 'woocommerce_order_status_processing', [ __CLASS__, 'mazinti' ], 15, 1 );",
   "42: \t\t// 3) grąžinam",
   "43: \t\tadd_action( 'woocommerce_order_status_cancelled', [ __CLASS__, 'grazinti' ], 15, 1 );",
   "44: \t\tadd_action( 'woocommerce_order_status_refunded', [ __CLASS__, 'grazinti' ], 15, 1 );",
   "45: \t}",
   "46: ",
   "47: \t/** WC nurašymui: AV eilutėms grąžinam 0, kitoms — tikrą kiekį. */",
   "48: \tpublic static function wc_kiekis( $qty, $order, $item ) {",
   "49: \t\tif ( ! is_a( $item, 'WC_Order_Item_Product' ) ) { return $qty; }",
   "50: \t\t$src = $item->get_meta( '_ps_source' );",
   "51: \t\tif ( 'av' !== $src ) { return $qty; }",
   "52: \t\t// AV eilutė — WC `_stock` neliečiam",
   "53: \t\treturn 0;",
   "54: \t}",
   "55: ",
   "56: \t/** Sumažina AV likutį toms eilutėms, kurių šaltinis AV. */",
   "57: \tpublic static function mazinti( $order_id ) {",
   "58: \t\t$order = is_numeric( $order_id ) ? wc_get_order( $order_id ) : $order_id;",
   "59: \t\tif ( ! $order ) { return; }",
   "60: \t\tif ( $order->get_meta( '_ps_av_reduced' ) ) { return; }          // idempotencija",
   "61: \t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return; }",
   "62: ",
   "63: \t\t$padaryta = []; $klaidos = [];",
   "64: \t\tforeach ( $order->get_items() as $item_id => $item ) {",
   "65: \t\t\tif ( 'av' !== $item->get_meta( '_ps_source' ) ) { continue; }",
   "66: \t\t\t$pid = (int) $item->get_product_id();",
   "67: \t\t\t$qty = max( 1, (int) $item->get_quantity() );",
   "68: \t\t\t$dp  = class_exists( 'Petshop_AV_Source' ) ? Petshop_AV_Source::dp( $pid ) : null; // v1.2",
   "69: \t\t\tif ( $dp ) { $pid = $dp['base']; $qty = $qty * $dp['n']; $item->update_meta_data( '_ps_av_reduced_pid', $pid ); }",
   "70: ",
   "71: \t\t\t// GRYNAI AV prekės likutis gyvena `_stock`, ne `_own_stock_qty` —",
   "72: \t\t\t// joms WC nurašymo NESTABDOM... bet mes jį jau sustabdėm filtru.",
   "73: \t\t\t// Todėl čia nurašom pagal tai, kur likutis realiai yra.",
   "74: \t\t\t$av = Petshop_AV_Stock::qty( $pid );",
   "75: \t\t\tif ( null === $av ) {",
   "76: \t\t\t\t// grynai AV: mažinam WooCommerce `_stock` rankomis",
   "77: \t\t\t\t$p = wc_get_product( $pid );",
   "78: \t\t\t\tif ( $p && $p->managing_stock() ) {",
   "79: \t\t\t\t\t$dabar = (int) get_post_meta( $pid, '_stock', true );",
   "80: \t\t\t\t\t$naujas = max( 0, $dabar - $qty );",
   "81: \t\t\t\t\t$p->set_stock_quantity( $naujas );",
   "82: \t\t\t\t\tif ( 0 === $naujas ) { $p->set_stock_status( 'outofstock' ); }",
   "83: \t\t\t\t\t$p->save();",
   "84: \t\t\t\t\twc_delete_product_transients( $pid );",
   "85: \t\t\t\t\t$padaryta[] = \"#{$pid} grynai AV {$dabar} -> {$naujas}\";",
   "86: \t\t\t\t\t$item->update_meta_data( '_ps_av_reduced_qty', $qty );",
   "87: \t\t\t\t\t$item->save();",
   "88: \t\t\t\t}",
   "89: \t\t\t\tcontinue;",
   "90: \t\t\t}",
   "91: ",
   "92: \t\t\t$rez = Petshop_AV_Stock::decrease( $pid, $qty, 'užsakymas #' . $order->get_order_number() );",
   "93: \t\t\tif ( is_wp_error( $rez ) ) {",
   "94: \t\t\t\t$klaidos[] = \"#{$pid}: \" . $rez->get_error_message();",
   "95: \t\t\t} else {",
   "96: \t\t\t\t$padaryta[] = \"#{$pid} AV {$av} -> {$rez}\";",
   "97: \t\t\t\t$item->update_meta_data( '_ps_av_reduced_qty', $qty );",
   "98: \t\t\t\t$item->save();",
   "99: \t\t\t}",
   "100: \t\t}",
   "101: ",
   "102: \t\tif ( $padaryta || $klaidos ) {",
   "103: \t\t\t$order->update_meta_data( '_ps_av_reduced', current_time( 'mysql' ) );",
   "104: \t\t\t$order->save();",
   "105: \t\t\t$tekstas = 'AV nurašymas: ' . ( $padaryta ? implode( ' · ', $padaryta ) : 'nieko' );",
   "106: \t\t\tif ( $klaidos ) { $tekstas .= ' | KLAIDOS: ' . implode( ' · ', $klaidos ); }",
   "107: \t\t\t$order->add_order_note( $tekstas );",
   "108: \t\t}",
   "109: \t}",
   "110: ",
   "111: \t/** Grąžina AV likutį atšaukus arba grąžinus pinigus. */",
   "112: \tpublic static function grazinti( $order_id ) {",
   "113: \t\t$order = is_numeric( $order_id ) ? wc_get_order( $order_id ) : $order_id;",
   "114: \t\tif ( ! $order ) { return; }",
   "115: \t\tif ( ! $order->get_meta( '_ps_av_reduced' ) ) { return; }",
   "116: \t\tif ( $order->get_meta( '_ps_av_restored' ) ) { return; }",
   "117: \t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return; }",
   "118: ",
   "119: \t\t$padaryta = [];",
   "120: \t\tforeach ( $order->get_items() as $item_id => $item ) {",
   "121: \t\t\t$qty = (int) $item->get_meta( '_ps_av_reduced_qty' );",
   "122: \t\t\tif ( $qty <= 0 ) { continue; }",
   "123: \t\t\t$pid = (int) $item->get_meta( '_ps_av_reduced_pid' ); // v1.2: DP pakui — bazinė",
   "124: \t\t\tif ( $pid <= 0 ) { $pid = (int) $item->get_product_id(); }",
   "125: "
