  "av_limit_1_110": [
   "1: <?php",
   "2: /**",
   "3:  * Petshop AV Limit v1.1 (S474; S1731 — be likučio valdymo → „nėra\") — pardavimo riba iš KELIŲ šaltinių.",
   "4:  *",
   "5:  * TREČIAS SLUOKSNIS (REGISTRAS §17.7, §19).",
   "6:  *",
   "7:  * PROBLEMA: WooCommerce riboja pagal `_stock` — VIENO šaltinio kiekį.",
   "8:  * Prekė gali turėti AV 2 ir VF 796, o klientas negalės nupirkti 3, nors realiai yra 798.",
   "9:  *",
   "10:  * TAISYKLĖ (Raimis §17.4):",
   "11:  *   „Klientui likučio išvis nereikia rodyti, principas arba prekė yra arba nėra,",
   "12:  *    o kai jis renkasi, jis negali paimti minusinio likučio.\"",
   "13:  *",
   "14:  * KĄ DARO:",
   "15:  *   - bendra riba = AV + tiekėjas (tik toms, kurios turi ABU)",
   "16:  *   - klientui skaičius NERODOMAS (tik „yra\" / „nėra\")",
   "17:  *   - GRYNAI AV prekėms nieko nekeičia — jų `_stock` ir taip teisingas",
   "18:  *",
   "19:  * KO NEDARO:",
   "20:  *   - NEKEIČIA `_stock` reikšmės (sync ją perrašo)",
   "21:  *   - NEKURIA savo rezervacijų — WooCommerce jau turi (§18.6)",
   "22:  *",
   "23:  * SAUGIKLIS: veikia TIK toms prekėms, kurios turi `_own_stock_qty` IR tiekėjo",
   "24:  * šaltinį. Visoms kitoms — WooCommerce elgiasi kaip anksčiau.",
   "25:  */",
   "26: if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "27: ",
   "28: class Petshop_AV_Limit {",
   "29: ",
   "30: \tpublic static function init() {",
   "31: \t\t// bendra riba",
   "32: \t\tadd_filter( 'woocommerce_product_get_stock_quantity', [ __CLASS__, 'stock_qty' ], 20, 2 );",
   "33: \t\tadd_filter( 'woocommerce_product_variation_get_stock_quantity', [ __CLASS__, 'stock_qty' ], 20, 2 );",
   "34: \t\t// „yra / nėra\"",
   "35: \t\tadd_filter( 'woocommerce_product_get_stock_status', [ __CLASS__, 'stock_status' ], 20, 2 );",
   "36: \t\t// S1731: prekė be likučio valdymo neparduodama (nei paprasta, nei variacija)",
   "37: \t\tadd_filter( 'woocommerce_product_get_stock_status', [ __CLASS__, 'be_valdymo' ], 25, 2 );",
   "38: \t\tadd_filter( 'woocommerce_product_variation_get_stock_status', [ __CLASS__, 'be_valdymo' ], 25, 2 );",
   "39: \t\t// klientui skaičius NERODOMAS",
   "40: \t\tadd_filter( 'woocommerce_get_availability_text', [ __CLASS__, 'availability_text' ], 20, 2 );",
   "41: \t\tadd_filter( 'woocommerce_get_stock_html', [ __CLASS__, 'stock_html' ], 20, 2 );",
   "42: \t}",
   "43: ",
   "44: \t/** Ar šiai prekei taikoma dviejų šaltinių logika. */",
   "45: \tprotected static function taikoma( $product_id ) {",
   "46: \t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return false; }",
   "47: \t\t$av = Petshop_AV_Stock::qty( $product_id );",
   "48: \t\tif ( null === $av ) { return false; }               // AV neturi — nieko nekeičiam",
   "49: \t\tif ( ! class_exists( 'Petshop_Fulfillment_Source' ) ) { return false; }",
   "50: \t\t$s = Petshop_Fulfillment_Source::resolve( (int) $product_id )['source'];",
   "51: \t\treturn ( 'legacy' !== $s );                          // grynai AV — nieko nekeičiam",
   "52: \t}",
   "53: ",
   "54: \t/** Bendras kiekis = AV + tiekėjas. */",
   "55: \tpublic static function stock_qty( $qty, $product ) {",
   "56: \t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $qty; }",
   "57: \t\t$pid = $product->get_id();",
   "58: \t\tif ( ! self::taikoma( $pid ) ) { return $qty; }",
   "59: \t\t$av = (int) Petshop_AV_Stock::qty( $pid );",
   "60: \t\t$tiek = (int) $qty;                                  // WC `_stock` = tiekėjo kiekis",
   "61: \t\treturn $av + max( 0, $tiek );",
   "62: \t}",
   "63: ",
   "64: \t/** „yra\", jei bent vienas šaltinis turi. */",
   "65: \tpublic static function stock_status( $status, $product ) {",
   "66: \t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $status; }",
   "67: \t\t$pid = $product->get_id();",
   "68: \t\tif ( ! self::taikoma( $pid ) ) { return $status; }",
   "69: \t\t$av = (int) Petshop_AV_Stock::qty( $pid );",
   "70: \t\tif ( $av > 0 ) { return 'instock'; }",
   "71: \t\treturn $status;",
   "72: \t}",
   "73: ",
   "74: \t/**",
   "75: \t * S1731 (2026-09-28): prekė be likučio valdymo = „nėra\".",
   "76: \t * #1208: „Stirnos ausis\" sukurta per Gavimą su manage_stock=no ir be partijos —",
   "77: \t * WooCommerce ją laikė neribotai turima ir pardavė 5 vnt., kurių nebuvo.",
   "78: \t * Išimtys: DP pakai (likutis iš bazinės), paslaugos; rinkiniai/variaciniai tėvai",
   "79: \t * čia nepatenka (ne simple/variation tipas). Išjungti: opcija `ps_be_valdymo_isjungta`.",
   "80: \t */",
   "81: \tpublic static function be_valdymo( $status, $product ) {",
   "82: \t\tif ( 'outofstock' === $status || ! is_a( $product, 'WC_Product' ) ) { return $status; }",
   "83: \t\tif ( ! $product->is_type( array( 'simple', 'variation' ) ) ) { return $status; }",
   "84: \t\tif ( $product->get_manage_stock() ) { return $status; }          // true arba 'parent'",
   "85: \t\tif ( '' !== (string) $product->get_meta( '_dp_base_product_id' ) ) { return $status; }",
   "86: \t\tif ( 'paslauga' === strtolower( (string) $product->get_meta( '_ps_sandelis' ) ) ) { return $status; }",
   "87: \t\tif ( get_option( 'ps_be_valdymo_isjungta' ) ) { return $status; }",
   "88: \t\treturn 'outofstock';",
   "89: \t}",
   "90: ",
   "91: \t/** Klientui — be skaičiaus. */",
   "92: \tpublic static function availability_text( $text, $product ) {",
   "93: \t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $text; }",
   "94: \t\tif ( is_admin() && ! wp_doing_ajax() ) { return $text; }",
   "95: \t\tif ( ! $product->is_in_stock() ) { return $text; }",
   "96: \t\t// „Turime (127)\" → „Turime\"",
   "97: \t\treturn preg_replace( '/\\s*\\(\\s*\\d+[^)]*\\)\\s*$/u', '', (string) $text );",
   "98: \t}",
   "99: ",
   "100: \t/** Tas pats HTML lygmenyje — jei tema rodo savo variantą. */",
   "101: \tpublic static function stock_html( $html, $product ) {",
   "102: \t\tif ( is_admin() && ! wp_doing_ajax() ) { return $html; }",
   "103: \t\tif ( ! is_a( $product, 'WC_Product' ) || ! $product->is_in_stock() ) { return $html; }",
   "104: \t\treturn preg_replace( '/\\s*\\(\\s*\\d+[^)]*\\)/u', '', (string) $html );",
   "105: \t}",
   "106: }",
   "107: Petshop_AV_Limit::init();"
  ],
