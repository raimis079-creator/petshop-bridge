   "22: <FilesMatch \"\\.(css|js|mjs|woff2?|ttf|otf|eot|svg|jpe?g|png|gif|webp|avif|ico)$\">",
   "91: Header set Vary 'Accept-Encoding, Cookie'"
  ],
  "uploads_htaccess": "# BEGIN Petshop WebP (S1567, 2026-09-01)\n# Narsyklei, priimanciai image/webp, vietoje x.jpg|png atiduodamas salia esantis x.webp (jei yra).\n# Taisykles cia, ne root .htaccess: mod_rewrite NEinherituoja i katalogus su savo .htaccess.\n# S1741 (2026-09-30): adresui su ?ps_mail=1 (svetaines laiskai) WebP NEatiduodamas - Outlook WebP nerodo (mu-plugin petshop-laisku-nuotraukos).\n<IfModule mod_rewrite.c>\nRewriteEngine On\nRewriteCond %{HTTP_ACCEPT} image/webp\nRewriteCond %{QUERY_STRING} !(^|&)ps_mail=1(&|$)\nRewriteCond %{REQUEST_FILENAME} ^(.+)\\.(jpe?g|png)$ [NC]\nRewriteCond %1.webp -f\nRewriteRule ^(.+)\\.(jpe?g|png)$ $1.webp [T=image/webp,L]\n</IfModule>\n<IfModule mod_headers.c>\n<FilesMatch \"\\.(jpe?g|png)$\">\nHeader append Vary Accept\n</FilesMatch>\n</IfModule>\nAddType image/webp .webp\n# END Petshop WebP\n\n# BEGIN Petshop Saugumas uploads (S1719, 2026-09-25)\n# PHP uploads'e nevykdomas; tiekeju feed'ai (savikaina) neatiduodami\n<FilesMatch \"\\.(php|phtml|php[0-9]|phar)$\">\n<IfModule mod_authz_core.c>\nRequire all denied\n</IfModule>\n</FilesMatch>\n<FilesMatch \"^(petshop-vf-cache\\.xml|vetfarmas_response.*\\.xml)$\">\n<IfModule mod_authz_core.c>\nRequire all denied\n</IfModule>\n</FilesMatch>\n# END Petshop Saugumas uploads\n",
  "webp_pluginai": [
   "wp-super-cache/wp-cache.php"
  ]
 },
