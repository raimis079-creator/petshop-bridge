  "wc_269_306": [
   "269: \tprivate function get_query_for_reserved_stock( $product_id, $exclude_order_id ): string {",
   "270: \t\tglobal $wpdb;",
   "271: ",
   "272: \t\t$pending = OrderInternalStatus::PENDING;",
   "273: \t\tif ( OrderUtil::custom_orders_table_usage_is_enabled() ) {",
   "274: \t\t\t$join         = \"{$wpdb->prefix}wc_orders orders ON stock_table.`order_id` = orders.id\";",
   "275: \t\t\t$where_status = \"orders.status IN ( 'wc-checkout-draft', '$pending' )\";",
   "276: \t\t} else {",
   "277: \t\t\t$join         = \"{$wpdb->posts} posts ON stock_table.`order_id` = posts.ID\";",
   "278: \t\t\t$where_status = \"posts.post_status IN ( 'wc-checkout-draft', '$pending' )\";",
   "279: \t\t}",
   "280: ",
   "281: \t\t// phpcs:disable WordPress.DB.PreparedSQL.InterpolatedNotPrepared",
   "282: \t\t$query = $wpdb->prepare(",
   "283: \t\t\t\"",
   "284: \t\t\tSELECT COALESCE( SUM( stock_table.`stock_quantity` ), 0 ) FROM $wpdb->wc_reserved_stock stock_table",
   "285: \t\t\tLEFT JOIN $join",
   "286: \t\t\tWHERE $where_status",
   "287: \t\t\tAND stock_table.`expires` > NOW()",
   "288: \t\t\tAND stock_table.`product_id` = %d",
   "289: \t\t\tAND stock_table.`order_id` != %d",
   "290: \t\t\t\",",
   "291: \t\t\t$product_id,",
   "292: \t\t\t$exclude_order_id",
   "293: \t\t);",
   "294: \t\t// phpcs:enable WordPress.DB.PreparedSQL.InterpolatedNotPrepared",
   "295: ",
   "296: \t\t/**",
   "297: \t\t * Filter: woocommerce_query_for_reserved_stock",
   "298: \t\t * Allows to filter the query for getting reserved stock of a product.",
   "299: \t\t *",
   "300: \t\t * @since 4.5.0",
   "301: \t\t * @param string $query            The query for getting reserved stock of a product.",
   "302: \t\t * @param int    $product_id       Product ID.",
   "303: \t\t * @param int    $exclude_order_id Order to exclude from the results.",
   "304: \t\t */",
   "305: \t\treturn apply_filters( 'woocommerce_query_for_reserved_stock', $query, $product_id, $exclude_order_id );",
   "306: \t}"
  ],
