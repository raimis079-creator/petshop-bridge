   "372: \t/** v1.3: kanalas, kai kanalai() nieko negrazino (WC sesijos dar nera). */",
   "373: \tpublic static function kanalas_atsarginis( $url, $rh ) {",
   "374: \t\t$url = (string) $url; $rh = strtolower( (string) $rh );",
   "375: \t\tif ( preg_match( '/[?&](gclid|gbraid|wbraid|msclkid)=/i', $url ) || preg_match( '/[?&]utm_medium=(cpc|ppc|paid)/i', $url ) ) { return 'mokamas'; }",
   "376: \t\tif ( preg_match( '/[?&]utm_medium=email/i', $url ) ) { return 'email'; }",
   "377: \t\tif ( '' === $rh ) { return preg_match( '/[?&]utm_source=/i', $url ) ? 'referral' : 'direct'; }",
   "378: \t\tif ( preg_match( '/(^|\\.)(google|bing|yahoo|duckduckgo|yandex|ecosia|search\\.brave)\\./i', $rh ) ) { return 'organika'; }",
   "379: \t\tif ( preg_match( '/(^|\\.)(facebook|instagram|fb|l\\.facebook|lm\\.facebook|tiktok|youtube|linkedin|t\\.co|pinterest)\\./i', $rh ) ) { return 'soc_organika'; }",
   "380: \t\tif ( preg_match( '/(mail\\.|gmail|outlook|yahoo\\.mail)/i', $rh ) ) { return 'email'; }",
   "381: \t\treturn 'referral';",
   "382: \t}",
   "383: ",
   "384: \t/** Botai be JS atkrenta patys; sis sarasas — papildomas sluoksnis. */"
  ],
