   "95: \t\t}",
   "96: \t\t/* v1.2: Google Ads kampanijos ID (auto-tagging) -> utm_campaign, jei UTM kampanijos nera. */",
   "97: \t\tif ( empty( $t['utm_campaign'] ) && isset( $_GET['gad_campaignid'] ) ) {",
   "98: \t\t\t$gc = preg_replace( '/\\D/', '', (string) wp_unslash( $_GET['gad_campaignid'] ) );",
   "99: \t\t\tif ( $gc !== '' ) { $t['utm_campaign'] = mb_substr( $gc, 0, 32 ); }",
   "100: \t\t}",
   "101: \t\t/* gclid/fbclid — TIK faktas 0/1, pati reiksme nesaugoma (planas §4.7). */",
   "102: \t\t$t['gclid']  = isset( $_GET['gclid'] ) ? 1 : 0;",
   "103: \t\t$t['fbclid'] = isset( $_GET['fbclid'] ) ? 1 : 0;",
   "104: ",
   "105: \t\t$ref = isset( $_SERVER['HTTP_REFERER'] ) ? esc_url_raw( wp_unslash( $_SERVER['HTTP_REFERER'] ) ) : '';",
   "106: \t\t$rd  = '';",
   "107: \t\tif ( $ref !== '' ) {",
   "108: \t\t\t$h = wp_parse_url( $ref, PHP_URL_HOST );",
   "109: \t\t\t$s = wp_parse_url( home_url(), PHP_URL_HOST );",
   "110: \t\t\tif ( $h && $h !== $s && $h !== 'www.' . $s && ( 'www.' . $h ) !== $s ) {",
   "111: \t\t\t\t$rd = mb_substr( strtolower( $h ), 0, 190 );",
   "112: \t\t\t}",
   "113: \t\t}",
   "114: \t\t$t['referer_domenas'] = $rd;",
   "115: ",
   "116: \t\t$turi_utm = false;",
   "117: \t\tforeach ( self::UTM as $r ) { if ( ! empty( $t[ $r ] ) ) { $turi_utm = true; break; } }",
   "118: \t\tif ( ! $turi_utm && ! $t['gclid'] && ! $t['fbclid'] && $rd === '' ) {",
   "119: \t\t\treturn null;   /* vidinis perejimas arba tiesioginis — nieko nekeiciam */",
   "120: \t\t}",
   "121: ",
   "122: \t\t$t['landing_url'] = mb_substr( self::dabartinis_url(), 0, 255 );",
