   "127: ",
   "141: \tpublic static function taisykles() {",
   "142: \t\t$j = get_option( self::OPT_TAISYKLES, '' );",
   "143: \t\t$t = is_string( $j ) ? json_decode( $j, true ) : ( is_array( $j ) ? $j : null );",
   "144: \t\tif ( is_array( $t ) && ! empty( $t ) ) { return $t; }",
   "145: \t\treturn self::numatytosios();",
   "146: \t}",
   "147: ",
   "148: \tpublic static function numatytosios() {",
   "149: \t\treturn array(",
   "150: \t\t\t/* Q2: Kaina24 ir Kainos.lt = CPC 0,08 EUR + PVM -> MOKAMI. */",
   "151: \t\t\t'mokamas'      => array(",
   "152: \t\t\t\t'utm_medium' => array( 'cpc', 'ppc', 'paid', 'paidsocial', 'display', 'shopping', 'cpm' ),",
   "153: \t\t\t\t'utm_source' => array( 'kaina24', 'kainos', 'kainos.lt', 'google_ads', 'facebook_ads' ),",
   "154: \t\t\t\t'referer'    => array( 'kaina24.lt', 'www.kaina24.lt', 'kainos.lt', 'www.kainos.lt' ),",
   "155: \t\t\t\t'gclid'      => 1,",
   "156: \t\t\t\t'fbclid'     => 1,",
   "157: \t\t\t),",
   "158: \t\t\t'email'        => array(",
   "159: \t\t\t\t'utm_medium' => array( 'email', 'e-mail', 'newsletter' ),",
   "160: \t\t\t\t'utm_source' => array( 'sender', 'petshop' ),",
   "161: \t\t\t),",
   "162: \t\t\t'organika'     => array(",
   "163: \t\t\t\t'utm_medium' => array( 'organic' ),",
   "164: \t\t\t\t'referer'    => array( 'google.com', 'www.google.com', 'google.lt', 'www.google.lt', 'bing.com', 'duckduckgo.com', 'search.yahoo.com', 'ecosia.org' ),",
   "165: \t\t\t),",
   "166: \t\t\t'soc_organika' => array(",
   "167: \t\t\t\t'utm_medium' => array( 'social', 'social-organic' ),",
   "168: \t\t\t\t'referer'    => array( 'facebook.com', 'm.facebook.com', 'l.facebook.com', 'instagram.com', 'l.instagram.com', 'youtube.com', 'tiktok.com', 'lm.facebook.com' ),",
   "169: \t\t\t),",
   "170: \t\t);",
   "171: \t}",
   "172: ",
   "173: \t/**",
   "174: \t * Eiles tvarka svarbi: mokamas tikrinamas PIRMAS (gclid ant google.com",
   "175: \t * referer'io yra reklama, ne organika).",
   "176: \t */",
   "177: \tpublic static function klasifikuoti( $t ) {",
   "178: \t\t$taisykles = self::taisykles();",
   "179: \t\t$med = isset( $t['utm_medium'] ) ? strtolower( (string) $t['utm_medium'] ) : '';",
   "180: \t\t$src = isset( $t['utm_source'] ) ? strtolower( (string) $t['utm_source'] ) : '';",
   "181: \t\t$ref = isset( $t['referer_domenas'] ) ? strtolower( (string) $t['referer_domenas'] ) : '';",
   "182: ",
   "183: \t\tforeach ( array( 'mokamas', 'email', 'soc_organika', 'organika' ) as $kanalas ) {",
   "184: \t\t\tif ( empty( $taisykles[ $kanalas ] ) ) { continue; }",
   "185: \t\t\t$r = $taisykles[ $kanalas ];",
   "186: \t\t\tif ( ! empty( $r['gclid'] ) && ! empty( $t['gclid'] ) ) { return $kanalas; }",
   "187: \t\t\tif ( ! empty( $r['fbclid'] ) && ! empty( $t['fbclid'] ) ) { return $kanalas; }",
   "188: \t\t\tif ( $med !== '' && ! empty( $r['utm_medium'] ) && in_array( $med, array_map( 'strtolower', (array) $r['utm_medium'] ), true ) ) { return $kanalas; }",
   "189: \t\t\tif ( $src !== '' && ! empty( $r['utm_source'] ) && in_array( $src, array_map( 'strtolower', (array) $r['utm_source'] ), true ) ) { return $kanalas; }",
   "190: \t\t\tif ( $ref !== '' && ! empty( $r['referer'] ) && in_array( $ref, array_map( 'strtolower', (array) $r['referer'] ), true ) ) { return $kanalas; }",
   "191: \t\t}",
   "192: ",
   "193: \t\tif ( $med !== '' || $src !== '' ) { return 'referral'; }",
   "194: \t\tif ( $ref !== '' ) { return 'referral'; }",
   "195: \t\treturn 'direct';",
   "196: \t}",
   "197: ",
   "198: \t/* ================================================================== */",
   "199: \t/* 3) I UZSAKYMA                                                      */",
   "200: \t/* ================================================================== */"
  ],
