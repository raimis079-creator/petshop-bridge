   "<?php",
   "/**",
   " * Plugin Name: Petshop DP kainos v1.2.1 (Daugiau=Pigiau pakų kainų sinchronizacija)",
   " * Description: S1722 (2026-09-26, Raimio sprendimai 20:30–20:41). DP pako (`_dp_base_product_id` + `_dp_pack_qty`) kaina",
   " *   = kiekis × bazinės kaina × (1 − `_dp_nuolaida_proc` / 100), apvalinta iki „…9\" centų (42,583 → 42,59). Jei bazinė akcijoje —",
   " *   pako akcijos kaina ta pačia formule nuo bazinės akcijos kainos. Persiskaičiuoja iš karto po bazinės kainos pokyčio",
   " *   (`updated_post_meta` _regular_price/_sale_price/_price, vykdoma `shutdown`, be dubliavimo per importus), pakeitus",
   " *   `_dp_nuolaida_proc`, ir naktiniu cron 05:10 (`ps_dp_kainos_naktinis`, saugiklis). Pakai BE `_dp_nuolaida_proc`",
   " *   neliečiami (kaina rankinė). Nuolaidų lentelė pagal kategoriją — opcija `ps_dp_nuolaidos` (sausas 3, Josera 2,5,",
   " *   konservai 3,5, skanėstai 10, kraikas 10) — naudoja 572 forma ir generatorius. Žurnalas `ps_dp_kainos_zurnalas` (60),",
   " *   v1.0.1: po pakeitimo išvalomas pako puslapio Super Cache (wp_cache_post_change).",
   " *   v1.2 (21:30): atskiras admin langas PAŠALINTAS (R: „jokių naujų langų\") — % reguliuojamas ten, kur DP forma.",
   " *   naktinio suvestinė `ps_dp_kainos_pask`, Ryto sargo lemputė `dp_kainos` per suvestine(). Išjungti: `ps_dp_kainos_isjungta=1`.",
   " * Version: 1.2.1",
   " */",
   "if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "",
   "class Petshop_DP_Kainos {",
   "",
   "\tconst META      = '_dp_nuolaida_proc';",
   "\tconst OPT_NUOL  = 'ps_dp_nuolaidos';",
   "\tconst OPT_PASK  = 'ps_dp_kainos_pask';",
   "\tconst OPT_ZURN  = 'ps_dp_kainos_zurnalas';",
   "\tconst T_MAP     = 'ps_dp_zemelapis';",
   "\tconst CRON      = 'ps_dp_kainos_naktinis';",
   "\tconst KAINU_META = array( '_regular_price', '_sale_price', '_price', '_sale_price_dates_from', '_sale_price_dates_to' );",
   "",
   "\tprivate static $eile = array();",
   "\tprivate static $registruota = false;",
   "\tprivate static $vykdoma = false;"
  ],
  "ctx2": [
   "\t}",
   "",
   "\tpublic static function kaina( $bazine, $qty, $proc ) {",
   "\t\treturn self::apvalinti( (float) $bazine * (int) $qty * ( 1 - (float) $proc / 100 ) );",
   "\t}",
   "",
   "\t/* ---------- sinchronizacija ---------- */",
   "",
   "\t/** Vieno pako sinchronizacija. Grąžina masyvą su rezultatu; $dry — tik skaičiuoja. */",
   "\tpublic static function sinchronizuoti( $pid, $dry = false, $kvietejas = '' ) {",
   "\t\t$pid = (int) $pid;",
   "\t\t$r = array( 'pid' => $pid, 'pakeista' => false );",
   "\t\t$proc = get_post_meta( $pid, self::META, true );",
   "\t\tif ( $proc === '' || $proc === null || ! is_numeric( $proc ) ) { $r['praleista'] = 'be_proc'; return $r; }",
   "\t\t$proc = (float) $proc; $r['proc'] = $proc;",
   "\t\t$base_id = (int) get_post_meta( $pid, '_dp_base_product_id', true );",
   "\t\t$qty     = (int) get_post_meta( $pid, '_dp_pack_qty', true );",
   "\t\tif ( $base_id <= 0 || $qty < 2 ) { $r['klaida'] = 'nera_bazes_ar_kiekio'; return $r; }",
   "\t\t$base = wc_get_product( $base_id );",
   "\t\tif ( ! $base ) { $r['klaida'] = 'bazine_nerasta'; return $r; }",
   "\t\tif ( $base->get_status() !== 'publish' ) { $r['klaida'] = 'bazine_ne_publish'; return $r; }",
   "\t\t$breg = (float) $base->get_regular_price( 'edit' );",
   "\t\tif ( $breg <= 0 ) { $r['klaida'] = 'bazine_be_kainos'; return $r; }",
   "\t\t$bsale = $base->is_on_sale( 'edit' ) ? (float) $base->get_sale_price( 'edit' ) : 0;",
   "\t\t$nreg  = self::kaina( $breg, $qty, $proc );",
   "\t\t$nsale = $bsale > 0 ? self::kaina( $bsale, $qty, $proc ) : '';",
   "\t\tif ( $nsale !== '' && (float) $nsale >= (float) $nreg ) { $nsale = ''; }",
   "\t\t$pak = wc_get_product( $pid );",
   "\t\tif ( ! $pak ) { $r['klaida'] = 'pakas_nerastas'; return $r; }",
   "\t\t$sreg  = (string) $pak->get_regular_price( 'edit' );",
   "\t\t$ssale = (string) $pak->get_sale_price( 'edit' );",
   "\t\t$r['buvo'] = array( $sreg, $ssale ); $r['nauja'] = array( $nreg, $nsale );",
   "\t\t$lygu = ( $sreg !== '' && abs( (float) $sreg - (float) $nreg ) < 0.005 ) && ( ( $ssale === '' && $nsale === '' ) || ( $ssale !== '' && $nsale !== '' && abs( (float) $ssale - (float) $nsale ) < 0.005 ) );",
   "\t\tif ( $lygu ) { return $r; }",
   "\t\t$r['pakeista'] = true;",
   "\t\tif ( $dry ) { return $r; }",
   "\t\tself::$vykdoma = true;",
   "\t\ttry {",
   "\t\t\t$pak->set_regular_price( $nreg );",
   "\t\t\t$pak->set_sale_price( $nsale );",
   "\t\t\t$pak->save();",
   "\t\t\twc_delete_product_transients( $pid );",
   "\t\t\tif ( function_exists( 'wp_cache_post_change' ) ) { wp_cache_post_change( $pid ); } // Super Cache: pako puslapis",
   "\t\t\tself::zurnalas( array( 'laikas' => current_time( 'mysql' ), 'pid' => $pid, 'buvo' => $sreg . ( $ssale !== '' ? '/' . $ssale : '' ), 'tapo' => $nreg . ( $nsale !== '' ? '/' . $nsale : '' ), 'proc' => $proc, 'baze' => $base_id, 'kas' => $kvietejas ) );",
   "\t\t} catch ( \\Throwable $e ) { $r['klaida'] = 'irasymas: ' . $e->getMessage(); }"
  ]
 },
