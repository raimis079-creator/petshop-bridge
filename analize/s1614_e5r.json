  "src_Petshop_AV_Reduce::grazinti": {
   "f": "petshop-av-reduce.php:106",
   "src": [
    "\tpublic static function grazinti( $order_id ) {",
    "\t\t$order = is_numeric( $order_id ) ? wc_get_order( $order_id ) : $order_id;",
    "\t\tif ( ! $order ) { return; }",
    "\t\tif ( ! $order->get_meta( '_ps_av_reduced' ) ) { return; }",
    "\t\tif ( $order->get_meta( '_ps_av_restored' ) ) { return; }",
    "\t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return; }",
    "",
    "\t\t$padaryta = [];",
    "\t\tforeach ( $order->get_items() as $item_id => $item ) {",
    "\t\t\t$qty = (int) $item->get_meta( '_ps_av_reduced_qty' );",
    "\t\t\tif ( $qty <= 0 ) { continue; }",
    "\t\t\t$pid = (int) $item->get_product_id();",
    "",
    "\t\t\tif ( null === Petshop_AV_Stock::qty( $pid ) ) {",
    "\t\t\t\t$p = wc_get_product( $pid );",
    "\t\t\t\tif ( $p ) {",
    "\t\t\t\t\t$dabar = (int) get_post_meta( $pid, '_stock', true );",
    "\t\t\t\t\t$p->set_stock_quantity( $dabar + $qty );",
    "\t\t\t\t\t$p->set_stock_status( 'instock' );",
    "\t\t\t\t\t$p->save();",
    "\t\t\t\t\twc_delete_product_transients( $pid );",
    "\t\t\t\t\t$padaryta[] = \"#{$pid} grynai AV +{$qty}\";",
    "\t\t\t\t}",
    "\t\t\t} else {",
    "\t\t\t\t$rez = Petshop_AV_Stock::increase( $pid, $qty, 'grąžinta #' . $order->get_order_number() );",
    "\t\t\t\tif ( ! is_wp_error( $rez ) ) { $padaryta[] = \"#{$pid} AV +{$qty} -> {$rez}\"; }",
    "\t\t\t}",
    "\t\t}",
    "\t\tif ( $padaryta ) {",
    "\t\t\t$order->update_meta_data( '_ps_av_restored', current_time( 'mysql' ) );",
    "\t\t\t$order->save();",
    "\t\t\t$order->add_order_note( 'AV grąžinimas: ' . implode( ' · ', $padaryta ) );",
    "\t\t}",
    "\t}"
   ]
  },
  "avstock_increase": {
   "f": "petshop-av-stock.php:122",
   "src": [
    "\tpublic static function increase( $product_id, $by, $priezastis = '' ) {",
    "\t\t$by = (int) $by;",
    "\t\tif ( $by <= 0 ) { return new WP_Error( 'blogas_kiekis', 'Kiekis turi būti teigiamas' ); }",
    "\t\t$q = self::qty( $product_id );",
    "\t\t$naujas = ( null === $q ? 0 : $q ) + $by;",
    "\t\tself::apsaugotas_rasymas( $product_id, $naujas );",
    "\t\tself::log( $product_id, $q, $naujas, $priezastis );",
    "\t\treturn $naujas;",
    "\t}"
   ]
  },
  "avstock_decrease": {
   "f": "petshop-av-stock.php:109",
   "src": [
    "\tpublic static function decrease( $product_id, $by, $priezastis = '' ) {",
    "\t\t$by = (int) $by;",
    "\t\tif ( $by <= 0 ) { return new WP_Error( 'blogas_kiekis', 'Kiekis turi būti teigiamas' ); }",
    "\t\t$q = self::qty( $product_id );",
    "\t\tif ( null === $q ) { return new WP_Error( 'nera_av', 'Prekė neturi AV likučio' ); }",
    "\t\tif ( $q < $by ) { return new WP_Error( 'nepakanka', \"AV turi $q, prašoma $by\" ); }",
    "\t\t$naujas = $q - $by;",
    "\t\tself::apsaugotas_rasymas( $product_id, $naujas );",
    "\t\tself::log( $product_id, $q, $naujas, $priezastis );",
    "\t\treturn $naujas;",
    "\t}"
   ]
  },
  "avstock_qty": {
   "f": "petshop-av-stock.php:96",
   "src": [
    "\tpublic static function qty( $product_id ) {",
    "\t\t$v = get_post_meta( (int) $product_id, self::META, true );",
    "\t\tif ( '' === $v || null === $v ) { return null; }",
    "\t\treturn max( 0, (int) $v );",
    "\t}"
   ]
  },
