   "1066: \t\tif ( ! $eil ) { return array( 'ok' => false, 'klaida' => 'partija tuščia' ); }",
   "1067: \t\tif ( $dezes > 0 && empty( $part->venipak_pack ) ) { // dėžių skaičius iš kortelės — kol siunta neregistruota",
