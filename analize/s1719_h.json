  "fn_avpn": "function petshop_get_avpn_number( $order_id ) {\n    $order    = wc_get_order( $order_id );\n    $existing = $order ? $order->get_meta( '_petshop_avpn_number' ) : '';\n    if ( $existing ) return $existing;\n    $counter = (int) get_option( 'petshop_avpn_counter', 101 );\n    $number  = 'AVPN' . str_pad( $counter, 6, '0', STR_PAD_LEFT );\n    update_option( 'petshop_avpn_counter', $counter + 1 );\n    if ( $order ) {\n        $order->update_meta_data( '_petshop_avpn_number', $number );\n        $order->save();\n    }\n    return $number;\n}",
  "fn_doctype": "function petshop_get_invoice_document_type( $order ) {\n    if ( ! $order instanceof WC_Order ) return 'invoice';\n    // S1662 (Raimio taisyklė 2026-09-09): PVM sąskaita (AVPN) — TIK apmokėtiems.\n    // Kol neapmokėta (bet kuris mokėjimo būdas) — išankstinė (IAPV).\n    // Anksčiau proforma buvo tik bacs pending/on-hold — Paysera pending degino AVPN numerius.\n    if ( $order->is_paid() ) {\n        return 'invoice';\n    }\n    if ( in_array( $order->get_status(), array( 'pending', 'on-hold', 'failed', 'checkout-draft' ), true ) ) {\n        return 'proforma';\n    }\n    // cancelled/refunded be apmokėjimo — sąskaitos nekuriam, bet jei kas pareikalaus, NEdeginam AVPN\n    if ( in_array( $order->get_status(), array( 'cancelled', 'refunded' ), true ) && ! $order->get_date_paid() ) {\n        return 'proforma';\n    }\n    return 'invoice';\n}",
  "base_eil": {
