   "function ps_feeds_ids(): array {",
   "\tglobal $wpdb;",
   "\t$p = $wpdb->prefix;",
   "",
   "\t$sql = \"SELECT p.ID FROM {$p}posts p",
   "\t\tWHERE p.post_type = 'product' AND p.post_status = 'publish'",
   "\t\tAND EXISTS (",
   "\t\t\tSELECT 1 FROM {$p}postmeta s",
   "\t\t\tWHERE s.post_id = p.ID AND s.meta_key = '_stock_status' AND s.meta_value = 'instock'",
   "\t\t)",
   "\t\tAND NOT EXISTS (",
   "\t\t\tSELECT 1 FROM {$p}postmeta d",
   "\t\t\tWHERE d.post_id = p.ID AND d.meta_key = '_do_not_export' AND d.meta_value = 'yes'",
   "\t\t)",
   "\t\tAND NOT EXISTS (",
   "\t\t\tSELECT 1 FROM {$p}postmeta l",
   "\t\t\tWHERE l.post_id = p.ID AND l.meta_key = '_ps_laukas' AND l.meta_value = 'yes'",
   "\t\t)",
   "\t\tAND NOT EXISTS (",
   "\t\t\tSELECT 1 FROM {$p}postmeta dp",
   "\t\t\tWHERE dp.post_id = p.ID AND dp.meta_key = '_dp_base_product_id' AND dp.meta_value <> ''",
   "\t\t)",
   "\t\tAND NOT EXISTS (",
   "\t\t\tSELECT 1 FROM {$p}term_relationships tr",
   "\t\t\tJOIN {$p}term_taxonomy tt ON tt.term_taxonomy_id = tr.term_taxonomy_id",
   "\t\t\tJOIN {$p}terms t ON t.term_id = tt.term_id",
   "\t\t\tWHERE tr.object_id = p.ID AND tt.taxonomy = 'product_visibility'",
   "\t\t\t  AND t.slug = 'exclude-from-catalog'",
   "\t\t)",
   "\t\tAND NOT EXISTS ("
