  "v": "S1790y5",
  "utm": "<?php\n/**\n * Plugin Name: Petshop Laiškų UTM žymos\n * Description: S1769 (Raimio „daryk\" 10-11 13:07): automatinių laiškų (Sender, ps_email_jobs) nuorodoms į petshop.lt prideda utm_source=petshop_laiskai&utm_medium=email&utm_campaign=<srautas>, kad WooCommerce užsakymo kilmėje matytųsi, kuris laiškas atvedė. Laiško tekstas, išvaizda ir siuntimo laikas nesikeičia. Atsisakymo nuorodos ir mailto/tel nežymimos. Jei laiško nuoroda peradresuoja (pvz. „Pakartoti užsakymą\" → kasa), žymės perkeliamos į galutinį adresą. Išjungti: opcija ps_laisku_utm_isjungta=1.\n * Version: 1.0\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\nfinal class Petshop_Laisku_Utm {\n\tconst V = '1.0';\n\tconst SOURCE = 'petshop_laiskai';\n\tpublic static $flow = '';\n\tpublic static $kada = 0;\n\n\tpublic static function init() {\n\t\tif ( get_option( 'ps_laisku_utm_isjungta' ) ) { return; }\n\t\tadd_filter( 'petshop_email_eligibility', array( __CLASS__, 'atsiminti' ), 999, 5 );\n\t\tadd_filter( 'http_request_args', array( __CLASS__, 'http_args' ), 21, 2 );\n\t\tadd_filter( 'wp_redirect', array( __CLASS__, 'redirect' ), 99, 2 );\n\t}\n\n\t/** Dispatch: tinkamumo patikra vyksta prieš pat renderį ir siuntimą — įsimenam srautą. */\n\tpublic static function atsiminti( $result, $flow, $flow_class = '', $email = '', $context = array() ) {\n\t\tself::$flow = ( is_array( $result ) && ! empty( $result['allowed'] ) ) ? (string) $flow : '';\n\t\tself::$kada = time();\n\t\treturn $result;\n\t}\n\n\tpublic static function http_args( $args, $url ) {\n\t\tif ( '' === self::$flow || time() - self::$kada > 90 || false === strpos( (string) $url, 'api.sender.net/' ) || false === strpos( (string) $url, '/message/send' ) ) { return $args; }\n\t\tif ( empty( $args['body'] ) || ! is_string( $args['body'] ) ) { return $args; }\n\t\t$b = json_decode( $args['body'], true );\n\t\tif ( ! is_array( $b ) || empty( $b['html'] ) || ! is_string( $b['html'] ) ) { return $args; }\n\t\t$b['html'] = self::html( $b['html'], self::$flow );\n\t\t$args['body'] = wp_json_encode( $b );\n\t\tself::$flow = '';\n\t\treturn $args;\n\t}\n\n\tpublic static function html( $h, $flow ) {\n\t\treturn preg_replace_callback( '#(<a\\b[^>]*?\\bhref\\s*=\\s*)([\"\\'])([^\"\\']+)\\2#i', function ( $m ) use ( $flow ) {\n\t\t\treturn $m[1] . $m[2] . self::url( $m[3], $flow ) . $m[2];\n\t\t}, $h );\n\t}\n\n\tpublic static function url( $u, $flow ) {\n\t\t$raw = html_entity_decode( $u, ENT_QUOTES );\n\t\t$host = wp_parse_url( home_url(), PHP_URL_HOST );\n\t\t$uh = wp_parse_url( $raw, PHP_URL_HOST );\n\t\tif ( ! $uh || strtolower( preg_replace( '#^www\\.#', '', $uh ) ) !== strtolower( preg_replace( '#^www\\.#', '', $host ) ) ) { return $u; }\n\t\tif ( preg_match( '#utm_|ps_nebesiusti_priminimu|ps_atsisakyti_priminimu|unsubscribe|atsisakyti|ps_unsub|wp-content/uploads#i', $raw ) ) { return $u; }\n\t\t$frag = '';\n\t\tif ( false !== ( $p = strpos( $raw, '#' ) ) ) { $frag = substr( $raw, $p ); $raw = substr( $raw, 0, $p ); }\n\t\t$q = 'utm_source=' . self::SOURCE . '&utm_medium=email&utm_campaign=' . rawurlencode( $flow );\n\t\t$new = $raw . ( false === strpos( $raw, '?' ) ? '?' : '&' ) . $q . $frag;\n\t\treturn esc_url( $new ); // atgal į HTML (& → &#038;)\n\t}\n\n\t/** Laiško nuoroda peradresuoja (ps_pakartoti, ps_atkurti ir pan.) — žymės keliauja kartu, kad kasa jas užfiksuotų. */\n\tpublic static function redirect( $location, $status ) {\n\t\tif ( empty( $_GET['utm_source'] ) || self::SOURCE !== $_GET['utm_source'] ) { return $location; } // phpcs:ignore\n\t\tif ( false !== strpos( (string) $location, 'utm_' ) ) { return $location; }\n\t\t$host = wp_parse_url( home_url(), PHP_URL_HOST );\n\t\t$lh = wp_parse_url( (string) $location, PHP_URL_HOST );\n\t\tif ( $lh && strtolower( preg_replace( '#^www\\.#', '', $lh ) ) !== strtolower( preg_replace( '#^www\\.#', '', $host ) ) ) { return $location; }\n\t\t$keep = array();\n\t\tforeach ( array( 'utm_source', 'utm_medium', 'utm_campaign' ) as $k ) {\n\t\t\tif ( isset( $_GET[ $k ] ) ) { $keep[ $k ] = sanitize_text_field( wp_unslash( $_GET[ $k ] ) ); } // phpcs:ignore\n\t\t}\n\t\treturn add_query_arg( $keep, $location );\n\t}\n}\nPetshop_Laisku_Utm::init();\n",
  "md5": "5cb5f08455d87b449bd0127612af2f64",
