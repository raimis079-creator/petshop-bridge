  "src_190_260": [
   "151: ",
   "152: \t/* ============================================================",
   "153: \t *  RASYMAS",
   "154: \t * ============================================================ */",
   "155: ",
   "156: \t/**",
   "157: \t * Nustato, KAS raso: importas, cron'as, zmogus ar sistema.",
   "158: \t * Svarbu istorijos skaitomumui — \"importas pakeite kaina\" ir \"Raimis",
   "159: \t * pakeite kaina\" yra du skirtingi ivykiai, net jei laukas tas pats.",
   "160: \t */",
   "161: \tpublic static function saltinis() {",
   "162: \t\tif ( self::importas_vyksta() )               { return 'importas'; }",
   "163: \t\tif ( defined( 'DOING_CRON' ) && DOING_CRON ) { return 'cron'; }",
   "164: \t\tif ( defined( 'WP_CLI' ) && WP_CLI )         { return 'cli'; }",
   "165: \t\tif ( is_user_logged_in() )                   { return 'zmogus'; }",
   "166: \t\treturn 'sistema';",
   "167: \t}",
   "168: ",
   "169: \t/** WP All Import aptikimas — keli pozymiai, nes viena konstanta nepakanka. */",
   "170: \tprivate static function importas_vyksta() {",
   "171: \t\tif ( did_action( 'pmxi_before_xml_import' ) )   { return true; }",
   "172: \t\tif ( did_action( 'pmxi_saved_post' ) )          { return true; }",
   "173: \t\tif ( isset( $_GET['import_key'] ) )             { return true; }",
   "174: \t\tif ( isset( $GLOBALS['pmxi_import_in_progress'] ) && $GLOBALS['pmxi_import_in_progress'] ) { return true; }",
   "175: \t\treturn false;",
   "176: \t}",
   "177: ",
   "178: \tpublic static function kas() {",
   "179: \t\t$u = wp_get_current_user();",
   "180: \t\tif ( $u && $u->ID ) {",
   "181: \t\t\treturn $u->display_name ? $u->display_name : $u->user_login;",
   "182: \t\t}",
   "183: \t\treturn '';",
   "184: \t}",
   "185: ",
   "186: \t/** Masiniams veiksmams: visi sio praejimo ivykiai gauna ta pati op. numeri. */",
   "187: \tpublic static function pradeti_operacija( $op_nr ) { self::$op_nr = (string) $op_nr; }",
   "188: \tpublic static function baigti_operacija()          { self::$op_nr = null; }",
   "189: ",
   "190: \t/**",
   "191: \t * Vienintelis rasymo taskas. Visi kiti keliai eina per si.",
   "192: \t *",
   "193: \t * @return bool ar irasyta",
   "194: \t */",
   "195: \tpublic static function irasyti( $pid, $tipas, $args = array() ) {",
   "196: \t\t$pid = (int) $pid;",
   "197: \t\tif ( ! $pid || self::$dirba ) { return false; }",
   "198: ",
   "199: \t\t$sena  = isset( $args['sena'] )  ? self::trumpinti( $args['sena'] )  : '';",
   "200: \t\t$nauja = isset( $args['nauja'] ) ? self::trumpinti( $args['nauja'] ) : '';",
   "201: ",
   "202: \t\t/* Be pokycio nera ivykio. Importas kas valanda \"atnaujina\" tas pacias",
   "203: \t\t * reiksmes — be sios patikros lentele augtu megabaitais be naudos. */",
   "204: \t\tif ( $sena === $nauja && ! isset( $args['leisti_be_pokycio'] ) ) { return false; }",
   "205: ",
   "206: \t\t/* Riba saugo nuo ciklo gyvame darbe, taciau backfill'e ji tyliai",
   "207: \t\t * nukirstu prekes istorija ties 40-tuoju irasu — todel ten sąmoningai",
   "208: \t\t * apeinama per `be_ribos`. */",
   "209: \t\tif ( empty( $args['be_ribos'] ) ) {",
   "210: \t\t\tif ( ! isset( self::$skaitikliai[ $pid ] ) ) { self::$skaitikliai[ $pid ] = 0; }",
   "211: \t\t\tif ( self::$skaitikliai[ $pid ] >= self::RIBA_PREKEI ) { return false; }",
   "212: \t\t}",
   "213: ",
   "214: \t\tif ( ! self::uztikrinti_lentele() ) { return false; }",
   "215: ",
   "216: \t\tglobal $wpdb;",
   "217: \t\tself::$dirba = true;",
   "218: ",
   "219: \t\t$ok = $wpdb->insert( self::lentele(), array(",
   "220: \t\t\t'product_id' => $pid,",
   "221: \t\t\t'laikas'     => isset( $args['laikas'] ) ? $args['laikas'] : current_time( 'mysql' ),",
   "222: \t\t\t'tipas'      => substr( (string) $tipas, 0, 24 ),",
   "223: \t\t\t'laukas'     => isset( $args['laukas'] )   ? substr( (string) $args['laukas'], 0, 64 ) : '',",
   "224: \t\t\t'sena'       => $sena,",
   "225: \t\t\t'nauja'      => $nauja,",
   "226: \t\t\t'saltinis'   => isset( $args['saltinis'] ) ? substr( (string) $args['saltinis'], 0, 24 ) : self::saltinis(),",
   "227: \t\t\t'kas'        => isset( $args['kas'] )      ? substr( (string) $args['kas'], 0, 96 )     : self::kas(),",
   "228: \t\t\t'op_nr'      => isset( $args['op_nr'] )    ? substr( (string) $args['op_nr'], 0, 24 )   : (string) self::$op_nr,",
   "229: \t\t\t'pastaba'    => isset( $args['pastaba'] )  ? substr( (string) $args['pastaba'], 0, 255 ): '',",
   "230: \t\t), array( '%d','%s','%s','%s','%s','%s','%s','%s','%s','%s' ) );",
   "231: ",
   "232: \t\tself::$dirba = false;",
   "233: \t\tif ( $ok && empty( $args['be_ribos'] ) ) { self::$skaitikliai[ $pid ]++; }",
   "234: \t\treturn (bool) $ok;",
   "235: \t}",
   "236: ",
   "237: \tprivate static function trumpinti( $v ) {",
   "238: \t\tif ( is_array( $v ) || is_object( $v ) ) { $v = wp_json_encode( $v ); }",
   "239: \t\t$v = (string) $v;",
   "240: \t\tif ( strlen( $v ) > 255 ) { $v = substr( $v, 0, 252 ) . '...'; }",
   "241: \t\treturn $v;",
   "242: \t}",
   "243: ",
   "244: \t/* ============================================================",
   "245: \t *  ADAPTERIAI — VISI RASYMO KELIAI",
   "246: \t * ============================================================ */",
   "247: ",
   "248: \tpublic static function kabinti() {",
   "249: \t\t/* `update_post_metadata` iššaukiamas PRIES irasyma — vienintele vieta,",
   "250: \t\t * kur dar galima pamatyti sena reiksme. `updated_post_meta` (be \"date\")",
   "251: \t\t * iššaukiamas JAU po irasymo, ir kesas ten turi NAUJA reiksme —",
   "252: \t\t * bandymas skaityti sena is kesavimo grazina tuscia (patikrinta T9). */",
   "253: \t\tadd_filter( 'update_post_metadata', array( __CLASS__, 'pries_irasyma' ), 10, 4 );",
   "254: \t\tadd_action( 'updated_post_meta', array( __CLASS__, 'meta_pakeista' ), 10, 4 );",
   "255: \t\tadd_action( 'added_post_meta',   array( __CLASS__, 'meta_prideta' ),  10, 4 );",
   "256: \t\tadd_action( 'transition_post_status', array( __CLASS__, 'statusas_pakeistas' ), 10, 3 );",
   "257: \t}",
   "258: ",
   "259: \t/**",
   "260: \t * Uzfiksuoja sena reiksme pries irasyma. NIEKADA nekeicia $check —",
   "261: \t * grazinus ne-null, WordPress laikytu irasyma jau atliktu ir realus",
   "262: \t * update neivyktu. Tai butu tylus duomenu praradimas, todel grazinama",
   "263: \t * lygiai tai, kas gauta."
  ]
 }
}