  "kat_fn": "function tiekejo_sandelis( $pid ) {\n\t\tstatic $c = array(); static $yra = null;\n\t\t$pid = (int) $pid;\n\t\tif ( isset( $c[ $pid ] ) ) { return $c[ $pid ]; }\n\t\tglobal $wpdb;\n\t\t$t = $wpdb->prefix . 'ps_sources';\n\t\tif ( $yra === null ) { $yra = ( $wpdb->get_var( \"SHOW TABLES LIKE '$t'\" ) === $t ); }\n\t\t$s = '';\n\t\tif ( $yra ) {\n\t\t\t$s = (string) $wpdb->get_var( $wpdb->prepare( \"SELECT source FROM $t WHERE product_id=%d AND source<>'av' ORDER BY priority ASC, id ASC LIMIT 1\", $pid ) );\n\t\t}\n\t\tif ( $s === '' ) {\n\t\t\t$m = strtolower( (string) get_post_meta( $pid, '_ps_sandelis', true ) );\n\t\t\t$s = ( $m === '' || $m === 'av' ) ? '' : $m;\n\t\t}\n\t\treturn $c[ $pid ] = strtolower( $s );\n\t}\n\n\tpublic static function xml_sandelis( $pid ) {\n\t\treturn in_array( self::tiekejo_sandelis( $pid ), array( 'vf', 'zb' ), true );\n\t}\n\n\t/**\n\t * AV likutis ivedamas ranka VISADA — tai musu lentyna, jos niekas\n\t * neatsiuncia. Net VF/ZB prekes atveju: j"
