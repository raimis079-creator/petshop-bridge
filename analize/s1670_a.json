   "2205 \tpublic static function ajax_tiekejo_likutis() {",
   "2206 \t\tif ( ! current_user_can( 'manage_woocommerce' ) ) { wp_send_json_error( 'nepakanka teisių', 403 ); }",
   "2207 \t\tcheck_ajax_referer( 'ps_kat', 'nonce' );",
   "2208 ",
   "2209 \t\t$pid = isset( $_POST['id'] ) ? (int) $_POST['id'] : 0;",
   "2210 \t\tif ( ! $pid || get_post_type( $pid ) !== 'product' ) { wp_send_json_error( 'nėra prekės' ); }",
   "2211 \t\tif ( ! self::tiekejo_likutis_rankinis( $pid ) ) {",
   "2212 \t\t\twp_send_json_error( 'šio tiekėjo likutį valdo XML — ranka nekeičiamas' );",
   "2213 \t\t}",
   "2214 ",
   "2215 \t\t$iv = isset( $_POST['ivestis'] ) ? trim( (string) wp_unslash( $_POST['ivestis'] ) ) : '';",
   "2216 \t\t$iv = str_replace( \"\\xE2\\x88\\x92\", '-', $iv );",
   "2217 \t\tif ( ! preg_match( '/^([+-]?)(\\d{1,6})$/', $iv, $m ) ) { wp_send_json_error( 'įrašyk 12, +3 arba −2' ); }",
   "2218 ",
   "2219 \t\t$laukas = self::tiekejo_laukas( $pid );",
   "2220 \t\t$buvo   = get_post_meta( $pid, $laukas, true );",
   "2221 \t\t$buvo_i = ( $buvo === '' || $buvo === null ) ? 0 : (int) $buvo;",
   "2222 \t\t$sk     = (int) $m[2];",
   "2223 \t\tif ( $m[1] === '+' )     { $tapo = $buvo_i + $sk; }",
   "2224 \t\telseif ( $m[1] === '-' ) { $tapo = $buvo_i - $sk; }",
   "2225 \t\telse                     { $tapo = $sk; }",
   "2226 \t\tif ( $tapo < 0 ) { $tapo = 0; }",
   "2227 ",
   "2228 \t\t/* Per CRUD — kad `wc_product_meta_lookup` ir vitrina pasikeistu kartu. */",
   "2229 \t\t$prod = wc_get_product( $pid );",
   "2230 \t\tif ( $prod ) {",
   "2231 \t\t\t$prod->set_manage_stock( true );",
   "2232 \t\t\t$prod->set_stock_quantity( $tapo );",
   "2233 \t\t\t$prod->set_stock_status( $tapo > 0 ? 'instock' : 'outofstock' );",
   "2234 \t\t\t$prod->save();",
   "2235 \t\t} else {",
   "2236 \t\t\tupdate_post_meta( $pid, $laukas, $tapo );",
   "2237 \t\t}",
   "2238 ",
   "2239 \t\tif ( class_exists( 'Petshop_Ivykiai' ) && method_exists( 'Petshop_Ivykiai', 'irasyti' ) ) {",
   "2240 \t\t\ttry { Petshop_Ivykiai::irasyti( $pid, 'likutis', array(",
   "2241 \t\t\t\t'laukas'  => 'tiekėjo likutis',",
   "2242 \t\t\t\t'buvo'    => (string) $buvo_i,",
   "2243 \t\t\t\t'tapo'    => (string) $tapo,",
   "2244 \t\t\t\t'pastaba' => strtoupper( (string) get_post_meta( $pid, '_ps_sandelis', true ) ) . ' · įvesta ranka kortelėje',",
