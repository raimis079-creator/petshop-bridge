   "2246 \t\t\tcatch ( Throwable $e ) { /* zurnalas neprivalo blokuoti */ }",
   "2247 \t\t}",
   "2248 \t\tself::kesas_lauk( $pid );",
   "2249 \t\tif ( function_exists( 'wc_delete_product_transients' ) ) { wc_delete_product_transients( $pid ); }"
