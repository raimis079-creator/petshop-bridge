   "453: \tpublic static function begin_claim( $draft_id, $user_id, $email ) {",
   "454: \t\tglobal $wpdb;",
   "455: \t\t$draft_id = (string) $draft_id;",
   "456: \t\t$row      = self::get( $draft_id );",
   "457: ",
   "458: \t\tif ( ! $row ) {",
   "459: \t\t\treturn array( 'ok' => false, 'reason' => 'not_found', 'row' => null, 'attempt_id' => '' );",
   "460: \t\t}",
   "461: \t\t// Jau perkeltas — NE klaida. Kartotinis magic link panaudojimas",
   "462: \t\t// turi parodyti TA PATI profili, o ne sukurti nauja.",
   "463: \t\tif ( 'claimed' === $row->status ) {",
   "464: \t\t\treturn array( 'ok' => false, 'reason' => 'already_claimed', 'row' => $row, 'attempt_id' => '' );",
   "465: \t\t}",
   "466: \t\tif ( strtotime( $row->expires_at ) < time() ) {",
   "467: \t\t\treturn array( 'ok' => false, 'reason' => 'expired', 'row' => $row, 'attempt_id' => '' );",
   "468: \t\t}",
   "469: \t\t// SVETIMAS DRAFTAS. Prisijungusio vartotojo pastas privalo sutapti.",
   "470: \t\tif ( ! hash_equals( (string) $row->email_hash, self::email_hash( $email ) ) ) {",
   "471: \t\t\treturn array( 'ok' => false, 'reason' => 'email_mismatch', 'row' => $row, 'attempt_id' => '' );",
   "472: \t\t}",
   "473: ",
   "474: \t\t$now     = current_time( 'mysql', true );",
   "475: \t\t$stale   = gmdate( 'Y-m-d H:i:s', time() - self::CLAIM_STALE_SECONDS );",
   "476: \t\t$attempt = wp_generate_uuid4();",
   "477: ",
   "478: \t\t$affected = $wpdb->query( $wpdb->prepare(",
   "479: \t\t\t'UPDATE ' . self::table() . \"",
   "480: \t\t\t    SET status = 'claiming', claim_started_at = %s,",
   "481: \t\t\t        claim_attempt_id = %s, updated_at = %s",
   "482: \t\t\t  WHERE draft_id = %s",
   "483: \t\t\t    AND expires_at > %s",
   "484: \t\t\t    AND ( status = 'active'",
   "485: \t\t\t          OR ( status = 'claiming' AND claim_started_at < %s ) )\",",
   "486: \t\t\t$now, $attempt, $now, $draft_id, $now, $stale",
   "487: \t\t) );",
   "488: ",
   "489: \t\tif ( 1 !== (int) $affected ) {",
   "490: \t\t\t// Kitas procesas spejo pirmas — NEKURIAM augintinio.",
   "491: \t\t\treturn array( 'ok' => false, 'reason' => 'race_lost', 'row' => self::get( $draft_id ), 'attempt_id' => '' );",
   "492: \t\t}",
   "493: \t\treturn array( 'ok' => true, 'reason' => '', 'row' => self::get( $draft_id ), 'attempt_id' => $attempt );",
   "494: \t}",
