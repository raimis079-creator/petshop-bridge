  "src_open": "\tpublic static function open( $subject, $preheader = '' ) {\n\t\t$logo = self::logo_url();\n\t\tob_start();\n\t\t?><!DOCTYPE html>\n<html lang=\"lt\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title><?php echo esc_html( $subject ); ?></title>\n</head>\n<body style=\"margin:0;padding:0;background:<?php echo self::C_BG; ?>;font-family:Arial,Helvetica,sans-serif;color:<?php echo self::C_TEXT; ?>;-webkit-text-size-adjust:100%;\">\n<?php if ( $preheader ) : ?>\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\"><?php echo esc_html( $preheader ); ?></div>\n<?php endif; ?>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:<?php echo self::C_BG; ?>;padding:24px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background:<?php echo self::C_CARD; ?>;border-radius:12px;padding:32px 28px;\">\n<?php if ( $logo ) : ?>\n  <tr><td style=\"padding-bottom:22px;\">\n    <img src=\"<?php echo esc_url( $logo ); ?>\" alt=\"Petshop.lt\" width=\"150\" style=\"display:block;border:0;max-width:150px;height:auto;\">\n  </td></tr>\n<?php endif; ?>\n  <tr><td style=\"font-size:21px;font-weight:700;line-height:1.35;padding-bottom:14px;\"><?php echo esc_html( $subject ); ?></td></tr>\n\t\t<?php\n\t\treturn ob_get_clean();\n\t}\n",
  "src_close": "\tpublic static function close( $flow_class = 'service', $email = '', $reason = '' ) {\n\t\t$out  = self::divider();\n\t\t$out .= '<tr><td style=\"font-size:12px;line-height:1.6;color:' . self::C_MUTED . ';padding-top:16px;\">';\n\t\t$out .= 'UAB Avesa, Liucionių g. 46, Liucionys, LT-15166<br>';\n\n\t\tif ( $reason ) {\n\t\t\t$out .= esc_html( $reason ) . '<br>';\n\t\t}\n\n\t\tif ( 'marketing' === $flow_class ) {\n\t\t\t// Teisinis reikalavimas: veikianti atsisakymo nuoroda kiekviename laiske.\n\t\t\t$u = class_exists( 'Petshop_Unsubscribe' ) ? Petshop_Unsubscribe::link( $email ) : '';\n\t\t\tif ( $u ) {\n\t\t\t\t$out .= '<a href=\"' . esc_url( $u ) . '\" style=\"color:' . self::C_MUTED . ';\">Atsisakyti pranešimų</a>';\n\t\t\t}\n\t\t} elseif ( 'service' === $flow_class ) {\n\t\t\t// S320: „Pranesimu nustatymai\" NERODOM kaip nuorodos — tokio puslapio\n\t\t\t// DAR NERA. Negyvas footerio linkas nera geresnis uz negyva CTA.\n\t\t\t// Kai atsiras realus destination — pakeisti i <a href>.\n\t\t\t$out .= 'Šis laiškas susijęs su jūsų užsakymu ar paskyra.';\n\t\t}\n\n\t\t$out .= '</td></tr>';\n\t\t$out .= '</table></td></tr></table></body></html>';\n\t\treturn $out;\n\t}\n",
  "src_muted": "\tpublic static function muted( $html, $size = 12 ) {\n\t\treturn '<tr><td style=\"font-size:' . (int) $size . 'px;line-height:1.6;color:' . self::C_MUTED . ';padding-bottom:14px;\">' . $html . '</td></tr>';\n\t}\n",
