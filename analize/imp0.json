  "pvz_html": "<!DOCTYPE html>\n<html lang=\"lt\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title>Gal jau metas papildyti atsargas?</title>\n</head>\n<body style=\"margin:0;padding:0;background:#F3EFE5;font-family:Arial,Helvetica,sans-serif;color:#1F2A24;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">Maistas ir augintinio priežiūros prekės — petshop.lt.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#F3EFE5;padding:24px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background:#FFFFFF;border-radius:12px;padding:32px 28px;\">\n  <tr><td style=\"padding-bottom:22px;\">\n    <img src=\"https://dev.avesa.lt/wp-content/uploads/2026/05/Pilno-logotipo-spalvota-versija-100-2.jpg\" alt=\"Petshop.lt\" width=\"150\" style=\"display:block;border:0;max-width:150px;height:auto;\">\n  </td></tr>\n  <tr><td style=\"font-size:21px;font-weight:700;line-height:1.35;padding-bottom:14px;\">Gal jau metas papildyti atsargas?</td></tr>\n\t\t<tr><td style=\"font-size:15px;line-height:1.65;padding-bottom:16px;\">Jei augintinio maisto ar priežiūros priemonių atsargos jau senka, užsukite — viską rasite petshop.lt.</td></tr><tr><td style=\"padding:6px 0 22px;\"><a href=\"http://@@shop_url@@\" style=\"background:#2d6a35;color:#FFFFFF;text-decoration:none;padding:14px 26px;border-radius:8px;font-weight:600;font-size:15px;display:inline-block;\">Apsilankyti parduotuvėje</a></td></tr><tr><td style=\"border-top:1px solid #EEEEEE;font-size:0;line-height:0;height:1px;\">&nbsp;</td></tr><tr><td style=\"font-size:12px;line-height:1.6;color:#7A867C;padding-top:16px;\">UAB Avesa, Liucionių g. 46, Liucionys, LT-15166<br>Gavote šį laišk