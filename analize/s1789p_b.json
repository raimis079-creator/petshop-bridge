   "10: // ================================================================",
   "11: // 1. SCHEDULED TASK - 5ta einamojo menesio diena",
   "12: // ================================================================",
   "13: add_action( 'init', function() {",
   "14:     if ( ! wp_next_scheduled( 'petshop_pragma_monthly_export' ) ) {",
   "15:         // Suplanuojame kitą 5-ą dienos paleidimą",
   "16:         $next_run = petshop_pragma_next_run_time();",
   "17:         wp_schedule_single_event( $next_run, 'petshop_pragma_monthly_export' );",
   "18:     }",
   "19: });",
   "20: ",
   "21: function petshop_pragma_next_run_time() {",
   "22:     $now   = current_time( 'timestamp' );",
   "23:     $year  = (int) date( 'Y', $now );",
   "24:     $month = (int) date( 'n', $now );",
   "25:     $day   = (int) date( 'j', $now );",
   "26: ",
   "27:     if ( $day >= 5 ) {",
   "28:         // Jau praleidome šio mėnesio 5-ą — einame į kitą mėnesį",
   "29:         $month++;",
   "30:         if ( $month > 12 ) { $month = 1; $year++; }",
   "31:     }",
   "32: ",
   "33:     return mktime( 8, 0, 0, $month, 5, $year ); // 08:00 LT",
   "34: }",
   "35: ",
   "36: add_action( 'petshop_pragma_monthly_export', function() {",
   "37:     // SAUGIKLIS: siusti tik kai production mode ijungtas",
   "38:     if ( ! get_option( 'petshop_pragma_production_mode', false ) ) {",
   "39:         petshop_pragma_log( 'Automatinis eksportas PRALEISTAS — production mode isjungtas' );",
   "40:         wp_schedule_single_event( petshop_pragma_next_run_time(), 'petshop_pragma_monthly_export' );",
   "41:         return;",
   "42:     }",
   "43: ",
   "44:     $now        = current_time( 'timestamp' );",
   "45:     $prev_month = (int) date( 'n', strtotime( '-1 month', $now ) );",
   "46:     $prev_year  = (int) date( 'Y', strtotime( '-1 month', $now ) );",
   "47: ",
   "48:     petshop_pragma_run_export( $prev_year, $prev_month );",
   "49: ",
   "50:     // Suplanuojame kitą paleidimą",
   "51:     wp_schedule_single_event( petshop_pragma_next_run_time(), 'petshop_pragma_monthly_export' );",
   "52: });",
   "53: ",
