   "287: // ================================================================",
   "288: function petshop_pragma_send_email( $period_label, $txt_files, $new_pdfs, $new_order_nrs ) {",
   "289:     $production = get_option( 'petshop_pragma_production_mode', false );",
   "290: ",
   "291:     // Gavėjas — production: info@audac.lt, test: terra@petshop.lt",
   "292:     $default_to = $production ? 'info@audac.lt' : 'terra@petshop.lt';",
   "293:     $to = apply_filters( 'petshop_pragma_recipient', $default_to );",
   "294: ",
   "295:     $subject = ( $production ? '' : '[TEST] ' ) . 'Petshop.lt pardavimai ' . $period_label;",
   "296: ",
   "297:     $body = \"Laba diena,\\n\\n\";",
   "298:     $body .= \"Prisegti \" . $period_label . \" menesio pardavimų failai Pragma importui.\\n\\n\";",
   "299: ",
   "300:     if ( ! empty( $new_order_nrs ) ) {",
   "301:         $body .= \"NAUJI KLIENTAI (\" . count( $new_order_nrs ) . \" saskaitos) - prisegtos PDF:\\n\";",
   "302:         foreach ( $new_order_nrs as $nr ) {",
   "303:             $body .= \"  - \" . $nr . \"\\n\";",
   "304:         }",
   "305:         $body .= \"\\nSios saskaitos gali reiketi atskiro importo.\\n\\n\";",
   "306:     } else {",
   "307:         $body .= \"Nauju klientu nera - visi klientai jau registruoti sistemoje.\\n\\n\";",
   "308:     }",
   "309: ",
   "310:     $body .= \"Petshop.lt sistema\";",
   "311: ",
   "312:     $headers     = array( 'Content-Type: text/plain; charset=UTF-8' );",
   "313:     $attachments = array_merge( $txt_files, $new_pdfs );",
   "314: ",
   "315:     $result = wp_mail( $to, $subject, $body, $headers, $attachments );",
   "316: ",
   "317:     // Taip pat siunciame kopiją savininkui",
   "318:     wp_mail(",
   "319:         'terra@petshop.lt',",
   "320:         '[PRAGMA] ' . $subject . ' - ' . ( $result ? 'OK' : 'KLAIDA' ),",
   "321:         $body . \"\\n\\n[Siuntimas i info@audac.lt: \" . ( $result ? 'sekmingai' : 'nepavyko' ) . \"]\",",
   "322:         $headers,",
   "323:         $attachments",
   "324:     );",
   "325: ",
   "326:     return $result;",
   "327: }",
