   "185: $prev_date = $existing->last_purchase_date;",
   "186: $real_interval = max( 1, (int) round( ( strtotime( $purchase_date ) - strtotime( $prev_date ) ) / 86400 ) );",
   "187: $new_count = (int) $existing->purchase_count + 1;",
   "191: $old_avg = $existing->avg_interval_days ?: $real_interval;",
   "192: $new_avg = (int) round( $old_avg * 0.3 + $real_interval * 0.7 );",
   "193: $new_avg = max( 7, min( 180, $new_avg ) ); // ribos: 7-180 d.",
   "195: $confidence = ( $new_count >= 3 ) ? self::CONFIDENCE_CALIBRATED : self::CONFIDENCE_SECOND;",
   "197: $predicted = date( 'Y-m-d', strtotime( $purchase_date ) + $new_avg * 86400 );",
