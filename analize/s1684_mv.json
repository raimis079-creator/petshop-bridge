   "class Petshop_Feeding_Service {",
   "",
   "\tpublic static function evaluate( array $in ) {",
   "\t\t$issues = array(); $meta = array();",
   "\t\t$pid = isset( $in['product_id'] ) ? (int) $in['product_id'] : 0;",
   "\t\t$qty = isset( $in['quantity'] ) ? max( 1, (int) $in['quantity'] ) : 1;",
   "\t\t$w   = isset( $in['pet_input']['current_weight_kg'] ) && $in['pet_input']['current_weight_kg'] !== null",
   "\t\t\t? (float) $in['pet_input']['current_weight_kg'] : null;",
   "\t\t$cond = ( isset( $in['pet_input']['conditions'] ) && is_array( $in['pet_input']['conditions'] ) )",
   "\t\t\t? $in['pet_input']['conditions'] : array();",
   "",
   "\t\t$empty = array( 'portion_g' => null, 'duration_days' => null, 'eur_per_day' => null, 'eur_per_month' => null );",
   "\t\t$out = function( $status, $tier = null, $method = null, $vals = array() ) use ( $empty, &$issues, &$meta ) {",
   "\t\t\treturn array_merge( array( 'status' => $status, 'tier' => $tier, 'method' => $method ),",
   "\t\t\t\t$empty, $vals, array( 'issues' => $issues, 'meta' => $meta ) );",
   "\t\t};",
   "",
   "\t\t$product = function_exists( 'wc_get_product' ) ? wc_get_product( $pid ) : null;",
   "\t\tif ( ! $product ) {",
   "\t\t\t$issues[] = array( 'code' => 'PRODUCT_NOT_FOUND', 'severity' => 'error', 'layer' => 'product' );",
   "\t\t\treturn $out( 'unavailable' );",
   "\t\t}",
   "",
   "\t\t// Repository — runtime invariantas (jokio LIMIT 1)",
   "\t\t$repo = new Petshop_Feeding_Repository();",
   "\t\t$rt = $repo->get_for_product( $pid );",
   "",
   "\t\tswitch ( $rt['status'] ) {",
   "\t\t\tcase 'DATA_INTEGRITY_ERROR':",
   "\t\t\t\t$corr = uniqid( 'fcalc_' );",
   "\t\t\t\t$issues[] = array( 'code' => 'DATA_INTEGRITY_ERROR', 'severity' => 'error', 'layer' => 'repository',",
   "\t\t\t\t\t'table_ids' => $rt['table_ids'] ?? array(), 'correlation' => $corr );",
   "\t\t\t\terror_log( '[PS_FEEDING] DATA_INTEGRITY_ERROR product=' . $pid . ' ' . wp_json_encode( $rt['table_ids'] ?? array() ) . ' corr=' . $corr );",
   "\t\t\t\treturn $out( 'system_error' );",
   "\t\t\tcase 'HASH_VERSION_MISMATCH':",
   "\t\t\tcase 'EMPTY_TABLE_CONTENT':",
   "\t\t\t\t$issues[] = array( 'code' => $rt['status'], 'severity' => 'error', 'layer' => 'repository' );",
   "\t\t\t\treturn $out( 'system_error' );",
   "\t\t\tcase 'NO_ACTIVE_FEEDING_TABLE':",
   "\t\t\t\t$issues[] = array( 'code' => 'NO_ACTIVE_TABLE', 'severity' => 'info', 'layer' => 'repository' );"
