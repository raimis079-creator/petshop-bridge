  "repo_file": "class-feeding-repository.php",
  "repo": "\tpublic function get_for_product( $product_id ) {\n\t\t$product_id = (int) $product_id;\n\t\t$T = $this->pf.'ps_feeding_tables';\n\t\t$M = $this->pf.'ps_feeding_map';\n\n\t\t// runtime invariantas — jokio LIMIT 1\n\t\t$rows = $this->db->get_results( $this->db->prepare(\n\t\t\t\"SELECT t.* FROM {$M} m\n\t\t\t JOIN {$T} t ON t.id = m.feeding_table_id\n\t\t\t WHERE m.product_id = %d AND m.is_active = 1\n\t\t\t   AND t.is_active = 1 AND t.status = 'verified'\n\t\t\t   AND t.canonical_table_hash IS NOT NULL\",\n\t\t\t$product_id ), ARRAY_A );\n\n\t\t$n = is_array($rows) ? count($rows) : 0;\n\t\tif ( $n === 0 ) {\n\t\t\treturn array('status'=>'NO_ACTIVE_FEEDING_TABLE','product_id'=>$product_id);\n\t\t}\n\t\tif ( $n > 1 ) {\n\t\t\t$ids = array_map(function($r){ return (int)$r['id']; }, $rows);\n\t\t\treturn array('status'=>'DATA_INTEGRITY_ERROR','product_id'=>$product_id,\n\t\t\t\t'table_ids'=>$ids,'note'=>'daugiau nei 1 aktyvus verified mappingas');\n\t\t}\n\n\t\t$t = $rows[0];\n\t\treturn $this->build_table_payload( $t, $product_id );\n\t}\n",
