 "snip_klaida": "\n/** Plugin Name: TEMP PS Cron Aliarmu Recon v1.0 (recon) */\nadd_action('wp_loaded', function(){\n  if((isset($_GET['ps_cr'])?$_GET['ps_cr']:'') !== 'RECON1') return;\n  global $wpdb; $o=array('v'=>'CRON-R1','laikas'=>gmdate('Y-m-d H:i:s').' UTC');\n\n  // --- 1. failai: mu-plugins + kur yra vf fetcher\n  $d = WPMU_PLUGIN_DIR; $mu=array();\n  foreach(glob($d.'/*.php') as $p){ $mu[basename($p)]=gmdate('m-d H:i',filemtime($p)).' / '.filesize($p); }\n  $o['mu_plugins']=$mu;\n\n  $rasta=array();\n  foreach(array(WP_CONTENT_DIR, ABSPATH) as $baze){\n    foreach(array('','/mu-plugins','/plugins','/uploads','/themes') as $sub){\n      foreach(glob($baze.$sub.'/petshop-xml-vf*.php') as $p) $rasta[$p]=gmdate('Y-m-d H:i',filemtime($p)).' / '.filesize($p);\n      foreach(glob($baze.$sub.'/*/petshop-xml-vf*.php') as $p) $rasta[$p]=gmdate('Y-m-d H:i',filemtime($p)).' / '.filesize($p);\n    }\n  }\n  $o['vf_fetcher_failai']=$rasta;\n\n  // --- 2. grep: kas generuoja aliarmus\n  $zodziai=array('naslaic','ašlaič','aslaic','ps_shipments','Importas #7','xml-vf-fetcher','RAUDONA','Raudona','nutilo');\n  $hits=array();\n  foreach(glob($d.'/*.php') as $p){\n    $c=@file_get_contents($p); if($c===false) continue;\n    foreach($zodziai as $w){ if(stripos($c,$w)!==false) $hits[basename($p)][]=$w; }\n  }\n  $o['grep_mu']=$hits;\n\n  // --- 3. lenteles\n  $visos=$wpdb->get_col('SHOW TABLES'); $ps=array();\n  foreach($visos as $t){ if(stripos($t,'ps_')!==false || stripos($t,'actionscheduler')!==false) $ps[]=$t; }\n  $o['lenteles']=$ps;\n\n  // --- 4. eventu logas\n  $ev=null; foreach($visos as $t){ if(substr($t,-10)==='_event_log' || substr($t,-9)==='event_log'){ $ev=$t; break; } }\n  $o['event_lentele']=$ev;\n  if($ev){\n    $o['event_stulpeliai']=$wpdb->get_col(\"SHOW COLUMNS FROM `$ev`\");\n    $o['event_viso']=(int)$wpdb->get_var(\"SELECT COUNT(*) FROM `$ev`\");\n    $o['event_paskutiniai']=$wpdb->get_results(\"SELECT * FROM `$ev` ORDER BY id DESC LIMIT 5\", ARRAY_A);\n  }\n\n  // --- 5. siuntu lentele + naslaiciai\n  $sh=null; foreach($visos as $t){ if(stripos($t,'shipment')!==false || stripos($t,'siunt')!==false){ $sh=$t; break; } }\n  $o['siuntu_lentele']=$sh;\n  if($sh){\n    $o['siuntu_stulpeliai']=$wpdb->get_col(\"SHOW COLUMNS FROM `$sh`\");\n    $o['siuntu_viso']=(int)$wpdb->get_var(\"SELECT COUNT(*) FROM `$sh`\");\n  }\n\n  // --- 6. Action Scheduler\n  $as=$wpdb->prefix.'actionscheduler_actions';\n  if($wpdb->get_var(\"SHOW TABLES LIKE '$as'\")===$as){\n    $o['as_pagal_bukle']=$wpdb->get_results(\"SELECT status, COUNT(*) k FROM `$as` GROUP BY status\", ARRAY_A);\n    $o['as_pending_seniausi']=$wpdb->get_results(\"SELECT hook, scheduled_date_gmt, status FROM `$as` WHERE status IN ('pending','failed') ORDER BY scheduled_date_gmt ASC LIMIT 15\", ARRAY_A);\n  }\n\n  // --- 7. WP-Cron\n  $cron=_get_cron_array(); $c=array(); $dbr=0;\n  if(is_array($cron)) foreach($cron as $ts=>$h){ foreach($h as $hook=>$x){ $c[$hook]=gmdate('m-d H:i',$ts); if($ts<time()) $dbr++; } }\n  $o['cron_hooks']=$c; $o['cron_praleisti']=$dbr;\n  $o['DISABLE_WP_CRON']=defined('DISABLE_WP_CRON')?(DISABLE_WP_CRON?'true':'false'):'nenustatyta';\n\n  // --- 8. VF / importo opcijos\n  $opt=$wpdb->get_results(\"SELECT option_name, LEFT(option_value,120) v FROM {$wpdb->options} WHERE option_name LIKE '%vf%' OR option_name LIKE 'ps\\_%' OR option_name LIKE '%fetch%' ORDER BY option_name LIMIT 120\", ARRAY_A);\n  $o['opcijos']=$opt;\n\n  // --- 9. VF XML failas uploads\n  $up=wp_upload_dir(); $xmls=array();\n  foreach(array($up['basedir'], $up['basedir'].'/xml', $up['basedir'].'/feeds', WP_CONTENT_DIR.'/uploads') as $dir){\n    foreach(glob($dir.'/*.xml') as $p) $xmls[str_replace(ABSPATH,'',$p)]=gmdate('Y-m-d H:i',filemtime($p)).' / '.round(filesize($p)/1024).'KB';\n  }\n  $o['xml_failai']=$xmls;\n\n  header('Content-Type: application/json; charset=utf-8');\n  echo json_encode($o, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT); exit;\n}, 99);\n",
