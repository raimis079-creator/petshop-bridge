   "}",
   "if ( $papildai ) {",
   "return array( 'tipas' => 'papildai', 'sekcijos' => array(",
   "'Aprašymas' => 'apra', 'Sudėtis' => 'sud',",
   "'Šėrimo instrukcija' => 'serim' ) );",
