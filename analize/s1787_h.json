   "57: \t */",
   "58: \tpublic static function resolve( $product_id, $qty = 1 ) {",
   "59: \t\t$product_id = (int) $product_id;",
   "60: \t\t$qty        = max( 1, (int) $qty );",
   "61: ",
   "62: \t\t// v1.2: DP pakas → bazinė prekė × pako kiekis; likutis grąžinamas pakais.",
   "63: \t\t$dp = self::dp( $product_id );",
   "64: \t\tif ( $dp ) {",
   "65: \t\t\t$r = self::resolve( $dp['base'], $qty * $dp['n'] );",
   "66: \t\t\t$r['av_qty'] = ( null === $r['av_qty'] ) ? null : intdiv( (int) $r['av_qty'], $dp['n'] );",
   "67: \t\t\t$r['dp']     = $dp;",
   "68: \t\t\t$r['reason'] = 'DP pakas ×' . $dp['n'] . ' (bazinė #' . $dp['base'] . '): ' . $r['reason'];",
   "69: \t\t\treturn $r;",
   "70: \t\t}",
   "71: ",
   "72: \t\t$baze = class_exists( 'Petshop_Fulfillment_Source' )",
   "73: \t\t\t? Petshop_Fulfillment_Source::resolve( $product_id )",
   "74: \t\t\t: [ 'source' => 'legacy', 'carrier' => 'any', 'courier_only' => false, 'reason' => 'resolverio nėra' ];",
   "75: ",
   "76: \t\t// `legacy` = AV sandėlis (resolverio komentaras: „tikras savas sandelis\").",
   "77: \t\t// 959 publish prekės iš _legacy_source=excel_v2_20260604 su REALIAIS likučiais",
   "78: \t\t// WooCommerce `_stock` lauke (niekas jų neperrašo — sinchronizacijos nėra).",
   "79: \t\t// Joms `_own_stock_qty` NEREIKIA — jos ir taip AV.",
   "80: \t\tif ( 'legacy' === $baze['source'] ) {",
   "81: \t\t\treturn [",
   "82: \t\t\t\t'source'       => 'av',",
   "83: \t\t\t\t'carrier'      => 'any',",
   "84: \t\t\t\t'courier_only' => ! empty( $baze['courier_only'] ),",
   "85: \t\t\t\t'av_qty'       => (int) get_post_meta( $product_id, '_stock', true ),",
   "86: \t\t\t\t'av_uztenka'   => true,",
   "87: \t\t\t\t'tiekejas'     => 'av',",
   "88: \t\t\t\t'reason'       => 'grynai AV prekė (be tiekėjo)',",
   "89: \t\t\t];",
   "90: \t\t}",
   "91: ",
   "92: \t\t$av        = class_exists( 'Petshop_AV_Stock' ) ? Petshop_AV_Stock::qty( $product_id ) : null;",
   "93: \t\t$uztenka   = ( null !== $av && $av >= $qty );",
   "94: \t\t$tiekejas  = $baze['source'];",
   "95: ",
   "96: \t\tif ( $uztenka ) {",
   "97: \t\t\treturn [",
   "98: \t\t\t\t'source'       => 'av',",
   "99: \t\t\t\t'carrier'      => 'any',          // AV gali ir Venipak, ir LP",
   "100: \t\t\t\t'courier_only' => ! empty( $baze['courier_only'] ),",
   "101: \t\t\t\t'av_qty'       => $av,",
   "102: \t\t\t\t'av_uztenka'   => true,",
   "103: \t\t\t\t'tiekejas'     => $tiekejas,",
   "104: \t\t\t\t'reason'       => \"AV turi $av, reikia $qty\",",
   "105: \t\t\t];",
   "106: \t\t}",
   "107: ",
   "108: \t\t// SAUGIKLIS: LP Express galimas TIK iš AV (Raimis §18.1).",
   "109: \t\t// Bet kuris dropship šaltinis → venipak, nesvarbu ką grąžino bazinis resolveris.",
   "110: \t\treturn [",
   "111: \t\t\t'source'       => $tiekejas,",
   "112: \t\t\t'carrier'      => 'venipak',",
   "113: \t\t\t'courier_only' => ! empty( $baze['courier_only'] ),",
   "114: \t\t\t'av_qty'       => $av,",
   "115: \t\t\t'av_uztenka'   => false,",
   "116: \t\t\t'tiekejas'     => $tiekejas,",
   "117: \t\t\t'reason'       => ( null === $av )",
   "118: \t\t\t\t? 'AV šios prekės neturi'",
   "119: \t\t\t\t: \"AV turi $av, reikia $qty — neužtenka\",",
   "120: \t\t];",
   "121: \t}",
   "122: ",
   "123: \t/** Ar prekė šiuo kiekiu eitų iš AV. */",
   "124: \t/** v1.3: tiekėjo likutis šiai prekei (DP pakui — bazinės). null = nežinomas. */",
   "125: \tpublic static function tiekejo_likutis( $product_id, $tiekejas ) {",
   "126: \t\t$dp = self::dp( $product_id ); $pid = $dp ? $dp['base'] : (int) $product_id;",
   "127: \t\tif ( ! $tiekejas || 'av' === $tiekejas || 'legacy' === $tiekejas ) { return null; }",
   "128: \t\tif ( class_exists( 'Petshop_Sources' ) && method_exists( 'Petshop_Sources', 'gyvi' ) ) {",
   "129: \t\t\t$g = Petshop_Sources::gyvi( $pid, $tiekejas );",
   "130: \t\t\treturn ( isset( $g['stock_qty'] ) && null !== $g['stock_qty'] ) ? (int) $g['stock_qty'] : null;",
   "131: \t\t}",
   "132: \t\t$m = array( 'vf' => '_vf_qty', 'zb' => '_zb_qty' );",
   "133: \t\t$v = get_post_meta( $pid, isset( $m[ $tiekejas ] ) ? $m[ $tiekejas ] : '_stock', true );",
   "134: \t\treturn ( '' === $v || null === $v ) ? null : (int) $v;",
   "135: \t}",
   "136: ",
   "137: \t/**",
   "138: \t * v1.3: UŽSAKYMO eilutės šaltinis pagal Raimio taisyklę. $misrus — ar užsakyme yra grynai AV prekių.",
   "139: \t * Grąžina tą pačią struktūrą kaip resolve() + 'tiekejo_qty', 'taisykle'.",
   "140: \t */",
   "141: \tpublic static function parinkti( $product_id, $qty = 1, $misrus = false ) {",
   "142: \t\t$qty = max( 1, (int) $qty );",
   "143: \t\t$r = self::resolve( $product_id, $qty );",
   "144: \t\t$tiek = isset( $r['tiekejas'] ) ? $r['tiekejas'] : 'av';",
   "145: \t\t$r['tiekejo_qty'] = null; $r['taisykle'] = 'grynai AV';",
   "146: \t\tif ( 'av' === $tiek || 'legacy' === $tiek ) { return $r; } // be tiekėjo — tik AV",
   "147: \t\t$dp = self::dp( $product_id ); $n = $dp ? $dp['n'] : 1;",
   "148: \t\t$tq = self::tiekejo_likutis( $product_id, $tiek ); $r['tiekejo_qty'] = $tq;",
   "149: \t\t$tiekejas_turi = ( null === $tq ) ? true : ( $tq >= $qty * $n ); // nežinomas likutis = laikom, kad turi (feed'o nėra → senas elgesys)",
   "150: \t\t$av_turi = ! empty( $r['av_uztenka'] ) && null !== $r['av_qty'];",
   "151: \t\tif ( $tiekejas_turi && ! $misrus ) {",
   "152: \t\t\t$r['source'] = $tiek; $r['carrier'] = 'venipak'; $r['av_uztenka'] = false;",
   "153: \t\t\t$r['taisykle'] = 'dropship pirma' . ( $av_turi ? ' (AV turi ' . $r['av_qty'] . ', bet užsakymas ne mišrus)' : '' );",
   "154: \t\t\t$r['reason']   = $r['taisykle'] . ': tiekėjas ' . $tiek . ( null === $tq ? '' : ' turi ' . $tq ) . '; ' . $r['reason'];",
   "155: \t\t\treturn $r;",
   "156: \t\t}",
   "157: \t\tif ( $av_turi ) {",
   "158: \t\t\t$r['source'] = 'av'; $r['carrier'] = 'any'; $r['av_uztenka'] = true;",
   "159: \t\t\t$r['taisykle'] = $misrus ? 'mišrus užsakymas → AV' : 'tiekėjas neturi → AV';",
   "160: \t\t\t$r['reason']   = $r['taisykle'] . ': ' . $r['reason'];",
   "161: \t\t\treturn $r;",
   "162: \t\t}",
   "163: \t\t$r['source'] = $tiek; $r['carrier'] = 'venipak'; $r['av_uztenka'] = false;",
   "164: \t\t$r['taisykle'] = 'AV neužtenka → tiekėjas'; $r['reason'] = $r['taisykle'] . ': ' . $r['reason'];",
   "165: \t\treturn $r;",
   "166: \t}",
   "167: ",
   "168: \t/** v1.3: ar užsakymas mišrus — turi bent vieną grynai AV eilutę IR bent vieną tiekėjo prekę. */",
   "169: \tpublic static function ar_misrus( $order ) {",
   "170: \t\t$av = false; $tiek = false;",
   "171: \t\tforeach ( $order->get_items() as $it ) {",
   "172: \t\t\t$pid = (int) $it->get_product_id(); if ( ! $pid ) { continue; }",
   "173: \t\t\t$r = self::resolve( $pid, max( 1, (int) $it->get_quantity() ) );",
   "174: \t\t\t$t = isset( $r['tiekejas'] ) ? $r['tiekejas'] : 'av';",
   "175: \t\t\tif ( 'av' === $t || 'legacy' === $t ) { $av = true; } else { $tiek = true; }",
   "176: \t\t}",
   "177: \t\treturn $av && $tiek;",
   "178: \t}",
   "179: ",
   "180: \t/** v1.2: DP pakas? → ['base'=>bazinės ID,'n'=>pako kiekis] arba null. */",
   "181: \tpublic static function dp( $product_id ) {",
   "182: \t\t$base = (int) get_post_meta( (int) $product_id, '_dp_base_product_id', true );",
   "183: \t\t$n    = (int) get_post_meta( (int) $product_id, '_dp_pack_qty', true );",
   "184: \t\treturn ( $base > 0 && $n > 0 && $base !== (int) $product_id ) ? array( 'base' => $base, 'n' => $n ) : null;",
   "185: \t}",
   "186: ",
   "187: \tpublic static function is_av( $product_id, $qty = 1 ) {",
   "188: \t\t$x = self::resolve( $product_id, $qty );",
   "189: \t\treturn 'av' === $x['source'];",
   "190: \t}",
   "191: ",
   "192: \t/**",
   "193: \t * Krepšelio arba užsakymo eilučių sugrupavimas pagal šaltinį.",
   "194: \t *",
   "195: \t * @param array $eilutes [ ['product_id'=>int, 'qty'=>int, 'raktas'=>mixed], ... ]",
   "196: \t * @return array [ 'av' => ['eilutes'=>[...], 'carrier'=>'any'], 'vf' => [...], ... ]",
   "197: \t */",
   "198: \tpublic static function group( array $eilutes ) {",
   "199: \t\t$grupes = [];",
   "200: \t\tforeach ( $eilutes as $e ) {",
   "201: \t\t\t$pid = (int) ( $e['product_id'] ?? 0 );",
   "202: \t\t\tif ( ! $pid ) { continue; }",
   "203: \t\t\t$qty = max( 1, (int) ( $e['qty'] ?? 1 ) );",
   "204: \t\t\t$x   = self::resolve( $pid, $qty );",
   "205: \t\t\t$s   = $x['source'];",
   "206: \t\t\tif ( ! isset( $grupes[ $s ] ) ) {",
   "207: \t\t\t\t$grupes[ $s ] = [ 'eilutes' => [], 'carrier' => $x['carrier'], 'courier_only' => false ];",
   "208: \t\t\t}",
   "209: \t\t\t$grupes[ $s ]['eilutes'][] = [",
   "210: \t\t\t\t'product_id' => $pid,",
   "211: \t\t\t\t'qty'        => $qty,",
   "212: \t\t\t\t'raktas'     => $e['raktas'] ?? null,",
   "213: \t\t\t\t'reason'     => $x['reason'],",
   "214: \t\t\t];",
   "215: \t\t\tif ( $x['courier_only'] ) { $grupes[ $s ]['courier_only'] = true; }",
   "216: \t\t}",
   "217: \t\treturn $grupes;",
   "218: \t}",
   "219: ",
   "220: \t/** Užsakymo tipas pagal grupes: MAIN / DS / MIXED. */",
   "221: \tpublic static function order_type( array $grupes ) {",
   "222: \t\t$n = count( $grupes );",
   "223: \t\tif ( 0 === $n ) { return 'REVIEW'; }",
   "224: \t\tif ( 1 === $n ) { return isset( $grupes['av'] ) ? 'MAIN' : 'DS'; }",
   "225: \t\treturn 'MIXED';",
   "226: \t}",
   "227: ",
   "228: \t/** Patogumui: sugrupuoja WooCommerce užsakymą. */",
   "229: \tpublic static function group_order( $order ) {",
   "230: \t\t$order = is_numeric( $order ) ? wc_get_order( $order ) : $order;",
   "231: \t\tif ( ! $order ) { return []; }",
   "232: \t\t$eil = [];",
   "233: \t\tforeach ( $order->get_items() as $item_id => $item ) {",
   "234: \t\t\t$pid = $item->get_variation_id() ? $item->get_product_id() : $item->get_product_id();",
   "235: \t\t\t$eil[] = [ 'product_id' => $pid, 'qty' => $item->get_quantity(), 'raktas' => $item_id ];",
   "236: \t\t}",
   "237: \t\treturn self::group( $eil );",
   "238: \t}",
   "239: }"
  ],
  "o": [
   "56: \t * Priima sprendimą ir ĮRAŠO. Idempotentiška.",
   "57: \t *",
   "58: \t * @param bool $priverstinai perskaičiuoti net jei jau nuspręsta",
   "59: \t */",
   "60: \tpublic static function fiksuoti( $order_id, $priverstinai = false ) {",
   "61: \t\t$order = is_numeric( $order_id ) ? wc_get_order( $order_id ) : $order_id;",
   "62: \t\tif ( ! $order ) { return; }",
   "63: \t\tif ( ! $priverstinai && self::nuspresta( $order ) ) { return; }",
   "64: \t\tif ( ! class_exists( 'Petshop_AV_Source' ) ) { return; }",
   "65: ",
   "66: \t\t$grupes = [];",
   "67: \t\t$misrus = method_exists( 'Petshop_AV_Source', 'ar_misrus' ) ? Petshop_AV_Source::ar_misrus( $order ) : false; // v1.2",
   "68: \t\tforeach ( $order->get_items() as $item_id => $item ) {",
   "69: \t\t\t$pid = (int) $item->get_product_id();",
   "70: \t\t\tif ( ! $pid ) { continue; }",
   "71: \t\t\t$qty = max( 1, (int) $item->get_quantity() );",
   "72: ",
   "73: \t\t\t$x = method_exists( 'Petshop_AV_Source', 'parinkti' ) ? Petshop_AV_Source::parinkti( $pid, $qty, $misrus ) : Petshop_AV_Source::resolve( $pid, $qty ); // v1.2",
   "74: ",
   "75: \t\t\t$item->update_meta_data( '_ps_source',        $x['source'] );",
   "76: \t\t\t$item->update_meta_data( '_ps_carrier',       $x['carrier'] );",
   "77: \t\t\t$item->update_meta_data( '_ps_source_qty',    $qty );",
   "78: \t\t\t$item->update_meta_data( '_ps_source_at',     current_time( 'mysql' ) );",
   "79: \t\t\t$item->update_meta_data( '_ps_source_reason', $x['reason'] );",
   "80: \t\t\t$item->save();",
   "81: ",
   "82: \t\t\t$s = $x['source'];",
   "83: \t\t\tif ( ! isset( $grupes[ $s ] ) ) {",
   "84: \t\t\t\t$grupes[ $s ] = [ 'carrier' => $x['carrier'], 'eilutes' => 0, 'vienetai' => 0 ];",
   "85: \t\t\t}",
   "86: \t\t\t$grupes[ $s ]['eilutes']++;",
   "87: \t\t\t$grupes[ $s ]['vienetai'] += $qty;",
   "88: \t\t}",
   "89: ",
   "90: \t\t$tipas = Petshop_AV_Source::order_type( $grupes );",
   "91: \t\t$order->update_meta_data( '_ps_order_type', $tipas );",
   "92: \t\t$order->update_meta_data( '_ps_groups',     wp_json_encode( $grupes ) );",
   "93: \t\t$order->update_meta_data( '_ps_shipments',  count( $grupes ) );",
   "94: \t\t$order->update_meta_data( '_ps_decided_at', current_time( 'mysql' ) );",
   "95: \t\t$order->save();",
   "96: ",
   "97: \t\t$sant = [];",
   "98: \t\tforeach ( $grupes as $s => $g ) { $sant[] = strtoupper( $s ) . ' ' . $g['vienetai'] . ' vnt'; }",
   "99: \t\t$order->add_order_note( 'Vykdymas: ' . $tipas . ' — ' . implode( ' · ', $sant )",
   "100: \t\t\t. ' (' . count( $grupes ) . ' siunta(-os))' . ( $misrus ? ' · mišrus → AV pirmenybė' : ' · dropship pirma' ) );",
   "101: ",
   "102: \t\treturn [ 'tipas' => $tipas, 'grupes' => $grupes ];",
   "103: \t}",
   "104: ",
   "105: \t/** Perskaito ĮRAŠYTĄ sprendimą. NEPERSKAIČIUOJA. */"
  ]
 },
