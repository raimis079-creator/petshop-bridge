   "331:      */",
   "332:     public function venipak_shipping_dispatch_order($order_ids, $packs, $is_global) {",
   "333:         $url = 'https://go.venipak.lt/import/send.php';",
   "334: ",
   "335:         $order_ids = $this->reject_orders_with_missing_pickup_point( $order_ids );",
   "336:         if ( ! $order_ids ) {",
   "337:             return array( 'status' => 'error', 'data' => $this->missing_pickup_point_message() );",
   "338:         }",
   "339: ",
   "340:         // Retry offsets: 0 (first try), then +1, +5, +10 if pack numbers collide",
   "341:         $retry_offsets = array( 0, 1, 5, 10 );",
   "342:         $result_xml_string = '';",
   "343:         $transport_error = '';",
   "344: ",
   "345:         foreach ( $retry_offsets as $offset ) {",
   "346:             if ( $offset > 0 ) {",
   "347:                 // Bump the pack number counter before retrying",
   "348:                 $this->settings->reserve_pack_numbers( $offset );",
   "349:             }",
   "350: ",
   "351:             $xml = $this->getImportXML( $order_ids, $packs, $is_global );",
   "352:             if ( ! $xml ) return null;",
   "353: ",
   "354:             $body = array( 'user' => $this->venipak_username, 'pass' => $this->venipak_password, 'xml_text' => $xml );",
   "355:             $args = array(",
   "356:                 'body'    => $body,",
   "357:                 'timeout' => 45,",
   "358:                 'headers' => array(",
   "359:                     'Referer' => 'https://woocommerce.com/',",
   "360:                 ),",
   "361:             );",
   "362:             $response = wp_remote_post( $url, $args );",
   "363: ",
   "364:             // An empty body means the request never reached Venipak — a broken resolver or a",
   "365:             // timeout, not an accepted shipment. Treating it as success is how a bulk dispatch",
   "366:             // once flipped 170 orders to \"sent\" with nothing registered and no labels.",
   "367:             if ( is_wp_error( $response ) ) {",
   "368:                 $transport_error = $response->get_error_message();",
   "369:                 $result_xml_string = '';",
   "370:                 break;",
   "371:             }",
