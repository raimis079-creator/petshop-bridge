   "md5": "44607298c50b99998deeb8e0d2c8b987",
   "code": "<?php\n/**\n * Petshop Newsletter Footer v1.0 (S419) — forma virš poraštės.\n *\n * SPRENDIMAS (konsultantas + Raimis 2026-08-04): NE widget'as ir NE Footer 1\n * zonos įjungimas, o Flatsome kabliukas.\n *   - pilno pločio blokas VIRŠ esamos poraštės\n *   - nekeičiama veikianti Footer 2 keturių kolonų struktūra\n *   - neįjungiama iki šiol nenaudota Footer 1 zona (nežinomas fonas/tarpai)\n *   - nepriklausoma nuo widget zonos nustatymų\n *   - turinys lieka vienoje vietoje: [petshop_newsletter] shortcode klasėje\n *\n * Kabliukas patikrintas KODE (structure-footer.php:128):\n *   add_action('flatsome_before_footer', 'flatsome_html_before_footer');\n * Einam prioritetu 20 — PO temos savo HTML bloko.\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\nclass Petshop_Newsletter_Footer {\n\n\tpublic static function init() {\n\t\tadd_action( 'flatsome_before_footer', array( __CLASS__, 'render' ), 20 );\n\t}\n\n\tprotected static function rodyti() {\n\t\tif ( is_admin() ) return false;\n\t\t// Atsiskaitymo ir krepšelio puslapiuose netrukdom pirkimo kelio.\n\t\tif ( function_exists( 'is_checkout' ) && ( is_checkout() || is_cart() ) ) return false;\n\t\tif ( function_exists( 'is_wc_endpoint_url' ) && is_wc_endpoint_url( 'order-received' ) ) return false;\n\t\tif ( ! shortcode_exists( 'petshop_newsletter' ) ) return false;\n\t\treturn (bool) apply_filters( 'petshop_newsletter_footer_show', true );\n\t}\n\n\tpublic static function render() {\n\t\tif ( ! self::rodyti() ) return;\n\t\t?>\n\t\t<section class=\"psnl-band\" aria-label=\"Naujienlaiškio prenumerata\">\n\t\t\t<div class=\"psnl-band-in\">\n\t\t\t\t<?php\n\t\t\t\techo do_shortcode(\n\t\t\t\t\t'[petshop_newsletter '\n\t\t\t\t\t. 'title=\"Gaukite naudingus patarimus ir Petshop.lt pasiūlymus\" '\n\t\t\t\t\t. 'text=\"Retai, bet iš esmės: maisto naujienos, praktiniai patarimai ir aktualūs pasiūlymai.\" '\n\t\t\t\t\t. 'button=\"Prenumeruoti\" source=\"footer_form\"]'\n\t\t\t\t);\n\t\t\t\t?>\n\t\t\t</div>\n\t\t</section>\n\t\t<style>\n\t\t.psnl-band{background:#F3EFE5;padding:44px 20px;width:100%}\n\t\t.psnl-band-in{max-width:1080px;margin:0 auto;display:flex;justify-content:center}\n\t\t.psnl-band .psnl{max-width:640px;width:100%;box-shadow:0 1px 3px rgba(0,0,0,.06)}\n\t\t@media(max-width:768px){.psnl-band{padding:32px 16px}}\n\t\t</style>\n\t\t<?php\n\t}\n}\nPetshop_Newsletter_Footer::init();\n"
  },
  "class-newsletter.php": {
   "md5": "49609aff0b007eea660014e43f7d39cb",
   "code": "<?php\n/**\n * Petshop Newsletter v1.1 (S421) — naujienlaiškio prenumeratos forma.\n *\n * Shortcode:  [petshop_newsletter]\n *   Parametrai: title, text, button, source (numatyta 'newsletter_form')\n * REST:       POST /petshop/v1/newsletter-subscribe   { email, consent, nonce }\n *\n * SPRENDIMAS (Raimis 2026-08-04): VIENAS žingsnis, be dvigubo patvirtinimo.\n * Apsaugą atlieka `consent_changed` laiškas — jei kas nors įrašė svetimą adresą,\n * tas žmogus gauna patvirtinimą su atsisakymo nuoroda.\n *\n * Grandinė:\n *   forma → REST (nonce + honeypot + rate limit)\n *         → Petshop_Consent_Sync::set_marketing_consent(email,true,$source)\n *           (rašo į ps_consent_log: from/to, source, IP, user_agent, changed_at)\n *         → Petshop_Sender_Adapter::upsert_contact()\n *         → Petshop_Email_Dispatch::enqueue('consent_changed', ...)\n *\n * NIEKADA neatskleidžia, ar adresas jau yra sąraše — antraip forma taptų būdu\n * tikrinti klientų bazę. Visais sėkmės atvejais tas pats pranešimas.\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\nclass Petshop_Newsletter {\n\n\tconst SOURCE_DEFAULT = 'newsletter_form';\n\tconst RATE_PER_IP    = 5;    // per valandą\n\tconst RATE_PER_EMAIL = 3;    // per parą\n\n\tpublic static function init() {\n\t\tadd_shortcode( 'petshop_newsletter', array( __CLASS__, 'shortcode' ) );\n\t\tadd_action( 'rest_api_init', array( __CLASS__, 'routes' ) );\n\t\tadd_action( 'wp_enqueue_scripts', array( __CLASS__, 'assets' ) );\n\t}\n\n\tpublic static function assets() {\n\t\tif ( ! self::puslapyje_yra() ) { return; }\n\t\twp_enqueue_script( 'petshop-newsletter', PETSHOP_CORE_URL . 'assets/newsletter.js',\n\t\t\tarray(), '1.0.0', true );\n\t\twp_localize_script( 'petshop-newsletter', 'PS_NL', array(\n\t\t\t'rest'  => esc_url_raw( rest_url( 'petshop/v1/newsletter-subscribe' ) ),\n\t\t\t'nonce' => wp_create_nonce( 'wp_rest' ),\n\t\t) );\n\t}\n\n\tprotected static function puslapyje_yra() {\n\t\tglobal $post;\n\t\tif ( is_a( $post, 'WP_Post' ) && has_shortcode( (string) $post->post_content, 'petshop_newsletter' ) ) return true;\n\t\treturn (bool) apply_filters( 'petshop_newsletter_force_assets', false );\n\t}\n\n\tpublic static function shortcode( $atts ) {\n\t\t$a = shortcode_atts( array(\n\t\t\t'title'  => 'Naujienos apie augintinių priežiūrą',\n\t\t\t'text'   => 'Retai, bet iš esmės: pasiūlymai, maisto naujienos ir praktiniai patarimai.',\n\t\t\t'button' => 'Prenumeruoti',\n\t\t\t'source' => self::SOURCE_DEFAULT,\n\t\t), $atts, 'petshop_newsletter' );\n\n\t\t$id = 'psnl-' . wp_generate_password( 6, false, false );\n\t\tob_start(); ?>\n\t\t<div class=\"psnl\" id=\"<?php echo esc_attr( $id ); ?>\"\n\t\t     data-source=\"<?php echo esc_attr( sanitize_key( $a['source'] ) ); ?>\">\n\t\t\t<?php if ( $a['title'] ) : ?>\n\t\t\t\t<div class=\"psnl-title\"><?php echo esc_html( $a['title'] ); ?></div>\n\t\t\t<?php endif; ?>\n\t\t\t<?php if ( $a['text'] ) : ?>\n\t\t\t\t<div class=\"psnl-text\"><?php echo esc_html( $a['text'] ); ?></div>\n\t\t\t<?php endif; ?>\n\n\t\t\t<div class=\"psnl-row\">\n\t\t\t\t<label class=\"screen-reader-text\" for=\"<?php echo esc_attr( $id ); ?>-email\">El. pašto adresas</label>\n\t\t\t\t<input type=\"email\" id=\"<?php echo esc_attr( $id ); ?>-email\" class=\"psnl-email\"\n\t\t\t\t       inputmode=\"email\" autocomplete=\"email\" spellcheck=\"false\"\n\t\t\t\t       placeholder=\"jusu@pastas.lt\">\n\t\t\t\t<button type=\"button\" class=\"psnl-btn\"><?php echo esc_html( $a['button'] ); ?></button>\n\t\t\t</div>\n\n\t\t\t<label class=\"psnl-consent\">\n\t\t\t\t<input type=\"checkbox\" class=\"psnl-check\">\n\t\t\t\t<span>Sutinku gauti Petshop.lt naujienas el. paštu. Atsisakyti galėsiu bet kada.</span>\n\t\t\t</label>\n\n\t\t\t<?php // honeypot: be matomo teksto — wrapper aria-hidden, laukas už viewporto ?>\n\t\t\t<div class=\"psnl-hp\" aria-hidden=\"true\">\n\t\t\t\t<input type=\"text\" name=\"psnl_website\" class=\"psnl-website\" tabindex=\"-1\" autocomplete=\"off\">\n\t\t\t</div>\n\n\t\t\t<div class=\"psnl-msg\" role=\"status\" aria-live=\"polite\"></div>\n\n\t\t\t<div class=\"psnl-fine\">\n\t\t\t\tDuomenis tvarko UAB Avesa. Daugiau —\n\t\t\t\t<a href=\"<?php echo esc_url( home_url( '/privatumo-politika/' ) ); ?>\">privatumo politikoje</a>.\n\t\t\t</div>\n\t\t</div>\n\t\t<style>\n\t\t.psnl{background:#FFFFFF;border-radius:12px;padding:24px;max-width:560px;color:#1F2A24}\n\t\t.psnl-title{font-size:18px;font-weight:700;margin-bottom:6px}\n\t\t.psnl-text{font-size:14px;color:#4A554C;line-height:1.55;margin-bottom:16px}\n\t\t.psnl-row{display:flex;gap:10px;flex-wrap:wrap}\n\t\t.psnl-email{flex:1 1 240px;height:46px;box-sizing:border-box;padding:0 14px;font-size:15px;\n\t\t\tborder:1px solid #d8d2c6;border-radius:8px;margin:0}\n\t\t.psnl-btn{height:46px;box-sizing:border-box;padding:0 22px;background:#2d6a35;color:#fff;border:0;\n\t\t\tborder-radius:8px;font-size:15px;font-weight:600;cursor:pointer;text-transform:none;margin:0}\n\t\t.psnl-btn[disabled]{opacity:.55;cursor:default}\n\t\t.psnl-consent{display:flex;gap:10px;align-items:flex-start;margin-top:14px;font-size:13px;\n\t\t\tcolor:#4A554C;line-height:1.5;cursor:pointer}\n\t\t.psnl-consent input{margin-top:2px;flex:0 0 auto}\n\t\t.psnl-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}\n\t\t.psnl-msg{margin-top:14px;font-size:14px;line-height:1.5;display:none}\n\t\t.psnl-msg.ok{display:block;background:#e8f3e4;border-left:4px solid #2d6a35;padding:12px 14px;border-radius:6px}\n\t\t.psnl-msg.er{display:block;background:#fdeaea;border-left:4px solid #c33;padding:12px 14px;border-radius:6px}\n\t\t.psnl-fine{margin-top:14px;font-size:12px;color:#7A867C}\n\t\t</style>\n\t\t<?php\n\t\treturn ob_get_clean();\n\t}\n\n\tpublic static function routes() {\n\t\tregister_rest_route( 'petshop/v1', '/newsletter-subscribe', array(\n\t\t\t'methods'             => 'POST',\n\t\t\t'callback'            => array( __CLASS__, 'subscribe' ),\n\t\t\t'permission_callback' => '__return_true',\n\t\t) );\n\t}\n\n\tprotected static function ip() {\n\t\t$ip = isset( $_SERVER['REMOTE_ADDR'] ) ? (string) $_SERVER['REMOTE_ADDR'] : '';\n\t\treturn substr( $ip, 0, 45 );\n\t}\n\n\t/** Grąžina true, jei riba viršyta. */\n\tprotected static function rate_limit( $raktas, $riba, $langas ) {\n\t\t$k = 'psnl_rl_' . md5( $raktas );\n\t\t$n = (int) get_transient( $k );\n\t\tif ( $n >= $riba ) { return true; }\n\t\tset_transient( $k, $n + 1, $langas );\n\t\treturn false;\n\t}\n\n\tpublic static function subscribe( WP_REST_Request $req ) {\n\t\t$b       = $req->get_json_params();\n\t\t$email   = isset( $b['email'] ) ? sanitize_email( trim( (string) $b['email'] ) ) : '';\n\t\t$consent = ! empty( $b['consent'] );\n\t\t$hp      = isset( $b['website'] ) ? trim( (string) $b['website'] ) : '';\n\t\t$source  = isset( $b['source'] ) ? sanitize_key( (string) $b['source'] ) : self::SOURCE_DEFAULT;\n\n\t\t// Robotas: honeypot užpildytas -> tylus „sėkmingas\" atsakymas, nieko nerašom.\n\t\tif ( $hp !== '' ) {\n\t\t\treturn rest_ensure_response( array( 'ok' => true, 'message' => self::zinute_ok() ) );\n\t\t}\n\t\tif ( ! $consent ) {\n\t\t\treturn new WP_REST_Response( array( 'ok' => false,\n\t\t\t\t'message' => 'Pažymėkite, kad sutinkate gauti naujienas.' ), 400 );\n\t\t}\n\t\tif ( ! $email || ! is_email( $email ) ) {\n\t\t\treturn new WP_REST_Response( array( 'ok' => false,\n\t\t\t\t'message' => 'Patikrinkite el. pašto adresą.' ), 400 );\n\t\t}\n\t\tif ( self::rate_limit( 'ip:' . self::ip(), self::RATE_PER_IP, HOUR_IN_SECONDS ) ) {\n\t\t\treturn new WP_REST_Response( array( 'ok' => false,\n\t\t\t\t'message' => 'Per daug bandymų. Pabandykite vėliau.' ), 429 );\n\t\t}\n\t\tif ( self::rate_limit( 'em:' . strtolower( $email ), self::RATE_PER_EMAIL, DAY_IN_SECONDS ) ) {\n\t\t\t// Tas pats pranešimas kaip sėkmės atveju — neatskleidžiam nieko.\n\t\t\treturn rest_ensure_response( array( 'ok' => true, 'message' => self::zinute_ok() ) );\n\t\t}\n\t\tif ( ! class_exists( 'Petshop_Consent_Sync' )\n\t\t\t|| ! method_exists( 'Petshop_Consent_Sync', 'set_marketing_consent' ) ) {\n\t\t\treturn new WP_REST_Response( array( 'ok' => false,\n\t\t\t\t'message' => 'Šiuo metu nepavyko išsaugoti. Pabandykite vėliau.' ), 500 );\n\t\t}\n\n\t\t// 1) Sutikimas + pėdsakas (ps_consent_log rašo pati klasė)\n\t\t$rez = Petshop_Consent_Sync::set_marketing_consent( $email, true, $source );\n\t\tif ( is_wp_error( $rez ) ) {\n\t\t\treturn new WP_REST_Response( array( 'ok' => false,\n\t\t\t\t'message' => 'Šiuo metu nepavyko išsaugoti. Pabandykite vėliau.' ), 500 );\n\t\t}\n\n\t\t// 2) Patvirtinimo laiškas. Jei nepavyktų — sutikimas VIS TIEK išsaugotas.\n\t\tif ( class_exists( 'Petshop_Email_Dispatch' ) ) {\n\t\t\tPetshop_Email_Dispatch::enqueue( 'consent_changed', $email, array(\n\t\t\t\t'name'       => '',\n\t\t\t\t'granted'    => true,\n\t\t\t\t'source'     => $source,\n\t\t\t\t'changed_at' => current_time( 'mysql' ),\n\t\t\t\t'prefs_url'  => home_url( '/paskyra/' ),\n\t\t\t), array( 'job_key' => 'nl_' . md5( strtolower( $email ) . '|' . gmdate( 'Y-m-d' ) ) ) );\n\t\t}\n\n\t\tdo_action( 'petshop_newsletter_subscribed', $email, $source );\n\n\t\treturn rest_ensure_response( array( 'ok' => true, 'message' => self::zinute_ok() ) );\n\t}\n\n\tprotected static function zinute_ok() {\n\t\treturn 'Ačiū! Į nurodytą adresą išsiuntėme patvirtinimą.';\n\t}\n}\nPetshop_Newsletter::init();\n"
  },
