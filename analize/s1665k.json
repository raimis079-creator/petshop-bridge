   "136 $k = (string) $req->get_header( 'x-ps-key' );",
   "137 if ( ! $k || ! hash_equals( (string) get_option( self::OPT_RAKTAS ), $k ) ) { return new WP_REST_Response( array( 'ok' => 0, 'klaida' => 'raktas' ),",
