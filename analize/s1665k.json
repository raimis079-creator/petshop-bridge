   "179 if ( 'google_ads' === $r['kanalas'] ) { $out['per_kampanija'][ $r['kampanija_id'] ] = array( 'kampanija' => $r['kampanija'], 'islaidos_ct' => (int)"
  ],
  "blokas": [
   "register_rest_route( 'ps-web/v1', '/ads', array(",
   "'methods' => 'POST', 'permission_callback' => '__return_true', 'callback' => array( __CLASS__, 'priimti' ),",
   ") );",
   "}",
   "public static function priimti( WP_REST_Request $req ) {",
   "$k = (string) $req->get_header( 'x-ps-key' );",
   "if ( ! $k || ! hash_equals( (string) get_option( self::OPT_RAKTAS ), $k ) ) { return new WP_REST_Response( array( 'ok' => 0, 'klaida' => 'raktas' ), 403 ); }",
   "$b = $req->get_json_params();",
   "$rows = ( is_array( $b ) && isset( $b['rows'] ) && is_array( $b['rows'] ) ) ? $b['rows'] : array();",
   "$val = ( is_array( $b ) && ! empty( $b['currency'] ) ) ? $b['currency'] : 'EUR';",
   "$st = array( 'new' => 0, 'upd' => 0, 'same' => 0, 'bad' => 0 );",
   "foreach ( $rows as $x ) {",
   "$res = self::rasyti( array(",
   "'diena' => isset( $x['date'] ) ? $x['date'] : '', 'kanalas' => 'google_ads',",
   "'kampanija_id' => isset( $x['campaign_id'] ) ? $x['campaign_id'] : '', 'kampanija' => isset( $x['campaign'] ) ? $x['campaign'] : '',",
   "'parodymai' => isset( $x['impressions'] ) ? $x['impressions'] : 0, 'paspaudimai' => isset( $x['clicks'] ) ? $x['clicks'] : 0,",
   "'islaidos' => isset( $x['cost'] ) ? $x['cost'] : 0, 'valiuta' => $val,",
   "'konversijos' => isset( $x['conversions'] ) ? $x['conversions'] : 0, 'konv_verte' => isset( $x['conv_value'] ) ? $x['conv_value'] : 0,",
   "'saltinis' => 'ads_script',",
   ") );",
   "$st[ $res ]++;",
   "}",
   "update_option( self::OPT_PASK, array( 'kada' => current_time( 'mysql', true ), 'eiluciu' => count( $rows ), 'st' => $st ), false );",
   "return new WP_REST_Response( array( 'ok' => 1, 'st' => $st ), 200 );",
   "}",
   "",
   "/* ---------- Kaina24 / Kainos.lt: iš islaidos skaitiklio ---------- */",
   "public static function portalai_cron() {",
   "if ( ! class_exists( 'Petshop_Islaidos' ) || ! method_exists( 'Petshop_Islaidos', 'portalo_spend' ) ) { return; }",
   "global $wpdb;",
   "$vakar = gmdate( 'Y-m-d', strtotime( wp_date( 'Y-m-d' ) ) - DAY_IN_SECONDS );",
   "$cpc = defined( 'Petshop_Islaidos::CPC_NETO_CT' ) ? (int) Petshop_Islaidos::CPC_NETO_CT : 8;",
   "foreach ( array( 'kaina24', 'kainos' ) as $p ) {",
   "$n = (int) $wpdb->get_var( $wpdb->prepare( \"SELECT COUNT(DISTINCT lankytojas_d) FROM {$wpdb->prefix}ps_web_ivykiai WHERE diena=%s AND saltinis=%s AND testinis=0\", $vakar, $p ) );",
   "self::rasyti( array( 'diena' => $vakar, 'kanalas' => $p, 'kampanija_id' => '', 'kampanija' => '', 'paspaudimai' => $n, 'islaidos' => $n * $cpc / 100, 'saltinis' => 'skaitiklis' ) );",
   "}",
   "}",
   "",
   "/* ---------- Skaitymas ekranams ---------- */",
   "/** Išlaidos per laikotarpį: [ 'viso_ct', 'per_kanala' => [kanalas => ct], 'per_kampanija' => [id => [kampanija, islaidos_ct, paspaudimai, konversijos]] ] */",
   "public static function islaidos( $nuo, $iki, $senoji = false ) {",
   "global $wpdb; $t = self::t();",
   "$out = array( 'viso_ct' => 0, 'per_kanala' => array(), 'per_kampanija' => array() );",
   "if ( $wpdb->get_var( $wpdb->prepare( 'SHOW TABLES LIKE %s', $t ) ) !== $t ) { return $out; }",
   "$s = $senoji ? '' : ' AND senoji_svetaine = 0 ';",
   "foreach ( (array) $wpdb->get_results( $wpdb->prepare( \"SELECT kanalas, kampanija_id, MAX(kampanija) kampanija, SUM(islaidos_ct) c, SUM(paspaudimai) p, SUM(konversijos) k FROM $t WHERE diena BETWEEN %s AND %s $s GROUP BY kanalas, kampanija_id\", $nuo, $iki ), ARRAY_A ) as $r ) {",
   "$out['viso_ct'] += (int) $r['c'];",
   "$out['per_kanala'][ $r['kanalas'] ] = ( isset( $out['per_kanala'][ $r['kanalas'] ] ) ? $out['per_kanala'][ $r['kanalas'] ] : 0 ) + (int) $r['c'];",
   "if ( 'google_ads' === $r['kanalas'] ) { $out['per_kampanija'][ $r['kampanija_id'] ] = array( 'kampanija' => $r['kampanija'], 'islaidos_ct' => (int) $r['c'], 'paspaudimai' => (int) $r['p'], 'konversijos' => (float) $r['k'] ); }",
   "}",
   "return $out;",
   "}",
   "}",
   "Petshop_Fakt_Reklama::init();",
   ""
