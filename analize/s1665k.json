   "73 update_option( self::SCHEMA_KEY, self::SCHEMA_VER, 'no' );",
   "74 if ( ! get_option( self::OPT_RAKTAS ) ) { update_option( self::OPT_RAKTAS, wp_generate_password( 32, false ), 'no' ); }",
   "90 $p = get_option( 'ps_stat_pradzia', '' );",
   "129 /* ---------- REST: Google Ads Script webhook ---------- */",
