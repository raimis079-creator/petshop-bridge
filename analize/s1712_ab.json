  "aprasymu_dubl": [
   {
    "n": "13",
    "pvz": "<p>Ebi - itin patvarių žaislų šunims gamintojas, Nyderlandų įmonė, todėl šie žaislai tikra"
   },
   {
    "n": "12",
    "pvz": "&lt;p&gt;Petnešos šunims su reguliuojama juosta. Su paminkštinimu patogesniam dėvėjimui; &"
   },
   {
    "n": "11",
    "pvz": "<p>Tai žaislas iš itin lanksčios ir minkštos, tačiau tvirtos medžiagos, puikiai tinkančios"
   },
   {
    "n": "6",
    "pvz": "&lt;p&gt;Kasdieninės, labai tvirtos petnešos &lt;span style=\"font-family: -apple-system, B"
   },
   {
    "n": "5",
    "pvz": "&lt;p&gt;Premium pavadys šunims su austine juosta, paminkštinta neoprenu. 3 lygių reguliav"
   },
   {
    "n": "5",
    "pvz": "&lt;p&gt;Apsauginė apykaklė šunims ir katėms. Po operacijos arba susižeidus, šunys ir katė"
   },
   {
    "n": "4",
    "pvz": "&lt;p class=\"western\" align=\"left\"&gt;Kasdieninės, labai tvirtos petnešos &lt;span style=\""
   },
   {
    "n": "4",
    "pvz": "&lt;p&gt;Idealiai tinka trumpalaikiam apgyvendinimui namuose; 2 durys, priekinės ir šoninė"
