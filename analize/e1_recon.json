  "teises_katalogas_ctx": "<?php\n/**\n * Petshop Teises v1.1 (S756) — DARBUOTOJO ROLE IR SVARUS EKRANAS.\n *\n * KAM (savininko patikslinimas 2026-08-10): tikslas — kad ZMOGUS\n * NESIPAINIOTU, o ne kad ko nors nematytu. Naujokui atsidarius WordPress\n * admina, jis mato septyniolika meniu punktu, is kuriu darbui reikia penkiu.\n * Visa kita — triuksmas, kuriame lengva pasiklysti ir netycia atsidurti ne\n * ten, kur reikia.\n *\n * SPRENDIMAS: role „Petshop darbuotojas\" su ISVALYTU ekranu. Meniu paliekami\n * TIK darbo langai; po prisijungimo zmogus patenka tiesiai i Kataloga, ne i\n * tuscia Skydeli. Apribojimai yra salutinis efektas, ne tikslas.\n *\n * KA GALI:\n *   Katalogas · Akcijos · Gavimas · Tiekimas · Uzsakymai (visi Petshop langai)\n *   prekiu kurimas, redagavimas, publikavimas, atributai, kategorijos\n *   nuotrauku ikelimas, uzsakymu tvarkymas, WooCommerce ataskaitos\n *\n * KO NEMATO (nes darbui nereikia, ne del nepasitikejimo):\n *   WooCommerce nustatymai, pluginai, temos, kodo redaktorius, atnaujinimai,\n *   vartotojai, irankiai, YITH, mokejimu skydeliai, svetimi pranesimai.\n *\n * VIENINTELIS TIKRAS DRAUDIMAS: prekes istrynimas VISAM LAIKUI. I siuksline\n * mesti galima (atstatoma vienu paspaudimu), o galutinis trynimas panaikina\n * SEO nuoroda, uzsakymu istorija ir tiekejo susiejima — to neatsuka nei\n * zurnalas, nei atsargine kopija.\n *\n * ATSKIRA TEISE `ps_akcijas_taikyti`: akcijos KURIMAS ir perziura leidziami\n * visiems darbuotojams, o IJUNGIMAS (realus kainu keitimas visam katalogui)\n * — atskira teise. Pagal nutylejima darbuotojas ja TURI (savininko prasymas\n * „kad galetu ramiai testuotis\"); atimama viena eilute — zr. `TAIKO_AKCIJAS`.\n *\n * @package Petshop\n */\n\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\nclass Petshop_Teises {\n\n\tconst VERSIJA = '1.1';\n\tconst ROLE     = 'ps_darbuotojas';\n\tconst OPT      = 'ps_teises_versija';\n\n\t/** Ar darbuotojas gali IJUNGTI akcijas (keisti kainas). false = tik savininkas. */\n\tconst TAIKO_AKCIJAS = true;\n\n\tpublic static function init() {\n\t\tadd_action( 'init', array( __CLASS__, 'uztikrinti_role' ) );\n\t\tadd_action( 'admin_menu', array( __CLASS__, 'valyti_meniu' ), 999 );\n\t\tadd_action( 'admin_init', array( __CLASS__, 'blokuoti_puslapius' ) );\n\t\tadd_action( 'admin_bar_menu', array( __CLASS__, 'valyti_juosta' ), 999 );\n\t\tadd_filter( 'login_redirect', array( __CLASS__, 'po_prisijungimo' ), 10, 3 );\n\t\tadd_action( 'admin_init', array( __CLASS__, 'nuo_skydelio' ) );\n\t\tadd_action( 'admin_print_scripts', array( __CLASS__, 'slepti_pranesimus' ), 1 );\n\t\tadd_filter( 'screen_options_show_screen', array( __CLASS__, 'slepti_ekrano_nustatymus' ) );\n\t\tadd_actio",
