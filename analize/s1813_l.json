   "petshop-rytas.php": "i > 2 d. be siuntos: ' . $n );\n\n\t\t/* dropship SLA (petshop-dropship-sargas žymė) */\n\t\t$n = (int) $wpdb->get_var( \"SELECT COUNT(*) FROM {$p}wc_orders_meta m JOIN {$p}wc_orders o ON o.id = m.order_id WHERE m.meta_key = '_ps_sla_velavimas' AND o.status IN ('wc-processing','wc-on-hold')\" );\n\t\t$add( 'dropship_sla', $n ? 'raudona' : 'zalia', 'Dropship tiekėjas vėluoja > 2 darbo d.: ' . $n . ' užsak.' );\n\n\t\t/* laiškai */\n\t\tif ( self::lentele_yra( $p . 'ps_email_jobs' ) ) {\n\t\t\t$r = $wpdb->get_row( \"SELECT SUM(status='sent') s, SUM(status='failed') f FROM {$p}ps_email_jobs WHERE created_at >= UTC_TIMESTAMP() - INTERVAL 1 DAY\", ARRAY_A );\n\t\t\t$s = (int) $r['s']; $f2 = (int) $r['f'];\n\t\t\t/* S1749: neaišku ar išėjo (timeout/5xx) ir įstrigę siunčiant — raudona: tikrinti Sender žurnale, nekartoti aklai */\n\t\t\t$neaisku = (int) $wpdb->get_var( \"SELECT COUNT(*) FROM {$p}ps_email_jobs WHERE status = 'uncertain'\" );\n\t\t\t$strige  = (int) $wpdb->get_var( \"SELECT COUNT(*) FROM {$p}ps_email_jobs WHERE status = 'sending' AND updated_at < UTC_TIMESTAMP() - INTERVAL 15 MINUTE\" );\n\t\t\t$veluoja = (int) $wpdb->get_var( \"SELECT COUNT(*) FROM {$p}ps_email_jobs WHERE status = 'pending' AND scheduled_at < UTC_TIMESTAMP() - INTERVAL 2 HOUR\" );\n\t\t\t$lyg_ = ( $neaisku || $strige || ( $f2 && ( $s + $f2 ) && $f2 / ( $s + $f2 ) > 0.05 ) ) ? 'raudona' : ( ( $f2 || $veluoja ) ? 'geltona' : 'zalia' );\n\t\t\t$add( 'laiskai', $lyg_, 'Laiškai 24 val.: išsiųsta ' . $s . ', nepavyko ' . $f2\n\t\t\t\t. ( $neaisku ? '; NEAIŠKU ar išėjo: ' . $neaisku . ' (tikrinti Sender žurnale)' : '' )\n\t\t\t\t. ( $strige ? '; įstrigo siunčiant: ' . $strige : '' )\n\t\t\t\t. ( $veluoja ? '; eilėje vėluoja > 2 val.: ' . $veluoja : ''"
