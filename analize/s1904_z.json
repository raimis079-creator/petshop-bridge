   {
    "f": "wp-content/mu-plugins/petshop-import-tempas.php",
    "l": "59-75",
    "src": [
     "\tpublic static function vykdyti(): void {",
     "\t\tglobal $wpdb;",
     "\t\t$key = self::raktas();",
     "\t\tif ( $key === '' ) return;",
     "\t\tforeach ( self::IMPORTAI as $id ) {",
     "\t\t\t$r = $wpdb->get_row( $wpdb->prepare( \"SELECT triggered, processing, executing FROM {$wpdb->prefix}pmxi_imports WHERE id=%d\", $id ), ARRAY_A );",
     "\t\t\tif ( ! $r || (int) $r['triggered'] !== 1 || (int) $r['processing'] === 1 || (int) $r['executing'] === 1 ) continue;",
     "\t\t\tif ( get_transient( 'ps_import_tempas_lock_' . $id ) ) continue;",
     "\t\t\tset_transient( 'ps_import_tempas_lock_' . $id, 1, 90 );",
     "\t\t\t$url = self::hostas() . '/wp-load.php?import_key=' . rawurlencode( $key ) . '&import_id=' . $id . '&action=processing';",
     "\t\t\t$t0  = microtime( true );",
     "\t\t\t$r   = wp_remote_get( $url, [ 'timeout' => 75, 'sslverify' => false ] );",
     "\t\t\t$ats = is_wp_error( $r ) ? $r->get_error_message() : mb_substr( (string) wp_remote_retrieve_body( $r ), 0, 120 );",
     "\t\t\tdelete_transient( 'ps_import_tempas_lock_' . $id );",
     "\t\t\tupdate_option( self::OPT, [ 'laikas' => current_time( 'mysql' ), 'import_id' => $id, 'veiksmas' => 'processing', 'hostas' => self::hostas(), 'sek' => round( microtime( true ) - $t0, 1 ), 'atsakymas' => $ats ], false )",
     "\t\t}",
     "\t}"
    ]
   }
