  "k3270": [
   "\t\twc_delete_product_transients( $lid );",
   "\t\t$sv = self::svarios_pakopos( $lid, self::pakopos( $lid ) );",
   "\t\tupdate_post_meta( $lid, self::META_PAKOPOS, wp_json_encode( $sv['pakopos'] ) );",
   "",
   "\t\t$zinute = 'Pridėta prekių: ' . $prideta . '.';",
   "\t\tif ( $praleista ) { $zinute .= ' Praleista dėl kito sandėlio: ' . implode( ', ', array_slice( $praleista, 0, 3 ) ) . '.'; }",
   "\t\tif ( $sv['perspejimai'] ) { $zinute .= ' ' . implode( ' ', $sv['perspejimai'] ); }",
   "\t\twp_send_json_success( array( 'zinute' => $zinute, 'prideta' => $prideta ) );",
   "\t}",
   "",
   "\t/** Filtru reiksmes su kiekiais — imamos is realiu prekiu, ne rasomos ranka. */",
   "\tpublic static function filtru_reiksmes() {",
   "\t\t$kesas = get_transient( 'ps_laukai_filtrai' );",
   "\t\tif ( is_array( $kesas ) ) { return $kesas; }",
   "\t\t$r = array( 'kategorijos' => array(), 'baltymai' => array(), 'mityba' => array(), 'grudai' => array() );",
   "\t\tforeach ( array( 95, 96, 97, 98 ) as $tid ) {",
   "\t\t\t$t = get_term( $tid, 'product_cat' );",
   "\t\t\tif ( $t && ! is_wp_error( $t ) ) { $r['kategorijos'][] = array( (string) $tid, $t->name, (int) $t->count ); }",
   "\t\t}",
   "\t\t$q = new WP_Query( array( 'post_type' => 'product', 'post_status' => 'publish', 'posts_per_page' => -1, 'fields' => 'ids',",
   "\t\t\t'tax_query' => array( array( 'taxonomy' => 'product_cat', 'field' => 'term_id',",
   "\t\t\t\t'terms' => array( 95, 96, 97, 98 ), 'include_children' => true ) ) ) );",
   "\t\t$sk = array( 'pa_baltymu_saltinis' => array(), 'pa_speciali_mityba' => array(), 'pa_be_grudu' => array() );",
   "\t\tforeach ( $q->posts as $pid ) {",
   "\t\t\tforeach ( $sk as $tax => $x ) {",
   "\t\t\t\tforeach ( (array) wp_get_post_terms( $pid, $tax, array( 'fields' => 'names' ) ) as $n ) {",
   "\t\t\t\t\t$sk[ $tax ][ $n ] = ( $sk[ $tax ][ $n ] ?? 0 ) + 1;",
   "\t\t\t\t}",
   "\t\t\t}",
   "\t\t}",
   "\t\tforeach ( array( 'baltymai' => 'pa_baltymu_saltinis', 'mityba' => 'pa_speciali_mityba', 'grudai' => 'pa_be_grudu' ) as $k => $tax ) {",
   "\t\t\tarsort( $sk[ $tax ] );",
   "\t\t\tforeach ( $sk[ $tax ] as $n => $c ) { if ( $c >= 3 ) { $r[ $k ][] = array( $n, $n, $c ); } }",
   "\t\t}"
