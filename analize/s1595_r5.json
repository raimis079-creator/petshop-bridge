  "k1770": [
   "\t * Grupe = lango skirstymas: skanestai sunims, skanestai katems, kramtalai.",
   "\t * Imama is krepsio prekiu kategoriju, ne rasoma ranka — kitaip savininkas",
   "\t * turetu prizieti dar viena lauka, kuris gali nesutapti su tikrove.",
   "\t */",
   "\tpublic static function grupe( $lid ) {",
   "\t\t$rankinis = get_post_meta( $lid, '_ps_laukas_grupe', true );",
   "\t\tif ( $rankinis ) {",
   "\t\t\t/* Meta gali buti irasyta ne raktu, o grupes VARDU (taip nutiko kuriant",
   "\t\t\t   testines dezes per koda). Filtrai lygina raktus, tad vardas duotu",
   "\t\t\t   tuscia sarasa. Priimam abu — ir grazinam rakta. */",
   "\t\t\t$vardai = self::grupiu_vardai();",
   "\t\t\tif ( isset( $vardai[ $rankinis ] ) ) { return $rankinis; }",
   "\t\t\tforeach ( $vardai as $rakt => $vard ) {",
   "\t\t\t\tif ( self::sulyginti( $vard ) === self::sulyginti( $rankinis ) ) { return $rakt; }",
   "\t\t\t}",
   "\t\t\treturn $rankinis;",
   "\t\t}",
   "",
   "\t\t/* Pirma — pats rinkinys: jo pavadinimas ir kategorijos. Kramtalai guli",
   "\t\t   „Skanestu sunims\" kategorijoje, todel is vien krepsio prekiu ju",
   "\t\t   atskirti neimanoma — rinkinys pats pasako, kas jis toks. */",
   "\t\t$savo = get_the_title( $lid ) . ' ' . implode( ' ',",
   "\t\t\t(array) wp_get_post_terms( $lid, 'product_cat', array( 'fields' => 'names' ) ) );",
   "\t\tif ( preg_match( '/kramt/iu', $savo ) ) { return 'kramtalai'; }",
   "\t\tif ( preg_match( '/kat[ėe]/iu', $savo ) ) { return 'kates'; }",
   "",
   "\t\t$kramtalas = false; $kates = false; $sunys = false;",
   "\t\tforeach ( self::krepsys( $lid ) as $cid ) {",
   "\t\t\t$kat = wp_get_post_terms( $cid, 'product_cat', array( 'fields' => 'names' ) );",
   "\t\t\tforeach ( (array) $kat as $k ) {",
   "\t\t\t\tif ( preg_match( '/kramt/iu', $k ) ) { $kramtalas = true; }",
   "\t\t\t\tif ( preg_match( '/kat[ėe]ms/iu', $k ) ) { $kates = true; }",
   "\t\t\t\tif ( preg_match( '/šunims|sunims/iu', $k ) ) { $sunys = true; }",
   "\t\t\t}",
   "\t\t\t$pav = get_the_title( $cid );",
   "\t\t\tif ( preg_match( '/kramt/iu', $pav ) ) { $kramtalas = true; }",
   "\t\t\tif ( preg_match( '/kat[ėe]ms/iu', $pav ) ) { $kates = true; }",
   "\t\t\tif ( preg_match( '/šunims|sunims/iu', $pav ) ) { $sunys = true; }",
   "\t\t}",
   "\t\tif ( $kramtalas ) { return 'kramtalai'; }",
   "\t\tif ( $kates && ! $sunys ) { return 'kates'; }",
   "\t\treturn 'sunys';",
   "\t}",
   "",
   "\tpublic static function grupiu_vardai() {",
   "\t\treturn array(",
   "\t\t\t'sunys'      => 'Skanėstai šunims',",
   "\t\t\t'kates'      => 'Skanėstai katėms',",
   "\t\t\t'kramtalai'  => 'Kramtalai',",
   "\t\t\t/* Konservu dezes — atskiros grupes, nes vitrinoje jos jungiamos",
   "\t\t\t   i dydzio + poreikio eilutes ir su skanestais nesimaiso. */",
   "\t\t\t'kons_sunims' => 'Konservai šunims',",
   "\t\t\t'kons_kates'  => 'Konservai katėms',",
   "\t\t);",
   "\t}",
   "",
   "\t/** Palyginimui: be diakritiku, mazosiomis — „Konservai sunims\" = „Konservai šunims\". */",
   "\tprivate static function sulyginti( $t ) {",
   "\t\t$t = mb_strtolower( trim( (string) $t ) );",
   "\t\treturn strtr( $t, array( 'ą'=>'a','č'=>'c','ę'=>'e','ė'=>'e','į'=>'i','š'=>'s','ų'=>'u','ū'=>'u','ž'=>'z' ) );"
  ]
 }
