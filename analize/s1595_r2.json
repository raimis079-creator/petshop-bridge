  "k938": [
   "\t/** Kategoriju medis su palikuoniu skaiciais. Kesuojamas — 2 500 prekiu. */",
   "\tpublic static function medis() {",
   "\t\t$kesas = get_transient( 'ps_rink_medis' );",
   "\t\tif ( is_array( $kesas ) && isset( $kesas['v'] ) && $kesas['v'] === self::VERSIJA ) { return $kesas; }",
   "",
   "\t\t$terms = get_terms( array( 'taxonomy' => 'product_cat', 'hide_empty' => false ) );",
   "\t\tif ( is_wp_error( $terms ) ) { $terms = array(); }",
   "",
   "\t\t$cats = array(); $vaikai = array();",
   "\t\tforeach ( $terms as $t ) {",
   "\t\t\t$cats[ $t->term_id ] = array( 'id' => $t->term_id, 'n' => $t->name, 'p' => (int) $t->parent );",
   "\t\t\t$vaikai[ (int) $t->parent ][] = $t->term_id;",
   "\t\t}",
   "\t\t/* palikuonys */",
   "\t\t$palik = array();",
   "\t\t$rasti = function( $id ) use ( &$rasti, $vaikai ) {",
   "\t\t\t$out = array( $id );",
   "\t\t\tif ( ! empty( $vaikai[ $id ] ) ) {",
   "\t\t\t\tforeach ( $vaikai[ $id ] as $v ) { $out = array_merge( $out, $rasti( $v ) ); }",
   "\t\t\t}",
   "\t\t\treturn $out;",
   "\t\t};",
   "\t\tforeach ( $cats as $id => $c ) { $palik[ $id ] = $rasti( $id ); }",
   "",
   "\t\t/* prekiu skaicius su palikuoniais */",
   "\t\tglobal $wpdb; $p = $wpdb->prefix;",
   "\t\t$eil = $wpdb->get_results(",
   "\t\t\t\"SELECT tr.object_id pid, tt.term_id tid",
   "\t\t\t   FROM {$p}term_relationships tr",
   "\t\t\t   JOIN {$p}term_taxonomy tt ON tt.term_taxonomy_id = tr.term_taxonomy_id",
   "\t\t\t   JOIN {$p}posts po ON po.ID = tr.object_id AND po.post_type='product' AND po.post_status='publish'",
   "\t\t\t  WHERE tt.taxonomy='product_cat'\", ARRAY_A );",
   "\t\t$prekes = array();",
   "\t\tforeach ( $eil as $e ) { $prekes[ (int) $e['pid'] ][] = (int) $e['tid']; }",
   "\t\t$kiek = array();",
   "\t\tforeach ( $palik as $id => $sarasas ) {",
   "\t\t\t$rink = array_flip( $sarasas ); $n = 0;",
   "\t\t\tforeach ( $prekes as $pid => $ks ) {",
   "\t\t\t\tforeach ( $ks as $k ) { if ( isset( $rink[ $k ] ) ) { $n++; break; } }",
   "\t\t\t}",
   "\t\t\t$kiek[ $id ] = $n;",
   "\t\t}",
   "",
   "\t\t/* meniu tvarka: kas rodoma klientui, tas ir cia pirma */",
   "\t\t$meniu_top = array(); $meniu = wp_get_nav_menu_object( 'Pagrindinis meniu' );"
  ]
 }
