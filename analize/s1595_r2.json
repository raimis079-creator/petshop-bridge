  "k2030": [
   "\t/* ==================== SARASAS ==================== */",
   "",
   "\t/**",
   "\t * Sarasas sukurtas galvojant apie 200+ rinkiniu, ne apie 14.",
   "\t * Serveris paduoda visus duomenis vienu kartu, filtravimas/rikiavimas vyksta",
   "\t * narsykleje — taip kiekvienas filtro paspaudimas neperkrauna puslapio.",
   "\t * Prie kelių tukstanciu tektu pereiti i serverio puse; iki tol tai greiciau.",
   "\t */",
   "\tprivate static function sarasas() {",
   "\t\t$sar    = self::rinkiniai();",
   "\t\t$rusys  = self::rusys();",
   "\t\t$nauja  = admin_url( 'admin.php?page=' . self::SLUG . '&veiksmas=naujas' );",
   "",
   "\t\t/* kategorijos filtrui — tik tos, kurios realiai naudojamos */",
   "\t\t$kat = array();",
   "\t\tforeach ( $sar as $r ) {",
   "\t\t\tforeach ( (array) $r['kat'] as $k ) { $kat[ $k ] = ( $kat[ $k ] ?? 0 ) + 1; }",
   "\t\t}",
   "\t\tksort( $kat );",
   "",
   "\t\t$duomenys = array();",
   "\t\tforeach ( $sar as $r ) {",
   "\t\t\t$proc = ( $r['marza'] !== null && $r['kaina'] > 0 ) ? round( $r['marza'] / $r['kaina'] * 100 ) : null;",
   "\t\t\t$duomenys[] = array(",
   "\t\t\t\t'id'    => (int) $r['id'],",
   "\t\t\t\t'pav'   => $r['pav'],",
   "\t\t\t\t'sku'   => $r['sku'],",
   "\t\t\t\t'st'    => $r['busena'],",
   "\t\t\t\t'tipas' => $r['tipas'] ?? 'mnm',",
   "\t\t\t\t'kaina' => (float) $r['kaina'],",
   "\t\t\t\t'sav'   => $r['savikaina'],",
   "\t\t\t\t'suma'  => (float) $r['suma'],",
   "\t\t\t\t'marza' => $r['marza'],",
   "\t\t\t\t'pct'   => $proc,",
   "\t\t\t\t'vnt'   => (int) $r['vnt'],",
   "\t\t\t\t'poz'   => (int) $r['poz'],",
   "\t\t\t\t'miss'  => (int) $r['truksta'],",
   "\t\t\t\t'lubos' => $r['lubos'],",
   "\t\t\t\t'sand'  => array_values( (array) $r['sandeliai'] ),",
   "\t\t\t\t'rusis' => $r['rusis'] ?? null,",
   "\t\t\t\t'kat'   => array_values( (array) $r['kat'] ),",
   "\t\t\t\t'foto'  => $r['foto'] ?? '',",
   "\t\t\t\t'komp'  => array_slice( (array) ( $r['komp'] ?? array() ), 0, 8 ),",
   "\t\t\t\t'keista' => $r['keista'] ?? '',",
   "\t\t\t\t'nuoroda' => admin_url( 'admin.php?page=' . self::SLUG . '&veiksmas=keisti&id=' . (int) $r['id'] ),"
  ],
