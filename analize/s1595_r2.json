   "\t\techo '<span class=\"psr-f\"><label>Sandėlis</label><span id=\"psr-f-sand\">';",
   "\t\tforeach ( array( '' => 'Visi', 'av' => 'AV', 'vf' => 'VF', 'zb' => 'ZB' ) as $k => $v ) {"
