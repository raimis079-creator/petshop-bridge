   "145": "// --- 5/6) Job TIK jei yra gavejas. Consent tikrina DISPATCH. ---",
   "146": "if ( $row['email'] && class_exists( 'Petshop_Email_Dispatch' ) ) {",
   "147": "$res = Petshop_Email_Dispatch::enqueue(",
   "148": "'cart_abandoned',",
