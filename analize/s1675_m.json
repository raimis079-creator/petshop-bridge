   "153": "'user_id' => $row['user_id'] ? (int) $row['user_id'] : null,",
   "154": "'context' => array( 'cart_id' => $cart_id ),",
   "155": ")",
   "156": ");",
   "157": "if ( ! empty( $res['ok'] ) ) { $out['jobs']++; }",
   "158": "} else {",
   "159": "$out['no_email']++;",
   "160": "}",
   "162": "$out['details'][] = array(",
   "163": "'cart_id' => $cart_id, 'action' => 'ABANDONED',",
   "164": "'items' => count( $valid ), 'email' => $row['email'] ? 'yra' : 'nera',",
   "165": ");",
   "166": "}",
   "168": "// --- 7) Senesni nei 7 d. -> expired, BE evento ---",
   "169": "if ( ! $dry_run ) {",
   "170": "$out['expired'] = (int) $wpdb->query( $wpdb->prepare(",
   "171": "\"UPDATE $T SET status='expired', status_changed_at=%s, updated_at=%s",
   "172": "WHERE status='active' AND converted_order_id IS NULL",
   "173": "AND ( last_cart_activity_at IS NULL OR last_cart_activity_at < %s )\",",
   "174": "$now, $now, $floor ) );",
   "175": "} else {",
   "266": "// stage1 issiusti job'ai, kuriems stage2 dar nera",
   "267": "$rows = $wpdb->get_results( $wpdb->prepare(",
   "268": "\"SELECT j.id AS job_id, j.job_key, j.recipient_email, j.recipient_user_id,",
   "269": "j.payload, j.context_json, j.sent_at",
   "270": "FROM $EJ j",
   "271": "WHERE j.flow = 'cart_abandoned'",
   "272": "AND j.status = 'sent'",
   "273": "AND j.sent_at IS NOT NULL",
   "274": "AND j.sent_at <= %s",
   "275": "AND NOT EXISTS (",
   "276": "SELECT 1 FROM $EJ j2",
   "277": "WHERE j2.flow = 'cart_abandoned_2'",
   "278": "AND j2.job_key = CONCAT(",
   "279": "SUBSTRING_INDEX( j.job_key, ':stage1', 1 ), ':stage2' )",
   "280": ")",
   "281": "ORDER BY j.sent_at ASC LIMIT %d\", $cutoff, self::BATCH ), ARRAY_A );",
   "283": "$out['candidates'] = count( (array) $rows );",
   "285": "foreach ( (array) $rows as $j ) {",
   "286": "$ctx = json_decode( (string) $j['context_json'], true );",
   "287": "if ( ! is_array( $ctx ) ) { $ctx = array(); }",
   "288": "$cart_id = isset( $ctx['cart_id'] ) ? $ctx['cart_id'] : '';",
   "289": "if ( ! $cart_id ) {",
   "290": "$out['skipped'][] = array( $j['job_key'], 'no_cart_id' );",
   "291": "continue;",
   "292": "}",
   "294": "$cart = $wpdb->get_row( $wpdb->prepare(",
   "295": "\"SELECT * FROM $T WHERE cart_id=%s LIMIT 1\", $cart_id ), ARRAY_A );",
   "296": "if ( ! $cart ) {",
   "297": "$out['skipped'][] = array( $cart_id, 'cart_gone' );",
   "298": "continue;",
   "299": "}",
   "300": "// Uzsakymas ivyko arba krepselis atkurtas/uzdarytas",
   "325": "// TOKENO PAKARTOTINIS NAUDOJIMAS",
   "326": "$ctx2 = array( 'cart_id' => $cart_id );",
   "327": "if ( ! empty( $ctx['recovery_url'] ) && self::token_still_valid( $ctx['recovery_url'] ) ) {",
   "328": "$ctx2['recovery_url']   = $ctx['recovery_url'];",
   "329": "$ctx2['token_reused']   = 1;",
   "330": "}",
   "332": "$res = Petshop_Email_Dispatch::enqueue(",
   "333": "'cart_abandoned_2',",
   "334": "$j['recipient_email'],",
   "335": "$payload,",
   "336": "array(",
   "337": "'job_key' => 'cart_abandoned:' . $cart_id . ':stage2',",
   "338": "'user_id' => ! empty( $j['recipient_user_id'] ) ? (int) $j['recipient_user_id'] : null,",
   "339": "'context' => $ctx2,",
   "340": ")",
   "341": ");",
   "342": "if ( ! empty( $res['ok'] ) && empty( $res['duplicate'] ) ) { $out['queued']++; }",
   "343": "$out['details'][] = array(",
   "344": "'cart_id' => $cart_id, 'action' => 'QUEUED',",
   "345": "'token_reused' => isset( $ctx2['token_reused'] ) ? 1 : 0,"
  }
 }
