   "function petshop_pragma_run_export( $year, $month ) {",
   "",
   "    $period_label = $year . '-' . str_pad( $month, 2, '0', STR_PAD_LEFT );",
   "",
   "    $days_in_month = cal_days_in_month( CAL_GREGORIAN, $month, $year );",
   "    $month_pad     = str_pad( $month, 2, '0', STR_PAD_LEFT );",
   "    $date_from     = strtotime( $year . '-' . $month_pad . '-01 00:00:00' );",
   "    $date_to       = strtotime( $year . '-' . $month_pad . '-' . $days_in_month . ' 23:59:59' );",
   "",
   "    // Gauname apmoketus uzsakymus uz sita menesi",
   "    $orders = wc_get_orders( array(",
   "        'status'       => array( 'completed' ), // Tik completed - ne processing (bankinis laukiantis)",
   "        'date_created' => $date_from . '...' . $date_to,",
   "        'limit'        => -1,",
   "        'orderby'      => 'date',",
   "        'order'        => 'ASC',",
   "    ) );",
   "",
   "    if ( empty( $orders ) ) {",
   "        petshop_pragma_log( $period_label . ': nera uzsakymu' );",
   "        return;",
   "    }",
   "",
   "    // Filtruojame - tik tie kurie turi AVPN numerį (PVM sąskaita faktūra = apmokėti)",
   "    // IAPV (išankstinė sąskaita = neapmokėti bankiniai) - NEEKSPORTUOJAME",
   "    $valid_orders = array();",
   "    foreach ( $orders as $order ) {",
   "        $doc_type = $order->get_meta( '_petshop_invoice_document_type' );",
   "        $avpn     = $order->get_meta( '_petshop_avpn_number' );",
   "",
   "        // Tik jei doc_type = 'invoice' IR turi AVPN numerį",
   "        if ( $doc_type === 'invoice' && $avpn ) {",
   "            $valid_orders[] = $order;",
   "        }",
   "    }",
   "",
   "    if ( empty( $valid_orders ) ) {",
   "        petshop_pragma_log( $period_label . ': nera AVPN saskaitu' );",
   "        return;",
   "    }",
   "",
   "    // Generuojame 3 failus",
   "    $imones_content      = petshop_pragma_generate_imones( $valid_orders );",
   "    $pardavimai_content  = petshop_pragma_generate_pardavimai( $valid_orders );",
   "    $pardavimai_sum_content = petshop_pragma_generate_pardavimai_sum( $valid_orders );",
   "",
   "    // Isssaugome tmp failuose",
   "    $tmp_dir = sys_get_temp_dir();",
   "    $f_imones = $tmp_dir . '/imones_' . $period_label . '.txt';",
   "    $f_pard   = $tmp_dir . '/pardavimai_' . $period_label . '.txt';",
   "    $f_sum    = $tmp_dir . '/pardavimai_sum_' . $period_label . '.txt';",
   "",
   "    file_put_contents( $f_imones, $imones_content );",
   "    file_put_contents( $f_pard,   $pardavimai_content );",
   "    file_put_contents( $f_sum,    $pardavimai_sum_content );",
   "",
   "    // Naujų klientų PDF priedai",
   "    $known_emails  = (array) get_option( 'petshop_pragma_known_emails', array() );",
   "    $new_pdfs      = array();",
   "    $new_emails    = array();",
   "    $new_order_nrs = array();",
   "",
   "    foreach ( $valid_orders as $order ) {",
   "        $email = strtolower( trim( $order->get_billing_email() ) );",
   "        if ( ! in_array( $email, $known_emails, true ) ) {",
   "            // Naujas klientas - pridedame PDF",
   "            $pdf = $order->get_meta( '_petshop_completed_pdf' );",
   "            if ( ! $pdf ) $pdf = $order->get_meta( '_petshop_order_pdf' );",
   "            if ( $pdf && file_exists( $pdf ) ) {",
   "                $new_pdfs[] = $pdf;",
   "            }",
   "            $new_emails[]    = $email;",
   "            $new_order_nrs[] = $order->get_meta( '_petshop_avpn_number' ) . ' (' . $order->get_billing_first_name() . ' ' . $order->get_billing_last_name() . ')';",
   "        }",
   "    }",
   "",
   "    // Siunčiame į buhalterija",
   "    petshop_pragma_send_email(",
   "        $period_label,",
   "        array( $f_imones, $f_pard, $f_sum ),",
   "        $new_pdfs,",
   "        $new_order_nrs",
   "    );",
   "",
   "    // Issaugome naujus klientus",
   "    if ( ! empty( $new_emails ) ) {",
   "        $updated = array_unique( array_merge( $known_emails, $new_emails ) );",
   "        update_option( 'petshop_pragma_known_emails', $updated );",
   "    }",
   "",
   "    // Isvalome tmp failus",
   "    @unlink( $f_imones );",
   "    @unlink( $f_pard );",
   "    @unlink( $f_sum );",
   "",
   "    petshop_pragma_log( $period_label . ': eksportas sekmingai. Uzsakymu: ' . count( $valid_orders ) . ', Nauju klientu: ' . count( $new_emails ) );",
   "}",
   "",
   "// ================================================================",
   "// 3. IMONES.TXT GENERAVIMAS",
   "// ================================================================",
   "=====",
   "function petshop_pragma_send_email( $period_label, $txt_files, $new_pdfs, $new_order_nrs ) {",
   "    $production = get_option( 'petshop_pragma_production_mode', false );",
   "",
   "    // Gavėjas — production: info@audac.lt, test: terra@petshop.lt",
   "    $default_to = $production ? 'info@audac.lt' : 'terra@petshop.lt';",
   "    $to = apply_filters( 'petshop_pragma_recipient', $default_to );",
   "",
   "    $subject = ( $production ? '' : '[TEST] ' ) . 'Petshop.lt pardavimai ' . $period_label;",
   "",
   "    $body = \"Laba diena,\\n\\n\";",
   "    $body .= \"Prisegti \" . $period_label . \" menesio pardavimų failai Pragma importui.\\n\\n\";",
   "",
   "    if ( ! empty( $new_order_nrs ) ) {",
   "        $body .= \"NAUJI KLIENTAI (\" . count( $new_order_nrs ) . \" saskaitos) - prisegtos PDF:\\n\";",
   "        foreach ( $new_order_nrs as $nr ) {",
   "            $body .= \"  - \" . $nr . \"\\n\";",
   "        }",
   "        $body .= \"\\nSios saskaitos gali reiketi atskiro importo.\\n\\n\";",
   "    } else {",
   "        $body .= \"Nauju klientu nera - visi klientai jau registruoti sistemoje.\\n\\n\";",
   "    }",
   "",
   "    $body .= \"Petshop.lt sistema\";",
   "",
   "    $headers     = array( 'Content-Type: text/plain; charset=UTF-8' );",
   "    $attachments = array_merge( $txt_files, $new_pdfs );",
   "",
   "    $result = wp_mail( $to, $subject, $body, $headers, $attachments );",
   "",
   "    // Taip pat siunciame kopiją savininkui",
   "    wp_mail(",
   "        'terra@petshop.lt',",
   "        '[PRAGMA] ' . $subject . ' - ' . ( $result ? 'OK' : 'KLAIDA' ),",
   "        $body . \"\\n\\n[Siuntimas i info@audac.lt: \" . ( $result ? 'sekmingai' : 'nepavyko' ) . \"]\",",
   "        $headers,",
   "        $attachments",
   "    );",
   "",
   "    return $result;",
   "}",
   "",
   "// ================================================================",
   "// 7. HELPER FUNKCIJOS",
   "// ================================================================",
   "function petshop_pragma_get_client_id( $order ) {"
  ],
