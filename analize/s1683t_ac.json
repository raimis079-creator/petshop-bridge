   "",
   "if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "",
   "if ( ! class_exists( 'Petshop_Rankos' ) ) :",
   "",
   "class Petshop_Rankos {",
   "",
   "\tconst VERSIJA = '1.0';",
   "\tconst ZYME    = '_ps_ranka_isimta';",
   "\tconst KADA    = '_ps_ranka_isimta_kada';",
   "\tconst KAS     = '_ps_ranka_isimta_kas';",
   "",
   "\tpublic static function init() {",
   "\t\t/* Zyme uzdedama/nuimama, kai busena keiciama. */",
   "\t\tadd_action( 'transition_post_status', array( __CLASS__, 'busena_pasikeite' ), 10, 3 );",
   "\t\t/* Vartai: automatinis publikavimas sustabdomas PRIES irasyma. */",
   "\t\tadd_filter( 'wp_insert_post_data', array( __CLASS__, 'vartai' ), 99, 2 );",
   "\t}",
   "",
   "\t/**",
   "\t * Ar si uzklausa yra ZMOGAUS veiksmas.",
   "\t *",
   "\t * Cron'as, WP-CLI ir WP All Import dirba be prisijungusio naudotojo arba",
   "\t * fone — ju sprendimas nera valia, o taisykles rezultatas.",
   "\t */",
   "\tpublic static function ranka() {",
   "\t\tif ( wp_doing_cron() ) { return false; }",
   "\t\tif ( defined( 'DOING_CRON' ) && DOING_CRON ) { return false; }",
   "\t\tif ( defined( 'WP_CLI' ) && WP_CLI ) { return false; }",
   "\t\t/* WP All Import: importo metu visada nustatytas sis konteksto zymuo. */",
   "\t\tif ( defined( 'PMXI_VERSION' ) && ! empty( $GLOBALS['pmxi_import_in_progress'] ) ) { return false; }",
   "\t\tif ( ! empty( $_REQUEST['import_key'] ) ) { return false; }",
   "\t\tif ( ! is_user_logged_in() ) { return false; }",
   "\t\treturn current_user_can( 'edit_products' ) || current_user_can( 'manage_woocommerce' );",
   "\t}",
   "",
   "\t/**",
   "\t * Zmogus pakeite busena — issaugom, kad tai buvo JO sprendimas.",
   "\t *",
   "\t * Naudojamas `transition_post_status`, o ne musu katalogo AJAX, todel kad",
   "\t * preke i juodrasti galima nustumti ir per WooCommerce langa, ir per",
   "\t * greitaji redagavima, ir masiniais veiksmais. Vieta viena — taisykle",
   "\t * galioja visur.",
   "\t */",
   "\tpublic static function busena_pasikeite( $nauja, $sena, $post ) {",
   "\t\tif ( ! $post || $post->post_type !== 'product' ) { return; }",
   "\t\tif ( $nauja === $sena ) { return; }",
   "\t\tif ( ! self::ranka() ) { return; }",
   "",
   "\t\tif ( in_array( $nauja, array( 'draft', 'private', 'trash' ), true ) && $sena === 'publish' ) {",
   "\t\t\t$u = wp_get_current_user();",
   "\t\t\tupdate_post_meta( $post->ID, self::ZYME, 'taip' );",
   "\t\t\tupdate_post_meta( $post->ID, self::KADA, current_time( 'mysql' ) );",
   "\t\t\tupdate_post_meta( $post->ID, self::KAS, $u ? $u->display_name : '' );",
   "\t\t\treturn;",
   "\t\t}",
   "",
   "\t\t/* Grazinta i prekyba ZMOGAUS ranka — zyme nebereikalinga. */",
   "\t\tif ( $nauja === 'publish' ) {",
   "\t\t\tdelete_post_meta( $post->ID, self::ZYME );",
   "\t\t\tdelete_post_meta( $post->ID, self::KADA );",
   "\t\t\tdelete_post_meta( $post->ID, self::KAS );",
   "\t\t}",
   "\t}",
   "",
   "\t/**",
   "\t * VARTAI. Automatika negali paskelbti prekes, kuria zmogus isieme."
  ],
