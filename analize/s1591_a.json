   "\tif ( $brand_normalized ) {",
   "\t\twp_set_object_terms( $post_id, $brand_normalized, PETSHOP_XML_BRAND_TAXONOMY );",
   "\t}",
   "\t$price_initialized = ( get_post_meta( $post_id, '_vf_price_initialized', true ) === 'yes' );",
   "\t$price_locked      = petshop_xml_vf_is_price_locked( $post_id );",
   "\tif ( ! $price_locked ) {",
   "\t\t$promo_batch   = (string) get_post_meta( $post_id, '_petshop_sale_batch', true );",
   "\t\t$existing_sale = get_post_meta( $post_id, '_sale_price', true );",
   "\t\t$has_promo     = ( $price_initialized && $promo_batch !== '' && $existing_sale !== '' && (float) $existing_sale > 0 );",
   "\t\tif ( $has_promo ) {",
   "\t\t\t$rr = (string) get_post_meta( $post_id, '_petshop_price_review_reason', true );",
