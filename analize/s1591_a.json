   "\t\t\t\tupdate_post_meta( $post_id, '_petshop_needs_price_review', 'yes' );",
   "\t\t\t\tupdate_post_meta( $post_id, '_petshop_price_review_reason', $rr ? $rr . ', vf_reprice_blocked_by_promo' : 'vf_reprice_blocked_by_promo' );",
   "\t\t\t}",
   "\t\t\tpetshop_xml_log( \"VF REPRICE BLOCKED (promo batch '{$promo_batch}') post {$post_id} | sku={$vf_sku}\" );",
   "\t\t} else {",
   "\t\t\t$cat_slugs = petshop_xml_get_cat_slugs( $post_id );",
   "\t\t\t$price_result = $pricing->calculate_final_price_from_xml(",
   "\t\t\t\t$vf_cost_xml, $vf_personal_xml, $brand_normalized, $cat_slugs",
   "\t\t\t);",
   "\t\t\t$new_regular = (float) $price_result['regular'];",
   "\t\t\t$new_sale    = (float) $price_result['sale'];",
   "\t\t\t$old_regular = (float) get_post_meta( $post_id, '_regular_price', true );",
   "\t\t\t$old_sale    = (float) ( $existing_sale !== '' ? $existing_sale : 0 );",
   "\t\t\t$price_differs = ( abs( $new_regular - $old_regular ) > 0.001 || abs( $new_sale - $old_sale ) > 0.001 );",
   "\t\t\tif ( ! $price_initialized || $price_differs ) {",
