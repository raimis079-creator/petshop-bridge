   "",
   "\t/**",
   "\t * S312: refill_due srauto eligibility.",
   "\t *",
   "\t * terminal=true  -> 'skipped' (galutinai, sio ciklo nebetikrinam)",
   "\t * terminal=false -> 'deferred' (kartojam veliau, iki atidejimo lango pabaigos)",
   "\t */",
   "\tpublic static function eligibility_filter( $result, $flow, $flow_class, $email, $context = array() ) {",
   "\t\tif ( 'refill_due' !== $flow ) {",
   "\t\t\treturn $result;",
   "\t\t}",
   "\t\t$product_id = isset( $context['product_id'] ) ? (int) $context['product_id'] : 0;",
   "\t\t$user_id    = isset( $context['user_id'] ) ? (int) $context['user_id'] : 0;",
   "\t\t$since      = isset( $context['last_purchase_date'] ) ? $context['last_purchase_date'] : '';",
   "",
   "\t\t// (a) Klientas jau pirko pakartotinai — laiskas nebeaktualus VISAM ciklui.",
   "\t\tif ( $user_id && $product_id && $since && self::has_repurchased( $user_id, $product_id, $since ) ) {",
   "\t\t\treturn array( 'allowed' => false, 'reason' => 'already_repurchased', 'terminal' => true );",
   "\t\t}",
   "",
   "\t\t// (b) Preke laikinai neparduodama — ATIDEDAM, nes bukle gali pasikeisti.",
   "\t\t$p = $product_id ? wc_get_product( $product_id ) : null;",
   "\t\tif ( ! $p || 'publish' !== get_post_status( $product_id ) || ! $p->is_purchasable() ) {",
   "\t\t\treturn array( 'allowed' => false, 'reason' => 'product_inactive', 'terminal' => false );"
  ],
