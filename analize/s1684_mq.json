   "",
   "\t/**",
   "\t * Cron: kasdienine patikra — fire refill_due event kai arteja predicted_empty_date.",
   "\t */",
   "\tpublic static function check_due() {",
   "\t\tglobal $wpdb;",
   "\t\t$table = self::table_name();",
   "\t\t$advance = self::DUE_ADVANCE_DAYS;",
   "\t\t$target_date = date( 'Y-m-d', time() + $advance * 86400 );",
   "",
   "\t\t// Rasam aktyvius irasys kur predicted_empty_date <= today + advance",
   "\t\t// IR dar nefire'inome refill_due (status = 'active')",
   "\t\t$rows = $wpdb->get_results( $wpdb->prepare(",
   "\t\t\t\"SELECT rt.*, u.user_email",
   "\t\t\t FROM `$table` rt",
   "\t\t\t JOIN `{$wpdb->users}` u ON u.ID = rt.user_id",
   "\t\t\t WHERE rt.status = 'active'",
   "\t\t\t   AND rt.predicted_empty_date <= %s",
   "\t\t\t ORDER BY rt.predicted_empty_date ASC",
   "\t\t\t LIMIT 100\",",
   "\t\t\t$target_date",
   "\t\t) );",
   "",
   "\t\tforeach ( $rows as $row ) {",
   "\t\t\tif ( ! $row->user_email || ! class_exists( 'Petshop_Event_Registry' ) ) {",
   "\t\t\t\tcontinue;",
   "\t\t\t}",
   "\t\t\t$product = wc_get_product( $row->product_id );",
   "\t\t\t$product_name = $product ? $product->get_name() : '(produktas #' . $row->product_id . ')';",
   "",
   "\t\t\tPetshop_Event_Registry::emit( 'refill_due', $row->user_email, array(",
   "\t\t\t\t'pet_id'               => $row->pet_id ? (int) $row->pet_id : 0,",
   "\t\t\t\t'product_id'           => (int) $row->product_id,",
   "\t\t\t\t'product_name'         => $product_name,",
   "\t\t\t\t'predicted_empty_date' => $row->predicted_empty_date,",
   "\t\t\t\t'confidence'           => (float) $row->confidence,",
   "\t\t\t\t'last_order_id'        => (int) $row->last_order_id,",
   "\t\t\t\t'days_since_last_order' => (int) round( ( time() - strtotime( $row->last_purchase_date ) ) / 86400 ),",
   "\t\t\t), array(",
   "\t\t\t\t'event_id' => 'refill_due_' . $row->user_id . '_' . $row->product_id . '_' . $row->predicted_empty_date,",
   "\t\t\t) );",
   "",
   "\t\t\t// --- S312: laiskas VISADA i outbox'a; sprendimas fiksuojamas ten.",
   "\t\t\t// Srauto specifines salygos tikrinamos per petshop_email_eligibility",
   "\t\t\t// filtra (zr. eligibility_filter()), kad praleidimo priezastis butu",
   "\t\t\t// matoma ataskaitose, o ne dingtu tyliame return'e.",
   "\t\t\tif ( class_exists( 'Petshop_Email_Dispatch' ) ) {",
   "\t\t\t\t$pet_name = '';",
   "\t\t\t\tif ( $row->pet_id ) {",
   "\t\t\t\t\t$pet_name = (string) $wpdb->get_var( $wpdb->prepare(",
   "\t\t\t\t\t\t\"SELECT pet_name FROM {$wpdb->prefix}ps_pets WHERE id = %d\", $row->pet_id ) );",
   "\t\t\t\t}",
   "\t\t\t\tPetshop_Email_Dispatch::enqueue(",
   "\t\t\t\t\t'refill_due',",
   "\t\t\t\t\t$row->user_email,",
   "\t\t\t\t\tarray(",
   "\t\t\t\t\t\t'pet_name'     => $pet_name,",
   "\t\t\t\t\t\t'product_id'   => (int) $row->product_id,",
   "\t\t\t\t\t\t'product_name' => $product_name,",
   "\t\t\t\t\t\t'product_url'  => $product ? $product->get_permalink() : home_url( '/' ),",
   "\t\t\t\t\t\t'reorder_url'  => add_query_arg( 'add-to-cart', (int) $row->product_id, wc_get_cart_url() ),",
   "\t\t\t\t\t\t'confidence'   => (float) $row->confidence,",
   "\t\t\t\t\t),",
   "\t\t\t\t\tarray(",
   "\t\t\t\t\t\t'job_key' => 'refill_due:' . $row->user_id . ':' . $row->product_id . ':' . $row->predicted_empty_date,",
   "\t\t\t\t\t\t'user_id' => (int) $row->user_id,",
   "\t\t\t\t\t\t// context — reikalingas eligibility filtrui",
   "\t\t\t\t\t\t'context' => array(",
   "\t\t\t\t\t\t\t'user_id'            => (int) $row->user_id,",
   "\t\t\t\t\t\t\t'product_id'         => (int) $row->product_id,",
   "\t\t\t\t\t\t\t'last_purchase_date' => $row->last_purchase_date,",
   "\t\t\t\t\t\t\t// S323: reikalinga kalibravimo nuorodai (feedback_url)",
   "\t\t\t\t\t\t\t'refill_id'          => (int) $row->id,",
   "\t\t\t\t\t\t\t'cycle'              => (string) $row->predicted_empty_date,",
   "\t\t\t\t\t\t),",
   "\t\t\t\t\t)",
   "\t\t\t\t);",
   "\t\t\t}",
   "",
   "\t\t\t// Pazymim kad fire'inta (status -> notified), kad nekartotume",
