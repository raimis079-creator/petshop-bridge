   "",
   "\t/**",
   "\t * Iraso arba atnaujina refill_tracking irasa.",
   "\t */",
   "\tprivate static function track_purchase( $user_id, $product_id, $order_id, $purchase_date, $product ) {",
   "\t\tglobal $wpdb;",
   "\t\t$table = self::table_name();",
   "",
   "\t\t// Ar jau sekam si produkta siam user'iui?",
   "\t\t$existing = $wpdb->get_row( $wpdb->prepare(",
   "\t\t\t\"SELECT * FROM `$table` WHERE user_id = %d AND product_id = %d\",",
   "\t\t\t$user_id, $product_id",
   "\t\t) );",
   "",
   "\t\tif ( $existing ) {",
   "\t\t\t// KALIBRAVIMAS: skaiciuojam realu intervala",
   "\t\t\t$prev_date = $existing->last_purchase_date;",
   "\t\t\t$real_interval = max( 1, (int) round( ( strtotime( $purchase_date ) - strtotime( $prev_date ) ) / 86400 ) );",
   "\t\t\t$new_count = (int) $existing->purchase_count + 1;",
   "",
   "\t\t\t// Svertinis vidurkis: senas vidurkis * 0.3 + naujas intervalas * 0.7",
   "\t\t\t// (labiau svertam i nauja — adaptyvus)",
   "\t\t\t$old_avg = $existing->avg_interval_days ?: $real_interval;",
   "\t\t\t$new_avg = (int) round( $old_avg * 0.3 + $real_interval * 0.7 );",
   "\t\t\t$new_avg = max( 7, min( 180, $new_avg ) ); // ribos: 7-180 d.",
   "",
   "\t\t\t$confidence = ( $new_count >= 3 ) ? self::CONFIDENCE_CALIBRATED : self::CONFIDENCE_SECOND;",
   "",
   "\t\t\t$predicted = date( 'Y-m-d', strtotime( $purchase_date ) + $new_avg * 86400 );",
   "",
   "\t\t\t$wpdb->update( $table, array(",
   "\t\t\t\t'last_order_id'       => $order_id,",
   "\t\t\t\t'last_purchase_date'  => $purchase_date,",
   "\t\t\t\t'purchase_count'      => $new_count,",
   "\t\t\t\t'avg_interval_days'   => $new_avg,",
   "\t\t\t\t'predicted_empty_date' => $predicted,",
   "\t\t\t\t'confidence'          => $confidence,",
   "\t\t\t\t'status'              => 'active',",
   "\t\t\t\t'updated_at'          => gmdate( 'Y-m-d H:i:s' ),",
   "\t\t\t), array( 'id' => $existing->id ) );",
   "\t\t} else {",
   "\t\t\t// PIRMAS PIRKIMAS: grubus intervalas pagal pakuotes dydi",
   "\t\t\t$interval = self::estimate_interval( $product );",
   "\t\t\t$predicted = date( 'Y-m-d', strtotime( $purchase_date ) + $interval * 86400 );",
   "",
   "\t\t\t$wpdb->insert( $table, array(",
   "\t\t\t\t'user_id'              => $user_id,",
   "\t\t\t\t'product_id'           => $product_id,",
   "\t\t\t\t'pet_id'               => null,",
   "\t\t\t\t'last_order_id'        => $order_id,",
   "\t\t\t\t'last_purchase_date'   => $purchase_date,",
   "\t\t\t\t'purchase_count'       => 1,",
   "\t\t\t\t'avg_interval_days'    => $interval,",
   "\t\t\t\t'predicted_empty_date' => $predicted,",
   "\t\t\t\t'confidence'           => self::CONFIDENCE_FIRST,",
   "\t\t\t\t'status'               => 'active',",
   "\t\t\t\t'created_at'           => gmdate( 'Y-m-d H:i:s' ),",
   "\t\t\t\t'updated_at'           => gmdate( 'Y-m-d H:i:s' ),",
   "\t\t\t), array( '%d','%d','%d','%d','%s','%d','%d','%s','%f','%s','%s','%s' ) );",
   "\t\t}",
   "\t}",
   "",
   "\t/**",
   "\t * Grubus intervalo nustatymas pagal pakuotes dydi (pirmas pirkimas, MVP).",
   "\t */",
   "\tprivate static function estimate_interval( $product ) {",
   "\t\t// Bandom is pa_pakuotes_dydis taksonomijos",
   "\t\t$terms = wp_get_post_terms( $product->get_id(), 'pa_pakuotes_dydis', array( 'fields' => 'names' ) );",
   "\t\tif ( ! is_wp_error( $terms ) && ! empty( $terms ) ) {",
   "\t\t\t$size_str = $terms[0];",
   "\t\t\t$grams = self::parse_weight_grams( $size_str );",
   "\t\t\tif ( $grams > 0 ) {",
   "\t\t\t\tif ( $grams < 500 ) {",
   "\t\t\t\t\treturn self::INTERVAL_SMALL;",
   "\t\t\t\t}",
   "\t\t\t\tif ( $grams <= 3000 ) {",
   "\t\t\t\t\treturn self::INTERVAL_MEDIUM;",
   "\t\t\t\t}",
   "\t\t\t\treturn self::INTERVAL_LARGE;",
   "\t\t\t}",
   "\t\t}",
   "\t\t// Fallback: WC weight"
