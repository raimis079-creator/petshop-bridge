  "render_src": "\tpublic static function render( $flow, $payload, $row = array() ) {\n\t\t$flows = self::flows();\n\t\tif ( ! isset( $flows[ $flow ] ) ) {\n\t\t\treturn array( 'subject' => '', 'html' => '' );\n\t\t}\n\t\t$slug = $flows[ $flow ]['template'];\n\t\t$file = PETSHOP_CORE_DIR . 'templates/emails/' . $slug . '.php';\n\n\t\t$custom = apply_filters( 'petshop_email_template_path', $file, $flow, $slug );\n\t\tif ( ! file_exists( $custom ) ) {\n\t\t\treturn array( 'subject' => '', 'html' => '' );\n\t\t}\n\n\t\t$subject    = '';\n\t\t$flow_class = isset( $row['flow_class'] ) ? $row['flow_class'] : 'service';\n\t\t$recipient  = isset( $row['recipient_email'] ) ? $row['recipient_email'] : '';\n\t\tob_start();\n\t\tinclude $custom; // sablonas gali nustatyti $subject; mato $payload, $flow_class, $recipient\n\t\t$html = ob_get_clean();\n\n\t\tif ( $subject === '' && ! empty( $row['subject'] ) ) {\n\t\t\t$subject = $row['subject'];\n\t\t}\n\t\treturn array( 'subject' => $subject, 'html' => $html );\n\t}\n",
