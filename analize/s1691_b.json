   "331": "function petshop_xml_block_zb_create( $continue_import, $data, $import_id ) {",
   "332": "",
   "333": "    // Saugiklis: tik ZB importas #2",
   "334": "    if ( ! in_array( (int) $import_id, PETSHOP_XML_ZB_IMPORT_IDS, true ) ) {",
   "335": "        return $continue_import;",
   "336": "    }",
   "337": "    // Saugiklis: $data turi buti masyvas",
   "338": "    if ( ! is_array( $data ) ) {",
   "339": "        return $continue_import;",
   "340": "    }",
   "341": "",
   "342": "    $name     = (string) ( $data['name'] ?? '' );",
   "343": "    $category = (string) ( $data['category'] ?? '' );",
   "344": "    $brand    = (string) ( $data['brand'] ?? '' );",
   "345": "    $price    = isset( $data['price'] ) ? (float) str_replace( ',', '.', (string) $data['price'] ) : 0.0;",
   "346": "    $qty      = isset( $data['qty'] )   ? (int) $data['qty'] : 0;",
   "347": "",
   "348": "    // Fail-safe: jei tuscia esmine info -> leisti (neblokuojam aklai)",
   "349": "    if ( $name === '' && $category === '' ) {",
   "350": "        return $continue_import;"
  },
