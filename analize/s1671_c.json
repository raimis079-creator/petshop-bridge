 "GO": {
  "v": "S1671 c",
  "av_limit": [
   "<?php",
   "/**",
   " * Petshop AV Limit v1.0 (S474) — pardavimo riba iš KELIŲ šaltinių.",
   " *",
   " * TREČIAS SLUOKSNIS (REGISTRAS §17.7, §19).",
   " *",
   " * PROBLEMA: WooCommerce riboja pagal `_stock` — VIENO šaltinio kiekį.",
   " * Prekė gali turėti AV 2 ir VF 796, o klientas negalės nupirkti 3, nors realiai yra 798.",
   " *",
   " * TAISYKLĖ (Raimis §17.4):",
   " *   „Klientui likučio išvis nereikia rodyti, principas arba prekė yra arba nėra,",
   " *    o kai jis renkasi, jis negali paimti minusinio likučio.\"",
   " *",
   " * KĄ DARO:",
   " *   - bendra riba = AV + tiekėjas (tik toms, kurios turi ABU)",
   " *   - klientui skaičius NERODOMAS (tik „yra\" / „nėra\")",
   " *   - GRYNAI AV prekėms nieko nekeičia — jų `_stock` ir taip teisingas",
   " *",
   " * KO NEDARO:",
   " *   - NEKEIČIA `_stock` reikšmės (sync ją perrašo)",
   " *   - NEKURIA savo rezervacijų — WooCommerce jau turi (§18.6)",
   " *",
   " * SAUGIKLIS: veikia TIK toms prekėms, kurios turi `_own_stock_qty` IR tiekėjo",
   " * šaltinį. Visoms kitoms — WooCommerce elgiasi kaip anksčiau.",
   " */",
   "if ( ! defined( 'ABSPATH' ) ) { exit; }",
   "",
   "class Petshop_AV_Limit {",
   "",
   "\tpublic static function init() {",
   "\t\t// bendra riba",
   "\t\tadd_filter( 'woocommerce_product_get_stock_quantity', [ __CLASS__, 'stock_qty' ], 20, 2 );",
   "\t\tadd_filter( 'woocommerce_product_variation_get_stock_quantity', [ __CLASS__, 'stock_qty' ], 20, 2 );",
   "\t\t// „yra / nėra\"",
   "\t\tadd_filter( 'woocommerce_product_get_stock_status', [ __CLASS__, 'stock_status' ], 20, 2 );",
   "\t\t// klientui skaičius NERODOMAS",
   "\t\tadd_filter( 'woocommerce_get_availability_text', [ __CLASS__, 'availability_text' ], 20, 2 );",
   "\t\tadd_filter( 'woocommerce_get_stock_html', [ __CLASS__, 'stock_html' ], 20, 2 );",
   "\t}",
   "",
   "\t/** Ar šiai prekei taikoma dviejų šaltinių logika. */",
   "\tprotected static function taikoma( $product_id ) {",
   "\t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return false; }",
   "\t\t$av = Petshop_AV_Stock::qty( $product_id );",
   "\t\tif ( null === $av ) { return false; }               // AV neturi — nieko nekeičiam",
   "\t\tif ( ! class_exists( 'Petshop_Fulfillment_Source' ) ) { return false; }",
   "\t\t$s = Petshop_Fulfillment_Source::resolve( (int) $product_id )['source'];",
   "\t\treturn ( 'legacy' !== $s );                          // grynai AV — nieko nekeičiam",
   "\t}",
   "",
   "\t/** Bendras kiekis = AV + tiekėjas. */",
   "\tpublic static function stock_qty( $qty, $product ) {",
   "\t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $qty; }",
   "\t\t$pid = $product->get_id();",
   "\t\tif ( ! self::taikoma( $pid ) ) { return $qty; }",
   "\t\t$av = (int) Petshop_AV_Stock::qty( $pid );",
   "\t\t$tiek = (int) $qty;                                  // WC `_stock` = tiekėjo kiekis",
   "\t\treturn $av + max( 0, $tiek );",
   "\t}",
   "",
   "\t/** „yra\", jei bent vienas šaltinis turi. */",
   "\tpublic static function stock_status( $status, $product ) {",
   "\t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $status; }",
   "\t\t$pid = $product->get_id();",
   "\t\tif ( ! self::taikoma( $pid ) ) { return $status; }",
   "\t\t$av = (int) Petshop_AV_Stock::qty( $pid );",
   "\t\tif ( $av > 0 ) { return 'instock'; }",
   "\t\treturn $status;",
   "\t}",
   "",
   "\t/** Klientui — be skaičiaus. */",
   "\tpublic static function availability_text( $text, $product ) {",
   "\t\tif ( ! is_a( $product, 'WC_Product' ) ) { return $text; }",
   "\t\tif ( is_admin() && ! wp_doing_ajax() ) { return $text; }",
   "\t\tif ( ! $product->is_in_stock() ) { return $text; }",
   "\t\t// „Turime (127)\" → „Turime\"",
   "\t\treturn preg_replace( '/\\s*\\(\\s*\\d+[^)]*\\)\\s*$/u', '', (string) $text );",
   "\t}",
   "",
   "\t/** Tas pats HTML lygmenyje — jei tema rodo savo variantą. */",
   "\tpublic static function stock_html( $html, $product ) {",
   "\t\tif ( is_admin() && ! wp_doing_ajax() ) { return $html; }",
   "\t\tif ( ! is_a( $product, 'WC_Product' ) || ! $product->is_in_stock() ) { return $html; }",
   "\t\treturn preg_replace( '/\\s*\\(\\s*\\d+[^)]*\\)/u', '', (string) $html );",
   "\t}",
   "}",
   "Petshop_AV_Limit::init();",
   ""
  ],
