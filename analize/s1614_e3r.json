    "\tprotected static function siuntos_klaida( $nr, $ids ) {",
    "\t\tforeach ( (array) $ids as $id ) {",
    "\t\t\t$o = wc_get_order( $id );",
    "\t\t\tif ( ! $o || $o->get_order_number() !== $nr ) { continue; }",
    "\t\t\t$d = json_decode( (string) $o->get_meta( 'venipak_shipping_order_data' ), true );",
    "\t\t\tif ( ! empty( $d['error_message'] ) ) { return mb_substr( $d['error_message'], 0, 90 ); }",
    "\t\t\tif ( 'venipak_pastomatas' === self::vezejas( $o ) && ! $o->get_meta( 'venipak_pickup_point' ) ) {",
    "\t\t\t\treturn 'nenurodytas paštomatas';",
    "\t\t\t}",
    "\t\t\tbreak;",
    "\t\t}",
    "\t\treturn '— nėra';",
    "\t}"
   ]
