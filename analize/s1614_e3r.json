  "desk_siuntos_kodas": {
   "f": "petshop-desk.php:1159-1175",
   "src": [
    "\tpublic static function siuntos_kodas( $o ) {",
    "\t\t$d = $o->get_meta( 'venipak_shipping_order_data' );",
    "\t\t// Pluginas raktą saugo JSON eilute (H202/H222) — maybe_unserialize jo NEatkoduoja.",
    "\t\tif ( is_string( $d ) && $d ) {",
    "\t\t\t$j = json_decode( $d, true );",
    "\t\t\t$d = null !== $j ? $j : maybe_unserialize( $d );",
    "\t\t}",
    "\t\tif ( is_array( $d ) && ! empty( $d['pack_numbers'] ) ) {",
    "\t\t\t$p = (array) $d['pack_numbers'];",
    "\t\t\treturn array( implode( ', ', $p ), count( $p ) );",
    "\t\t}",
    "\t\tforeach ( array( '_lpexpress_tracking_number', 'lpexpress_tracking_number', '_lp_tracking' ) as $k ) {",
    "\t\t\t$v = $o->get_meta( $k );",
    "\t\t\tif ( $v ) { return array( is_array( $v ) ? implode( ', ', $v ) : $v, 1 ); }",
    "\t\t}",
    "\t\treturn array( '', 0 );",
    "\t}"
   ]
  },
  "desk_siuntu_bukle": {
   "f": "petshop-desk.php:1921-1938",
   "src": [
    "\tprotected static function siuntu_bukle( $ids ) {",
    "\t\t$eil = array(); $ok = 0;",
    "\t\tforeach ( (array) $ids as $id ) {",
    "\t\t\t$o = wc_get_order( $id );",
    "\t\t\tif ( ! $o ) { continue; }",
    "\t\t\tlist( $kodas, $pak ) = self::siuntos_kodas( $o );",
    "\t\t\tif ( $kodas ) { $ok++; }",
    "\t\t\t$eil[] = array(",
    "\t\t\t\t'nr'    => $o->get_order_number(),",
    "\t\t\t\t'kl'    => trim( $o->get_billing_first_name() . ' ' . $o->get_billing_last_name() ),",
    "\t\t\t\t'vieta' => $o->get_meta( 'venipak_pickup_point' ),",
    "\t\t\t\t'vez'   => self::vezejo_vardas( $o ),",
    "\t\t\t\t'kodas' => $kodas,",
    "\t\t\t\t'pak'   => $pak,",
    "\t\t\t);",
    "\t\t}",
    "\t\treturn array( $eil, $ok, count( (array) $ids ) );",
    "\t}"
   ]
  },
