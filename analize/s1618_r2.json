  "find_src": "function venipak_find_pickup_by_id($point_id) {\n\n  if (!is_numeric($point_id)) {\n\n    return false;\n\n  }\n\n\n\n  foreach (venipak_fetch_pickups() as $point) {\n\n    if ($point['id'] == $point_id) {\n\n      return $point;\n\n    }\n\n  }\n\n  return false;\n\n}\n",
  "src_venipak_fetch_pickups": "function venipak_fetch_pickups($country = null) {\n\n  static $collection = null;\n\n\n\n  if ($collection === null) {\n\n    $collection = _venipak_read_pickups();\n\n  }\n\n\n\n  if ($country === null) {\n\n    return $collection;\n\n  }\n\n\n\n  $result = [];\n\n  foreach ($collection as $point) {\n\n    if ($point['country'] === $country) {\n\n      $result[] = $point;\n\n    }\n\n  }\n\n  return $result;\n\n}\n",
