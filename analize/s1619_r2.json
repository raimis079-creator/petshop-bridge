  "av_reduce_mazinti": {
   "nuo": 53,
   "iki": 103,
   "kodas": [
    "\tpublic static function mazinti( $order_id ) {",
    "\t\t$order = is_numeric( $order_id ) ? wc_get_order( $order_id ) : $order_id;",
    "\t\tif ( ! $order ) { return; }",
    "\t\tif ( $order->get_meta( '_ps_av_reduced' ) ) { return; }          // idempotencija",
    "\t\tif ( ! class_exists( 'Petshop_AV_Stock' ) ) { return; }",
    "",
    "\t\t$padaryta = []; $klaidos = [];",
    "\t\tforeach ( $order->get_items() as $item_id => $item ) {",
    "\t\t\tif ( 'av' !== $item->get_meta( '_ps_source' ) ) { continue; }",
    "\t\t\t$pid = (int) $item->get_product_id();",
    "\t\t\t$qty = max( 1, (int) $item->get_quantity() );",
    "",
    "\t\t\t// GRYNAI AV prekės likutis gyvena `_stock`, ne `_own_stock_qty` —",
    "\t\t\t// joms WC nurašymo NESTABDOM... bet mes jį jau sustabdėm filtru.",
    "\t\t\t// Todėl čia nurašom pagal tai, kur likutis realiai yra.",
    "\t\t\t$av = Petshop_AV_Stock::qty( $pid );",
    "\t\t\tif ( null === $av ) {",
    "\t\t\t\t// grynai AV: mažinam WooCommerce `_stock` rankomis",
    "\t\t\t\t$p = wc_get_product( $pid );",
    "\t\t\t\tif ( $p && $p->managing_stock() ) {",
    "\t\t\t\t\t$dabar = (int) get_post_meta( $pid, '_stock', true );",
    "\t\t\t\t\t$naujas = max( 0, $dabar - $qty );",
    "\t\t\t\t\t$p->set_stock_quantity( $naujas );",
    "\t\t\t\t\tif ( 0 === $naujas ) { $p->set_stock_status( 'outofstock' ); }",
    "\t\t\t\t\t$p->save();",
    "\t\t\t\t\twc_delete_product_transients( $pid );",
    "\t\t\t\t\t$padaryta[] = \"#{$pid} grynai AV {$dabar} -> {$naujas}\";",
    "\t\t\t\t\t$item->update_meta_data( '_ps_av_reduced_qty', $qty );",
    "\t\t\t\t\t$item->save();",
    "\t\t\t\t}",
    "\t\t\t\tcontinue;",
    "\t\t\t}",
    "",
    "\t\t\t$rez = Petshop_AV_Stock::decrease( $pid, $qty, 'užsakymas #' . $order->get_order_number() );",
    "\t\t\tif ( is_wp_error( $rez ) ) {",
    "\t\t\t\t$klaidos[] = \"#{$pid}: \" . $rez->get_error_message();",
    "\t\t\t} else {",
    "\t\t\t\t$padaryta[] = \"#{$pid} AV {$av} -> {$rez}\";",
    "\t\t\t\t$item->update_meta_data( '_ps_av_reduced_qty', $qty );",
    "\t\t\t\t$item->save();"
   ]
  },
