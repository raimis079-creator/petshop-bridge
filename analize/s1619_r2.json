    "\t\t\tif ( 'av' !== self::eilutes_saltinis( $it ) ) { continue; }",
    "\t\t\t// jau nurašyta iš AV — prekė paimta, klausimo nėra",
    "\t\t\tif ( $it->get_meta( '_reduced_stock' ) || $it->get_meta( '_ps_av_reduced' ) ) { continue; }",
