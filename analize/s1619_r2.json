    "\t\tif ( $order->get_meta( '_ps_withdrawal' ) ) { return 'Klientas atsisako sutarties'; }",
    "",
    "\t\tif ( $order->get_meta( '_ps_sla_velavimas' ) ) { return 'Tiekėjas vėluoja — perduota prieš 24+ val.'; }",
    "",
    "\t\tif ( ! $order->is_paid() ) { return ''; }",
