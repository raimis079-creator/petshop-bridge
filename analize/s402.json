  "pavyzdys_order_paid": "<?php\n/**\n * Sablonas: order_paid — uzsakymas apmoketas.\n * Gauna: $payload (order_number, total, currency, name, order_url)\n * Nustato: $subject\n * TZ §4.4.1: \"jus\" mazaja, siuntejas Petshop.lt, fallback be vardo.\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\n$order_no  = isset( $payload['order_number'] ) ? $payload['order_number'] : '';\n$total     = isset( $payload['total'] ) ? $payload['total'] : '';\n$order_url = isset( $payload['order_url'] ) ? $payload['order_url'] : wc_get_account_endpoint_url( 'orders' );\n$name      = isset( $payload['name'] ) ? trim( $payload['name'] ) : '';\n\n$subject = $order_no ? sprintf( 'Užsakymas %s priimtas', $order_no ) : 'Jūsų užsakymas priimtas';\n\n$greet = $name !== '' ? sprintf( 'Sveiki, %s,', esc_html( $name ) ) : 'Sveiki,';\n?>\n<!DOCTYPE html>\n<html lang=\"lt\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title><?php echo esc_html( $subject ); ?></title></head>\n<body style=\"margin:0;padding:0;background:#F3EFE5;font-family:Arial,Helvetica,sans-serif;color:#1F2A24;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3EFE5;padding:24px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#FFFFFF;border-radius:12px;padding:32px;\">\n  <tr><td style=\"font-size:21px;font-weight:700;padding-bottom:8px;\"><?php echo esc_html( $subject ); ?></td></tr>\n  <tr><td style=\"font-size:15px;line-height:1.65;padding-bottom:18px;\">\n    <?php echo $greet; ?> dėkojame už užsakymą. Gavome jūsų apmokėjimą<?php echo $total ? ' (' . esc_html( $total ) . ')' : ''; ?> ir jau ruošiame siuntą.\n    Kai ji iškeliaus, atsiųsime sekimo numerį.\n  </td></tr>\n  <tr><td style=\"padding-bottom:26px;\">\n    <a href=\"<?php echo esc_url( $order_url ); ?>\" style=\"background:#2d6a35;color:#FFFFFF;text-decorat