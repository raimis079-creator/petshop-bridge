    "\tpublic static function uzbaigimo_sargas( $order ) {",
    "\t\tif ( ! $order instanceof WC_Order || ! $order->get_id() ) { return; }",
    "\t\t$ch = $order->get_changes();",
    "\t\tif ( empty( $ch['status'] ) || 'completed' !== $ch['status'] ) { return; }",
    "\t\tif ( $order->get_meta( '_ps_uzbaigti_be_siuntu' ) ) { return; }",
    "",
    "\t\t$tiketasi = (int) $order->get_meta( '_ps_shipments' );",
    "\t\tif ( $tiketasi <= 1 ) { return; }",
    "",
    "\t\t$turima = self::registruota_grupiu( $order );",
    "\t\tif ( $turima >= $tiketasi ) { return; }",
    "",
    "\t\tglobal $wpdb;",
    "\t\t$db_status = (string) $wpdb->get_var( $wpdb->prepare(",
    "\t\t\t\"SELECT status FROM {$wpdb->prefix}wc_orders WHERE id=%d\", $order->get_id() ) );",
    "\t\t$orig = $db_status ? preg_replace( '/^wc-/', '', $db_status ) : 'processing';",
    "\t\tif ( 'completed' === $orig ) { return; }",
    "",
    "\t\t$order->set_status( $orig, '', false );",
    "\t\t$order->add_order_note( sprintf(",
    "\t\t\t'Užbaigimas sustabdytas: registruotos %d iš %d siuntų. Užbaigti galima, kai visos siuntos registruotos (apėjimas ypatingam atvejui: meta _ps_uzbaigti_be_siuntu = 1).',",
    "\t\t\t$turima, $tiketasi ), false, true );",
    "\t}"
   ]
