  "gen_kodas": [
   "332: function petshop_generate_invoice_pdf( $order_id ) {",
   "333:     $wc_order = wc_get_order( $order_id );",
   "334:     if ( ! $wc_order ) return false;",
   "335: ",
   "336:     $countries      = WC()->countries ? WC()->countries->get_countries() : array();",
   "337:     $b_country      = $wc_order->get_billing_country();",
   "338:     $b_country_name = isset( $countries[ $b_country ] ) ? $countries[ $b_country ] : $b_country;",
   "339: ",
   "340:     $skip_states = array( 'pasirinkite rajona', 'select a region', 'select an option' );",
   "341:     $b_state     = $wc_order->get_billing_state();",
   "342:     $b_state_val = ( $b_state && ! in_array( mb_strtolower( $b_state ), $skip_states ) ) ? $b_state : '';",
   "343: ",
   "344:     $city_post = trim( $wc_order->get_billing_city() . ( $wc_order->get_billing_postcode() ? ', ' . $wc_order->get_billing_postcode() : '' ) );",
   "345: ",
   "346:     $billing_lines = array_values( array_filter( array(",
   "347:         $wc_order->get_billing_address_1(),",
   "348:         $wc_order->get_billing_address_2(),",
   "349:         $city_post,",
   "350:         $b_state_val,",
   "351:         $b_country_name,",
   "352:     ) ) );",
   "353: ",
   "354:     $order = array(",
   "355:         'id'            => $order_id,",
   "356:         'orderNumber'   => $wc_order->get_order_number(),",
   "357:         'documentDate'  => date_i18n( 'Y-m-d' ),",
   "358:         'date'          => $wc_order->get_date_created()",
   "359:                             ? $wc_order->get_date_created()->format( 'Y-m-d' )",
   "360:                             : date( 'Y-m-d' ),",
   "361:         'paymentMethod' => $wc_order->get_payment_method_title(),",
   "362:         'billing'       => array(",
   "363:             'name'    => trim( $wc_order->get_billing_first_name() . ' ' . $wc_order->get_billing_last_name() ),",
   "364:             'address' => $billing_lines,",
   "365:             'phone'   => $wc_order->get_billing_phone(),",
   "366:             'email'   => $wc_order->get_billing_email(),",
   "367:         ),",
   "368:         'shipping'      => array( 'name' => '', 'address' => array() ),",
   "369:     );",
   "370: ",
   "371:     $logo_url  = '';",
   "372:     $logo_path = '';",
   "373:     $flatsome_logo_id = get_theme_mod( 'site_logo' );",
   "374:     if ( $flatsome_logo_id ) {",
   "375:         $logo_url  = wp_get_attachment_image_url( $flatsome_logo_id, 'full' );",
   "376:         $logo_path = get_attached_file( $flatsome_logo_id );",
   "377:     }",
   "378: ",
   "379:     $shop     = array( 'logo' => $logo_url, 'logo_path' => $logo_path, 'name' => get_bloginfo( 'name' ) );",
   "380:     $settings = array( 'displayPriceInProductDetailsTable' => true );",
   "381:     $document = array();",
   "382:     $template = 'invoice';",
   "383:     $type     = 'pdf';",
   "384:     $items    = array();",
   "385:     $totals   = array();",
   "386: ",
   "387:     $template_file = get_stylesheet_directory() . '/woocommerce-delivery-notes/base.php';",
   "388:     if ( ! file_exists( $template_file ) ) return false;",
   "389: ",
   "390:     ob_start();",
   "391:     include $template_file;",
   "392:     $body_html = ob_get_clean();",
   "393: ",
   "394:     $full_html = '<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><style>@page{size:A4;margin:12mm 14mm;}body{margin:0;padding:0;}</style></head><body>' . $body_html . '</body></html>';",
   "395: ",
   "396:     if ( ! class_exists( 'Dompdf\\Dompdf' ) ) return false;",
   "397: ",
   "398:     $upload_dir = wp_upload_dir();",
   "399:     $pdf_dir    = trailingslashit( $upload_dir['basedir'] ) . 'wcdn/invoice/';",
   "400:     wp_mkdir_p( $pdf_dir );",
   "401:     // Svarus lietuviskas failo pavadinimas pagal dokumento numeri (base.php nustato $invoice_number ir $doc_title virsuje).",
