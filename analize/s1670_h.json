   "188 \t/** Suderina nesutampančias prekes. */",
   "189 \tpublic static function suderinti( $limit = 500 ) {",
   "190 \t\tglobal $wpdb;",
   "191 \t\t$p  = $wpdb->prefix;",
   "192 \t\t$lk = $p . 'wc_product_meta_lookup';",
