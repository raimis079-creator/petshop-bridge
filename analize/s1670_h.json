   "194 \t\t\t\"SELECT DISTINCT l.product_id FROM {$lk} l",
   "195 \t\t\t INNER JOIN {$p}posts po ON po.ID = l.product_id AND po.post_status = 'publish'",
   "196 \t\t\t LEFT JOIN {$p}postmeta mp ON mp.post_id = l.product_id AND mp.meta_key = '_price'",
   "197 \t\t\t LEFT JOIN {$p}postmeta ms ON ms.post_id = l.product_id AND ms.meta_key = '_stock'",
   "198 \t\t\t LEFT JOIN {$p}postmeta mt ON mt.post_id = l.product_id AND mt.meta_key = '_stock_status'",
   "199 \t\t\t WHERE ABS( l.min_price - CAST( NULLIF(mp.meta_value,'') AS DECIMAL(10,4) ) ) > 0.005",
   "200 \t\t\t    OR COALESCE(l.stock_quantity,-999) <> COALESCE(CAST(NULLIF(ms.meta_value,'') AS SIGNED),-999)",
   "201 \t\t\t    OR l.stock_status <> mt.meta_value",
   "202 \t\t\t LIMIT %d\", (int) $limit ) );",
