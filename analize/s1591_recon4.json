  "vf_should_import": [
   "\tpublic function vf_should_import( string $brand, string $sku, string $category, string $description, string $name, float $personal_price ): array {",
   "",
   "\t\t$brand_trimmed = trim( $brand );",
   "\t\t$cat_lower = mb_strtolower( $category, 'UTF-8' );",
   "",
   "\t\t// 1. Blocked brands",
   "\t\tif ( in_array( $brand_trimmed, $this->blocked_now_brands, true ) ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'brand_blocked_now' ];",
   "\t\t}",
   "\t\tif ( in_array( $brand_trimmed, $this->review_later_brands, true ) ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'brand_review_later' ];",
   "\t\t}",
   "",
   "\t\t// 2. Brand + description empty",
   "\t\t$desc_decoded = trim( base64_decode( $description ) );",
   "\t\tif ( empty( $brand_trimmed ) && empty( $desc_decoded ) ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'brand_missing_no_description' ];",
   "\t\t}",
   "",
   "\t\t// 3. Excluded SKU",
   "\t\tif ( in_array( $sku, $this->excluded_skus, true ) ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'excluded_sku' ];",
   "\t\t}",
   "",
   "\t\t// 4. Medication keywords",
   "\t\tforeach ( $this->medication_keywords as $kw ) {",
   "\t\t\tif ( mb_strpos( $cat_lower, $kw ) !== false ) {",
   "\t\t\t\treturn [ 'import' => false, 'reason' => 'medication_blocked' ];",
   "\t\t\t}",
   "\t\t}",
   "",
   "\t\t// 5. Paukš/žirg blocked",
   "\t\tif ( mb_strpos( $cat_lower, 'paukš' ) !== false",
   "\t\t     || mb_strpos( $cat_lower, 'papūg' ) !== false",
   "\t\t     || mb_strpos( $cat_lower, 'lesalas' ) !== false ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'pauks_blocked' ];",
   "\t\t}",
   "\t\tif ( mb_strpos( $cat_lower, 'žirg' ) !== false ) {",
   "\t\t\treturn [ 'import' => false, 'reason' => 'zirg_blocked' ];",
   "\t\t}",
   "",
   "\t\t// 6. Determine group",
   "\t\t$group = null;",
   "\t\tforeach ( $this->category_groups_map as $g => $keywords ) {",
   "\t\t\tforeach ( $keywords as $kw ) {",
   "\t\t\t\tif ( mb_strpos( $cat_lower, $kw ) !== false ) {",
   "\t\t\t\t\t$group = $g;",
   "\t\t\t\t\tbreak 2;",
   "\t\t\t\t}",
   "\t\t\t}",
   "\t\t}",
   "\t\tif ( ! $group ) $group = 'aksesuarai';",
   "",
   "\t\t// 7. Per-group price rules",
   "\t\t$price = (float) $personal_price;",
   "\t\tswitch ( $group ) {",
   "\t\t\tcase 'sausas':",
   "\t\t\tcase 'konservai':",
   "\t\t\tcase 'vitaminai':",
   "\t\t\t\treturn [ 'import' => true, 'group' => $group ];",
   "",
   "\t\t\tcase 'skanestai':",
   "\t\t\t\tif ( $brand_trimmed === 'CHURU' ) return [ 'import' => true, 'group' => 'skanestai' ];",
   "\t\t\t\tif ( $price >= 2.0 ) return [ 'import' => true, 'group' => 'skanestai' ];",
   "\t\t\t\treturn [ 'import' => false, 'reason' => 'skanestai_below_2eur' ];",
   "",
   "\t\t\tcase 'kraikai':",
   "\t\t\t\tif ( in_array( $brand_trimmed, [ \"CAT'S_BEST\", \"JOE'S_CAT\" ], true ) ) return [ 'import' => true, 'group' => 'kraikai' ];",
   "\t\t\t\tif ( $brand_trimmed === 'EXPERTUS' && mb_stripos( $name, 'tofu' ) !== false ) return [ 'import' => true, 'group' => 'kraikai' ];",
   "\t\t\t\tif ( $price >= 5.0 ) return [ 'import' => true, 'group' => 'kraikai' ];",
   "\t\t\t\treturn [ 'import' => false, 'reason' => 'kraikai_below_5eur' ];",
   "",
   "\t\t\tcase 'higiena':",
   "\t\t\t\tif ( $brand_trimmed === 'VETOCANIS' ) return [ 'import' => true, 'group' => 'higiena' ];",
   "\t\t\t\tif ( $price >= 2.0 ) return [ 'import' => true, 'group' => 'higiena' ];",
   "\t\t\t\treturn [ 'import' => false, 'reason' => 'higiena_below_2eur' ];",
   "",
   "\t\t\tcase 'aksesuarai':",
   "\t\t\tdefault:",
   "\t\t\t\tif ( $price >= 6.0 ) return [ 'import' => true, 'group' => 'aksesuarai' ];",
   "\t\t\t\treturn [ 'import' => false, 'reason' => 'aksesuarai_below_6eur' ];",
   "\t\t}",
   "\t}",
   "",
   "\tpublic function get_vf_category_map(): array  { return $this->vf_category_map; }",
   "\tpublic function get_brand_normalize(): array  { return $this->brand_normalize; }",
   "}"
