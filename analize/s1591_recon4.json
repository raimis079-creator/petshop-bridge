  "initial_import": [
   "function petshop_xml_vf_initial_import( int $post_id, bool $is_update ): void {",
   "",
   "\t// 1. Surinkti VF meta laukus (WP All Import jau idejo per template)",
   "\t$vf_brand_raw   = (string) get_post_meta( $post_id, '_vf_brand_raw', true );",
   "\t$vf_sku         = (string) get_post_meta( $post_id, '_vf_supplier_sku', true );",
   "\t$vf_barcode     = (string) get_post_meta( $post_id, '_vf_barcode', true );",
   "\t$vf_cost_xml    = (float)  get_post_meta( $post_id, '_vf_cost_xml', true );",
   "\t$vf_personal_xml = (float) get_post_meta( $post_id, '_vf_personal_xml', true );",
   "\t$vf_qty         = (int)    get_post_meta( $post_id, '_vf_qty', true );",
   "\t$vf_category    = (string) get_post_meta( $post_id, '_vf_category_raw', true );",
   "\t$vf_desc_base64 = (string) get_post_meta( $post_id, '_vf_description_base64', true );",
   "",
   "\t$post = get_post( $post_id );",
   "\t$product_name = $post ? $post->post_title : '';",
   "",
   "\t// 2. Filter check — vf_should_import",
   "\t$rules = new Petshop_Import_Rules_VF();",
   "\t$decision = $rules->vf_should_import(",
   "\t\t$vf_brand_raw,",
   "\t\t$vf_sku,",
   "\t\t$vf_category,",
   "\t\t$vf_desc_base64,",
   "\t\t$product_name,",
   "\t\t$vf_personal_xml > 0 ? $vf_personal_xml : $vf_cost_xml",
   "\t);",
   "",
   "\tif ( ! $decision['import'] ) {",
   "\t\t// Preke neturetu buti importuojama — i trash (tik jei nauja)",
   "\t\tif ( ! $is_update ) {",
   "\t\t\tpetshop_xml_log_structured( [",
   "\t\t\t\t'action'    => 'VF-REJECTED-NEW',",
   "\t\t\t\t'post_id'   => $post_id,",
   "\t\t\t\t'sku'       => $vf_sku,",
   "\t\t\t\t'brand'     => $vf_brand_raw,",
   "\t\t\t\t'reason'    => $decision['reason'],",
   "\t\t\t] );",
   "\t\t\tupdate_post_meta( $post_id, '_petshop_review_reason', 'vf_' . $decision['reason'] );",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', $decision['reason'] );",
   "\t\t\twp_trash_post( $post_id );",
   "\t\t} else {",
   "\t\t\t// Esama preke — paliekam, bet pazymim",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', $decision['reason'] );",
   "\t\t\tpetshop_xml_log( \"VF REJECT (existing) post {$post_id} | reason={$decision['reason']}\" );",
   "\t\t}",
   "\t\treturn;",
   "\t}",
   "",
   "\t// 3. Category mapping",
   "\t$wc_slug = $rules->get_wc_category_slug( $vf_category );",
   "\tif ( ! $wc_slug ) {",
   "\t\t// Nera mapping'o -> skip (i trash jei nauja)",
   "\t\tif ( ! $is_update ) {",
   "\t\t\tpetshop_xml_log_structured( [",
   "\t\t\t\t'action'    => 'VF-NO-MAPPING-NEW',",
   "\t\t\t\t'post_id'   => $post_id,",
   "\t\t\t\t'sku'       => $vf_sku,",
   "\t\t\t\t'vf_category' => $vf_category,",
   "\t\t\t] );",
   "\t\t\tupdate_post_meta( $post_id, '_petshop_review_reason', 'vf_no_category_mapping' );",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', 'no_category_mapping' );",
   "\t\t\twp_trash_post( $post_id );",
   "\t\t} else {",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', 'no_category_mapping' );",
   "\t\t\tpetshop_xml_log( \"VF NO MAPPING (existing) post {$post_id} | vf_cat={$vf_category}\" );",
   "\t\t}",
   "\t\treturn;",
   "\t}",
   "",
   "\t// 4. Brand normalize",
   "\t$brand_normalized = $rules->normalize_brand( $vf_brand_raw );",
   "",
   "\t// 5. EAN/SKU lookup — ar preke jau egzistuoja?",
   "\t$ean_db = new Petshop_EAN_Lookup();",
   "\t$matched_id = null;",
   "\t$match_type = null;",
   "",
   "\t// EAN match (per barcode)",
   "\tif ( $vf_barcode ) {",
   "\t\t$matched_id = $ean_db->find_by_ean( $vf_barcode, $post_id );",
   "\t\tif ( $matched_id ) $match_type = 'ean';",
   "\t}",
   "\t// SKU match (jei nera EAN match)",
   "\tif ( ! $matched_id && $vf_sku ) {",
   "\t\t$matched_id = petshop_xml_vf_find_by_sku( $vf_sku, $post_id );",
   "\t\tif ( $matched_id ) $match_type = 'sku';",
   "\t}",
   "",
   "\t// =====================================================================",
   "\t// SCENARIJUS A: VF preke atitinka egzistuojanti WC produkta",
   "\t// =====================================================================",
   "\tif ( $matched_id ) {",
   "\t\tpetshop_xml_vf_attach_to_existing(",
   "\t\t\t$matched_id, $post_id, $match_type,",
   "\t\t\t$vf_brand_raw, $brand_normalized, $vf_sku, $vf_barcode,",
   "\t\t\t$vf_cost_xml, $vf_personal_xml, $vf_qty, $wc_slug",
   "\t\t);",
   "\t\treturn;",
   "\t}",
   "",
   "\t// =====================================================================",
   "\t// SCENARIJUS B: Nauja VF preke",
   "\t// =====================================================================",
   "\tpetshop_xml_vf_create_new(",
   "\t\t$post_id, $is_update,",
   "\t\t$vf_brand_raw, $brand_normalized, $vf_sku, $vf_barcode,",
   "\t\t$vf_cost_xml, $vf_personal_xml, $vf_qty, $wc_slug, $vf_category",
   "\t);",
   "}",
   "",
   "/**",
   " * SCENARIJUS A: VF preke atitinka egzistuojanti WC produkta.",
   " *",
   " * GALUTINE TAISYKLE (savininko sprendimas 2026-06-05):",
   " *   Egzistuojanti preke = LEGACY arba OWN arba ZB arba BET KOKIA jau katalogo preke.",
   " *   Nesvarbu, kuris tiekejas — JEI preke jau yra WooCommerce, VF kainos nekeicia.",
   " *",
   " * Veiksmai:",
   " *   1. Egzistuojantis produktas ($matched_id):",
   " *      - NEKEICIAM: _price, _regular_price, _sale_price",
   " *      - NEKEICIAM: post_title, post_name (slug)"
  ]
 }
