  "resolver": "class Petshop_Feeding_Package_Resolver {\n\tpublic static function resolve( $raw ) {\n\t\tif ( ! is_string( $raw ) || trim( $raw ) === '' ) {\n\t\t\treturn self::out( 'unresolved', null, $raw, null );\n\t\t}\n\t\t$s = trim( $raw );\n\t\t$s = str_replace( array( \"\\xc3\\x97\", '×', 'X' ), 'x', $s );\n\t\t$s = strtolower( $s );\n\t\t$s = str_replace( ',', '.', $s );\n\t\t$s = preg_replace( '/\\s+/', ' ', $s );\n\n\t\t// multipack: COUNT x NUMBER UNIT\n\t\tif ( preg_match( '/^(\\d+)\\s*x\\s*(\\d+(?:\\.\\d+)?)\\s*(kg|g)$/', $s, $m ) ) {\n\t\t\t$g = self::g( (float) $m[2], $m[3] ); $c = (int) $m[1];\n\t\t\treturn ( $c > 0 && $g > 0 )\n\t\t\t\t? self::out( 'resolved', (int) round( $c * $g ), $raw, 'multipack' )\n\t\t\t\t: self::out( 'unresolved', null, $raw, null );\n\t\t}\n\t\t// bonus_pack: NUMBER + NUMBER UNIT\n\t\tif ( preg_match( '/^(\\d+(?:\\.\\d+)?)\\s*\\+\\s*(\\d+(?:\\.\\d+)?)\\s*(kg|g)$/', $s, $m ) ) {\n\t\t\t$a = self::g( (float) $m[1], $m[3] ); $b = self::g( (float) $m[2], $m[3] );\n\t\t\treturn ( ( $a + $b ) > 0 )\n\t\t\t\t? self::out( 'resolved', (int) round( $a + $b ), $raw, 'bonus_pack' )\n\t\t\t\t: self::out( 'unresolved', null, $raw, null );\n\t\t}\n\t\t// canonical_term: NUMBER UNIT\n\t\tif ( preg_match( '/^(\\d+(?:\\.\\d+)?)\\s*(kg|g)$/', $s, $m ) ) {\n\t\t\t$g = self::g( (float) $m[1], $m[2] );\n\t\t\treturn ( $g > 0 )\n\t\t\t\t? self::out( 'resolved', (int) round( $g ), $raw, 'canonical_term' )\n\t\t\t\t: self::out( 'unresolved', null, $raw, null );\n\t\t}\n\t\treturn self::out( 'unresolved', null, $raw, null );\n\t}\n\tprivate static function g( $n, $u ) { return $u === 'kg' ? $n * 1000.0 : $n * 1.0; }\n\tprivate static function out( $status, $g, $src, $method ) {\n\t\treturn array( 'status' => $status, 'sellable_unit_food_g' => $g, 'source_value' => $src, 'method' => $method );\n\t}\n}\n",
  "payload": "\tprotected function build_table_payload( array $t, $product_id ) {\n\t\t$table_id = (int) $t['id'];\n\n\t\t// hash versijos patikra\n\t\tif ( ($t['canonical_hash_version'] ?? null) !== self::EXPECTED_HASH_VERSION ) {\n\t\t\treturn array('status'=>'HASH_VERSION_MISMATCH','table_id'=>$table_id,'product_id'=>$product_id,\n\t\t\t\t'got'=>$t['canonical_hash_version'] ?? null,'expected'=>self::EXPECTED_HASH_VERSION);\n\t\t}\n\n\t\t$R = $this->pf.'ps_feeding_rows';\n\t\t$raw = $this->db->get_results( $this->db->prepare(\n\t\t\t\"SELECT row_order, weight_from_kg, weight_to_kg, amount_from_g, amount_to_g,\n\t\t\t        condition_dimensions, cell_type, redirect_reason, source_label\n\t\t\t FROM {$R} WHERE feeding_table_id = %d ORDER BY row_order ASC\", $table_id ), ARRAY_A );\n\n\t\tif ( ! is_array($raw) || ! count($raw) ) {\n\t\t\treturn array('status'=>'EMPTY_TABLE_CONTENT','table_id'=>$table_id,'product_id'=>$product_id,\n\t\t\t\t'note'=>'verified lentele be eiluciu — integralumo anomalija');\n\t\t}\n\n\t\t// DB tipų normalizavimas į Calculator sutartį (NULL lieka NULL, decimal -> float)\n\t\t$rows = array();\n\t\tforeach ( $raw as $r ) {\n\t\t\t$cond = array();\n\t\t\tif ( ! empty($r['condition_dimensions']) ) {\n\t\t\t\t$j = json_decode( $r['condition_dimensions'], true );\n\t\t\t\tif ( is_array($j) ) { $cond = $j; }\n\t\t\t}\n\t\t\t$rows[] = array(\n\t\t\t\t'cell_type'       => $r['cell_type'],\n\t\t\t\t'weight_from_kg'  => $this->dec($r['weight_from_kg']),\n\t\t\t\t'weight_to_kg'    => $this->dec($r['weight_to_kg']),\n\t\t\t\t'amount_from_g'   => $this->dec($r['amount_from_g']),\n\t\t\t\t'amount_to_g'     => $this->dec($r['amount_to_g']),\n\t\t\t\t'redirect_reason' => $r['redirect_reason'],   // NULL lieka NULL\n\t\t\t\t'source_label'    => $r['source_label'],\n\t\t\t\t'conditions'      => $cond,                    // Calculator raktas\n\t\t\t);\n\t\t}\n\n\t\t$axis_policy = array();\n\t\tif ( ! empty($t['axis_resolution_policy']) ) {\n\t\t\t$j = json_decode( $t['axis_resolution_policy'], true );\n\t\t\tif ( is_array($j) ) { $axis_policy = $j; }\n\t\t}\n\t\t// fallback: jei axis_resolution_policy tuščias, statom iš resolution_policy svorio ašiai\n\t\tif ( ! count($axis_policy) && ! empty($t['resolution_policy']) ) {\n\t\t\t$wkey = ($t['weight_basis']==='adult_expected') ? 'adult_expected_weight_kg' : 'current_weight_kg';\n\t\t\t$axis_policy[$wkey] = $t['resolution_policy'];\n\t\t}\n\n\t\t$support = $this->classify_support( $t );\n\n\t\treturn array(\n\t\t\t'status'                 => 'OK',\n\t\t\t'support'                => $support,     // calculator_supported|calculator_partial|unsupported_structure\n\t\t\t'table_id'               => $table_id,\n\t\t\t'product_id'             => (int) $product_id,\n\t\t\t'brand'                  => $t['brand'],\n\t\t\t'line'                   => $t['line'],\n\t\t\t'weight_basis'           => $t['weight_basis'],\n\t\t\t'row_dimension'          => $t['row_dimension'],\n\t\t\t'source_structure'       => $t['source_structure'],\n\t\t\t'resolution_policy'      => $t['resolution_policy'],\n\t\t\t'b_path_status'          => $t['b_path_status'],\n\t\t\t'axis_policy'            => $axis_policy,\n\t\t\t'canonical_hash_version' => $t['canonical_hash_version'],\n\t\t\t'source_version'         => $t['source_version'],\n\t\t\t'value_row_count'        => isset($t['value_row_count']) ? (int)$t['value_row_count'] : null,\n\t\t\t'redirect_row_count'     => isset($t['redirect_row_count']) ? (int)$t['redirect_row_count'] : null,\n\t\t\t'rows'                   => $rows,\n\t\t);\n\t}\n"
 },
