{
  "rez": {
    "VERSIJA": "VFP",
    "vf_kodas": {
      "516": "\t//   DRAFT tik jei truksta turinio (nuotrauka, aprasymas, kaina, EAN, likutis).",
      "517": "\t//",
      "518": "\t// Tikrinami blokeriai (bent vienas -> DRAFT):",
      "519": "\t//   - missing_image (nera _thumbnail_id IR nera prikabinto image attachment)",
      "520": "\t//   - missing_description (post_content tuscias)",
      "521": "\t//   - missing_price (kaina = 0 arba neapskaiciuota)",
      "522": "\t//   - missing_ean (nera barcode)",
      "523": "\t//   - qty_zero (likutis = 0)",
      "524": "\t$auto_publish_blockers = [];",
      "525": "",
      "526": "\t// v1.5.4: image check robustiskesnis — featured ARBA prikabintas image attachment.",
      "527": "\t// Apsauga nuo WP All Import eiliskumo (kartais featured nustatomas veliau nei",
      "528": "\t// kvieciamas sis hook'as, bet attachment'ai jau prikabinti).",
      "529": "\t$has_image = has_post_thumbnail( $post_id );",
      "530": "\tif ( ! $has_image ) {",
      "531": "\t\t$img_att = get_attached_media( 'image', $post_id );",
      "532": "\t\t$has_image = ! empty( $img_att );",
      "533": "\t}",
      "534": "\tif ( ! $has_image ) {",
      "535": "\t\t$auto_publish_blockers[] = 'missing_image';",
      "536": "\t}",
      "537": "",
      "538": "\t$post_obj = get_post( $post_id );",
      "539": "\t$content  = $post_obj ? trim( wp_strip_all_tags( $post_obj->post_content ) ) : '';",
      "540": "\tif ( empty( $content ) ) {",
      "541": "\t\t$auto_publish_blockers[] = 'missing_description';",
      "542": "\t}",
      "543": "",
      "544": "\t// Kainos patikra — TIESIOGIAI is meta (ne is $price_result, kuris gali buti nedefinuotas",
      "545": "\t// jei kainodaros blokas del kokios nors priezasties nesuveike arba preke buvo locked)",
      "546": "\t$current_price = (float) get_post_meta( $post_id, '_price', true );",
      "547": "\tif ( $current_price <= 0 ) {",
      "548": "\t\t$auto_publish_blockers[] = 'missing_price';",
      "549": "\t}",
      "550": "",
      "551": "\tif ( empty( $vf_barcode ) ) {",
      "552": "\t\t$auto_publish_blockers[] = 'missing_ean';",
      "553": "\t}",
      "554": "",
      "555": "\tif ( $vf_qty <= 0 ) {",
      "556": "\t\t$auto_publish_blockers[] = 'qty_zero';",
      "557": "\t}",
      "558": "",
      "559": "\tif ( empty( $auto_publish_blockers ) ) {",
      "560": "\t\t// Visi kriterijai OK -> AUTO PUBLISH",
      "561": "\t\twp_update_post( [ 'ID' => $post_id, 'post_status' => 'publish' ] );",
      "562": "\t\tpetshop_xml_log_structured( [",
      "563": "\t\t\t'action'  => 'VF-AUTO-PUBLISH',",
      "564": "\t\t\t'post_id' => $post_id,",
      "565": "\t\t\t'sku'     => $vf_sku,",
      "566": "\t\t\t'brand'   => $brand_normalized,",
      "567": "\t\t\t'price'   => $current_price,",
      "568": "\t\t] );",
      "569": "\t} else {",
      "570": "\t\t// Truksta turinio -> DRAFT",
      "571": "\t\twp_update_post( [ 'ID' => $post_id, 'post_status' => 'draft' ] );",
      "572": "",
      "573": "\t\t$existing_reason = (string) get_post_meta( $post_id, '_petshop_review_reason', true );",
      "574": "\t\t$all_reasons = $existing_reason",
      "575": "\t\t\t? $existing_reason . ', ' . implode( ', ', $auto_publish_blockers )",
      "576": "\t\t\t: implode( ', ', $auto_publish_blockers );",
      "577": "\t\tupdate_post_meta( $post_id, '_petshop_review_reason', $all_reasons );",
      "578": "",
      "579": "\t\tpetshop_xml_log_structured( [",
      "580": "\t\t\t'action'  => 'VF-DRAFT',",
      "581": "\t\t\t'post_id' => $post_id,",
      "582": "\t\t\t'sku'     => $vf_sku,",
      "583": "\t\t\t'price'   => $current_price,",
      "584": "\t\t\t'reasons' => implode( ',', $auto_publish_blockers ),",
      "585": "\t\t] );",
      "586": "\t}",
      "587": "}",
      "588": "",
      "589": "/**",
      "590": " * v1.5.5 (S72 prevencija):",
      "591": " * Sinchroniskai rasom _regular_price, _sale_price, _price + atnaujinam cache/lookup.",
      "592": " *",
      "593": " * KONTEKSTAS (S72 bug'as, istaisytas 2026-06-08):",
      "594": " *   99 VF prekems _sale_price < _regular_price, BET _price likdavo = regular.",
      "595": " *   WC vidine wp_wc_product_meta_lookup lentele skaito _price -> frontend"
    },
    "snippet565": {
      "name": "Petshop VF Sync v1.1 (reprice+stock+publish)",
      "active": "1"
    },
    "snippet565_eil": {
      "7": "*   C. PUBLISH — auto-publish naujoms VF prekėms, kurios praėjo VISUS",
      "13": "*   - Neliečia post_content (aprašymo)",
      "24": "*   ?psc_vf_sync=1&k=ps2026&path=publish&mode=dryrun",
      "25": "*   ?psc_vf_sync=1&k=ps2026&path=[reprice|stock|publish]&mode=apply&confirm=YES",
      "47": "if ( ! in_array( $path, array( 'reprice', 'stock', 'publish' ), true ) ) $path = 'reprice';",
      "59": "elseif ( $path === 'publish' ) $result = petshop_vf_sync_publish( $mode, $limit, $offset, $only_sku );",
      "221": "// Rašom TIK meta laukus (jokio post_content/title/terms)",
      "346": "// C. PUBLISH (auto-publish naujoms VF prekėms, kurios praėjo VISUS filtrus)",
      "349": "//   1. Status = 'draft'",
      "355": "//   7. Turi post_content nekrūvą (>= 30 simbolių po strip_tags)",
      "360": "// Bet kurio kriterijaus nesatisfaktavimas -> praleidžia (lieka draft, review).",
      "362": "function petshop_vf_sync_publish( $mode, $limit, $offset, $only_sku ) {",
      "370": "// Randam draft VF prekes",
      "380": "WHERE p.post_type='product' AND p.post_status='draft'",
      "387": "'path'             => 'publish',",
      "393": "'draft_scanned'    => 0,",
      "401": "'would_publish'    => 0,",
      "405": "$publishable = array();",
      "408": "$stats['draft_scanned']++;",
      "429": "$thumb    = (int) get_post_thumbnail_id( $pid );"
    },
    "temp_isjungta": 1
  }
}