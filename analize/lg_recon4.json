 "zalias_T": "=====TPL 6ecef17d80c15bc553b05deda139f963\n<?php\n/**\n * Sablonas: consent_changed — sutikimo busena pasikeite.\n * Gauna: $payload (name, channel, granted, source, changed_at, prefs_url)\n * Nustato: $subject\n * TZ §4.4.1: \"jus\" mazaja, siuntejas Petshop.lt, fallback be vardo.\n * TEISINIS PEDSAKAS: laiskas patvirtina pakeitima ir nurodo saltini bei laika.\n */\nif ( ! defined( 'ABSPATH' ) ) { exit; }\n\n$name     = isset( $payload['name'] ) ? trim( $payload['name'] ) : '';\n$granted  = ! empty( $payload['granted'] );\n$saltinis = isset( $payload['source'] ) ? (string) $payload['source'] : '';\n$kada     = isset( $payload['changed_at'] ) ? (string) $payload['changed_at'] : '';\n$prefs    = isset( $payload['prefs_url'] ) ? $payload['prefs_url'] : home_url( '/paskyra/' );\n\n$saltiniai = array(\n\t'checkout'     => 'atsiskaitymo metu',\n\t'account'      => 'paskyros nustatymuose',\n\t'newsletter'   => 'naujienlaiškio formoje',\n\t'unsubscribe'  => 'per atsisakymo nuorodą',\n\t'admin'        => 'mūsų darbuotojo',\n\t'import'       => 'perkeliant duomenis',\n);\n$saltinio_tekstas = isset( $saltiniai[ $saltinis ] ) ? $saltiniai[ $saltinis ] : '';\n\n$subject = $granted\n\t? 'Patvirtiname: sutikote gauti mūsų naujienas'\n\t: 'Patvirtiname: naujienų nebesiųsime';\n\n$greet = $name !== '' ? sprintf( 'Sveiki, %s,', esc_html( $name ) ) : 'Sveiki,';\n?>\n<!DOCTYPE html>\n<html lang=\"lt\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title><?php echo esc_html( $subject ); ?></title></head>\n<body style=\"margin:0;padding:0;background:#F3EFE5;font-family:Arial,Helvetica,sans-serif;color:#1F2A24;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3EFE5;padding:24px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#FFFFFF;border-radius:12px;padding:32px;\">\n  <tr><td style=\"font-size:21px;font-weight:700;padding-bottom:8px;\"><?php echo esc_html( $subject ); ?></td></tr>\n  <tr><td style=\"font-size:15px;line-height:1.65;padding-bottom:18px;\">\n    <?php echo $greet; ?>\n    <?php if ( $granted ) : ?>\n      nuo šiol siųsime pasiūlymus ir naudingą informaciją apie augintinių priežiūrą.\n      Rašysime saikingai — tik tada, kai turėsime ką pasakyti.\n    <?php else : ?>\n      naujienų jums nebesiųsime. Su užsakymais susiję laiškai — patvirtinimai,\n      siuntos sekimas, sąskaitos — ateis ir toliau, nes jie būtini paslaugai suteikti.\n    <?php endif; ?>\n  </td></tr>\n  <tr><td style=\"font-size:14px;line-height:1.6;background:#F7F5F0;border-radius:8px;padding:14px 16px;margin-bottom:20px;\">\n    <strong>Pakeitimo įrašas</strong><br>\n    Sprendimas: <?php echo $granted ? 'sutikimas duotas' : 'sutikimas atšauktas'; ?><br>\n    <?php if ( $kada ) : ?>Laikas: <?php echo esc_html( $kada ); ?><br><?php endif; ?>\n    <?php if ( $saltinio_tekstas ) : ?>Užfiksuota: <?php echo esc_html( $saltinio_tekstas ); ?><?php endif; ?>\n  </td></tr>\n  <tr><td s"
