   "563: \tprivate static function surinkti_eilutes( $order ) {",
   "564: \t\t$out = array();",
   "565: ",
   "566: \t\t/* 1) konteineriai: cart_key -> preke_id */",
   "567: \t\t$kont = array();",
   "568: \t\tforeach ( $order->get_items() as $it ) {",
   "569: \t\t\t$raktas = (string) $it->get_meta( '_mnm_cart_key', true );",
   "570: \t\t\tif ( $raktas !== '' ) { $kont[ $raktas ] = (int) $it->get_product_id(); }",
   "571: \t\t}",
   "572: ",
   "573: \t\tforeach ( $order->get_items() as $item_id => $it ) {",
   "574: \t\t\tif ( ! is_a( $it, 'WC_Order_Item_Product' ) ) { continue; }",
   "575: ",
   "576: \t\t\t$var  = (int) $it->get_variation_id();",
   "577: \t\t\t$pid  = (int) $it->get_product_id();",
   "578: \t\t\t$rpid = $var ? $var : $pid;",
   "579: \t\t\t$kiek = (int) $it->get_quantity();",
   "580: ",
   "581: \t\t\t/* Q-E0-4: line_total = BE PVM, line_tax = PVM. Abu KOPIJUOJAMI. */",
   "582: \t\t\t$kaina_ct = self::ct( $it->get_total() );",
   "583: \t\t\t$pvm_ct   = self::ct( $it->get_total_tax() );",
   "584: \t\t\t$sub_ct   = self::ct( $it->get_subtotal() );",
   "585: ",
   "586: \t\t\t$sav_v = $it->get_meta( '_ps_savikaina_vnt', true );",
   "587: \t\t\t$turi  = ( $sav_v !== '' && $sav_v !== null );",
   "588: \t\t\t$sav_vnt_ct = $turi ? self::ct( (float) $sav_v ) : null;",
   "589: \t\t\t$sav_ct     = ( $sav_vnt_ct === null ) ? null : ( $sav_vnt_ct * $kiek );",
   "590: ",
   "591: \t\t\t/* v1.2 / sprendimas B: REGULIARI katalogo kaina pardavimo momentu.",
   "592: \t\t\t   Variacijai — variacijos, MnM vaikui — vaiko prekes. Tuscia -> NULL. */",
   "593: \t\t\t$reg_ct = self::reguliari_neto_ct( $rpid );",
   "594: ",
   "595: \t\t\t$f = self::saltinis( $rpid );",
   "596: \t\t\tlist( $kat_id, $kelias ) = self::kategoriju_kelias( $pid );",
   "597: ",
   "598: \t\t\t$brendas = '';",
   "599: \t\t\t$bt = wp_get_object_terms( $pid, 'product_brand', array( 'fields' => 'slugs' ) );",
   "600: \t\t\tif ( ! is_wp_error( $bt ) && $bt ) { $brendas = (string) $bt[0]; }",
   "601: ",
   "602: \t\t\t$pa = self::pa_uzsaldymas( $rpid );",
   "603: \t\t\t$gyv = '';",
   "604: \t\t\tif ( isset( $pa['pa_gyvunas'][0] ) ) { $gyv = (string) $pa['pa_gyvunas'][0]; }",
   "605: ",
   "606: \t\t\t/* rinkinio klasifikacija */",
   "607: \t\t\t$rink_id = 0; $rink_tipas = ''; $rink_raktas = '';",
   "608: \t\t\t$mano_raktas = (string) $it->get_meta( '_mnm_cart_key', true );",
   "609: \t\t\t$tevo_raktas = (string) $it->get_meta( '_mnm_container', true );",
   "610: \t\t\tif ( $mano_raktas !== '' ) {",
   "611: \t\t\t\t$rink_id = $pid; $rink_tipas = 'mnm'; $rink_raktas = $mano_raktas;",
   "612: \t\t\t} elseif ( $tevo_raktas !== '' && isset( $kont[ $tevo_raktas ] ) ) {",
   "613: \t\t\t\t$rink_id = $kont[ $tevo_raktas ]; $rink_tipas = 'mnm'; $rink_raktas = $tevo_raktas;",
   "614: \t\t\t} else {",
   "615: \t\t\t\t$baze = (int) get_post_meta( $pid, '_dp_base_product_id', true );",
   "616: \t\t\t\t$pqty = (int) get_post_meta( $pid, '_dp_pack_qty', true );",
   "617: \t\t\t\tif ( $baze && $pqty > 0 ) { $rink_id = $pid; $rink_tipas = 'dp'; }",
   "618: \t\t\t}",
   "619: ",
   "620: \t\t\t$prod = $it->get_product();",
   "621: \t\t\t$svoris = 0;",
   "622: \t\t\tif ( $prod && $prod->get_weight() !== '' ) {",
   "623: \t\t\t\t$svoris = (int) round( (float) $prod->get_weight() * 1000 );  /* kg -> g */",
   "624: \t\t\t}",
   "625: \t\t\t$dydis = '';",
   "626: \t\t\t$dt = wp_get_object_terms( $rpid, 'pa_pakuotes_dydis', array( 'fields' => 'names' ) );",
   "627: \t\t\tif ( ! is_wp_error( $dt ) && $dt ) { $dydis = (string) $dt[0]; }",
   "628: ",
   "629: \t\t\t$out[] = array(",
   "630: \t\t\t\t'eilutes_id'              => (int) $item_id,",
   "631: \t\t\t\t'preke_id'                => $pid,",
   "632: \t\t\t\t'variacija_id'            => $var,",
   "633: \t\t\t\t'sku'                     => $prod ? mb_substr( (string) $prod->get_sku(), 0, 64 ) : '',",
   "634: \t\t\t\t'gtin'                    => mb_substr( (string) get_post_meta( $rpid, '_ean', true ), 0, 32 ),",
   "635: \t\t\t\t'pavadinimas_tuo_metu'    => mb_substr( (string) $it->get_name(), 0, 255 ),",
   "636: \t\t\t\t'kategorija_id_giliausia' => $kat_id,",
   "637: \t\t\t\t'kategoriju_kelias'       => wp_json_encode( $kelias, JSON_UNESCAPED_UNICODE ),",
   "638: \t\t\t\t'brendas_slug'            => mb_substr( $brendas, 0, 96 ),",
   "639: \t\t\t\t'gyvunas'                 => mb_substr( $gyv, 0, 48 ),",
   "640: \t\t\t\t'pa_uzsaldymas'           => wp_json_encode( $pa, JSON_UNESCAPED_UNICODE ),",
   "641: \t\t\t\t'sandelis'                => mb_substr( (string) $f['source'], 0, 24 ),",
   "642: \t\t\t\t'tiekejas'                => mb_substr( (string) $f['source'], 0, 24 ),",
   "643: \t\t\t\t'partija_kodas'           => '',",
   "644: \t\t\t\t'kiekis'                  => $kiek,",
   "645: \t\t\t\t'kaina_ct'                => $kaina_ct,",
   "646: \t\t\t\t'pvm_ct'                  => $pvm_ct,",
   "647: \t\t\t\t'kaina_vnt_ct'            => $kiek > 0 ? (int) round( $kaina_ct / $kiek ) : 0,",
   "648: \t\t\t\t'kaina_reguliari_ct'      => $reg_ct,   /* _regular_price, NULL jei nera */",
   "649: \t\t\t\t'savikaina_vnt_ct'        => $sav_vnt_ct,",
   "650: \t\t\t\t'savikaina_ct'            => $sav_ct,",
   "651: \t\t\t\t'savikainos_saltinis'     => mb_substr( (string) $it->get_meta( '_ps_savikaina_saltinis', true ), 0, 32 ),",
   "652: \t\t\t\t'nuolaida_ct'             => max( 0, $sub_ct - $kaina_ct ),",
   "653: \t\t\t\t'akcija_id'               => null,",
   "654: \t\t\t\t'kuponas'                 => '',",
   "655: \t\t\t\t'rinkinys_id'             => $rink_id,",
   "656: \t\t\t\t'rinkinio_tipas'          => $rink_tipas,",
   "657: \t\t\t\t'rinkinio_raktas'         => mb_substr( $rink_raktas, 0, 48 ),",
   "658: \t\t\t\t'dovana'                  => $it->get_meta( '_ps_dovana', true ) ? 1 : 0,",
   "659: \t\t\t\t'svoris_g'                => $svoris,",
   "660: \t\t\t\t'pakuotes_dydis'          => mb_substr( $dydis, 0, 48 ),",
   "661: \t\t\t);",
   "662: \t\t}",
   "663: \t\treturn $out;",
   "664: \t}",
   "665: ",
   "666: \t/* ================================================================== */",
   "667: \t/* KLIENTO EILE                                                       */",
   "668: \t/* ================================================================== */",
   "669: ",
   "670: \t/**",
   "671: \t * Skaiciuojama IS FAKTU, ne is `wc_get_orders` — faktai yra kanoninis",
   "672: \t * saltinis (planas §0). Q6: eShoprent istorijos nera, kohortos nuo Woo.",
   "673: \t * @return array(uzsakymo_nr, naujas, dienos_nuo_ankstesnio)",
   "674: \t */",
   "675: \tprivate static function kliento_eile( $hash, $apmoketa ) {",
   "676: \t\tif ( $hash === '' ) { return array( 1, 1, null ); }",
   "677: \t\tglobal $wpdb;",
   "678: \t\t$t = self::t_uzsakymai();",
   "679: \t\t$n = (int) $wpdb->get_var( $wpdb->prepare(",
   "680: \t\t\t\"SELECT COUNT(*) FROM $t WHERE klientas_email_hash=%s AND apmoketa_at<=%s\", $hash, $apmoketa ) );",
   "681: \t\t$pask = $wpdb->get_var( $wpdb->prepare(",
   "682: \t\t\t\"SELECT MAX(apmoketa_at) FROM $t WHERE klientas_email_hash=%s AND apmoketa_at<=%s\", $hash, $apmoketa ) );",
   "683: \t\t// S1684: eShoprent istorija (ps_ist_fakt_uzsakymai, tas pats sha256 hash) — klientas, pirkes senoje svetaineje, NERA naujas.",
   "684: \t\t$ti = $wpdb->prefix . 'ps_ist_fakt_uzsakymai';",
   "685: \t\tif ( $wpdb->get_var( $wpdb->prepare( 'SHOW TABLES LIKE %s', $ti ) ) === $ti ) {",
   "686: \t\t\t$ni = (int) $wpdb->get_var( $wpdb->prepare( \"SELECT COUNT(*) FROM $ti WHERE klientas_email_hash=%s AND apmoketa_at IS NOT NULL AND apmoketa_at<=%s\", $hash, $apmoketa ) );",
   "687: \t\t\tif ( $ni > 0 ) {",
   "688: \t\t\t\t$n += $ni;",
   "689: \t\t\t\t$paski = $wpdb->get_var( $wpdb->prepare( \"SELECT MAX(apmoketa_at) FROM $ti WHERE klientas_email_hash=%s AND apmoketa_at<=%s\", $hash, $apmoketa ) );",
   "690: \t\t\t\tif ( $paski && ( ! $pask || $paski > $pask ) ) { $pask = $paski; }",
   "691: \t\t\t}",
   "692: \t\t}",
   "693: \t\t$dienos = null;",
   "694: \t\tif ( $pask ) {",
   "695: \t\t\t$dienos = (int) floor( ( strtotime( $apmoketa ) - strtotime( $pask ) ) / DAY_IN_SECONDS );",
   "696: \t\t}",
   "697: \t\treturn array( $n + 1, $n === 0 ? 1 : 0, $dienos );",
   "698: \t}",
   "699: ",
   "700: \t/** Q3: Paysera 0,05 EUR fiksuota uz surinkta mokejima; pavedimas = 0. */"
  ],
