 "R": {
  "VERSIJA": "S1591-R5",
  "attach": [
   "function petshop_xml_vf_attach_to_existing(",
   "\tint $matched_id,",
   "\tint $new_post_id,",
   "\tstring $match_type,",
   "\tstring $vf_brand_raw,",
   "\tstring $brand_normalized,",
   "\tstring $vf_sku,",
   "\tstring $vf_barcode,",
   "\tfloat $vf_cost_xml,",
   "\tfloat $vf_personal_xml,",
   "\tint $vf_qty,",
   "\tstring $wc_slug",
   "): void {",
   "\t$pricing = new Petshop_Pricing_VF();",
   "\t$supplier_discount = $pricing->get_supplier_discount( $brand_normalized );",
   "\t$real_cost = $pricing->apply_supplier_discount( $vf_cost_xml, $brand_normalized );",
   "\t$real_personal = $pricing->apply_supplier_discount( $vf_personal_xml, $brand_normalized );",
   "\tupdate_post_meta( $matched_id, '_vf_enabled', 'yes' );",
   "\tupdate_post_meta( $matched_id, '_vf_cost', $real_cost );",
   "\tupdate_post_meta( $matched_id, '_vf_personal_cost', $real_personal );",
   "\tupdate_post_meta( $matched_id, '_vf_cost_xml', $vf_cost_xml );",
   "\tupdate_post_meta( $matched_id, '_vf_personal_xml', $vf_personal_xml );",
   "\tupdate_post_meta( $matched_id, '_vf_supplier_discount', $supplier_discount );",
   "\tupdate_post_meta( $matched_id, '_vf_qty', $vf_qty );",
   "\tupdate_post_meta( $matched_id, '_vf_supplier_sku', $vf_sku );",
   "\tupdate_post_meta( $matched_id, '_vf_barcode', $vf_barcode );",
   "\tupdate_post_meta( $matched_id, '_vf_brand_raw', $vf_brand_raw );",
   "\tupdate_post_meta( $matched_id, '_vf_brand_normalized', $brand_normalized );",
   "\tupdate_post_meta( $matched_id, '_vf_last_sync', current_time( 'mysql' ) );",
   "\t$fulfillment = new Petshop_Fulfillment();",
   "\t$fulfillment->recalculate( $matched_id );",
   "\tpetshop_xml_log_structured( [",
   "\t\t'action'        => 'VF-MATCH-EXISTING',",
   "\t\t'matched_id'    => $matched_id,",
   "\t\t'new_post_id'   => $new_post_id,",
   "\t\t'match_type'    => $match_type,",
   "\t\t'sku'           => $vf_sku,",
   "\t\t'barcode'       => $vf_barcode,",
   "\t\t'brand'         => $brand_normalized,",
   "\t\t'vf_qty'        => $vf_qty,",
   "\t] );",
   "\tupdate_post_meta( $new_post_id, '_petshop_review_reason', 'vf_duplicate_of_existing' );",
   "\tupdate_post_meta( $new_post_id, '_duplicate_of', $matched_id );",
   "\tupdate_post_meta( $new_post_id, '_vf_duplicate_of', $matched_id );",
   "\tupdate_post_meta( $new_post_id, '_vf_match_type', $match_type );",
   "\twp_trash_post( $new_post_id );",
   "\tupdate_post_meta( $matched_id, '_vf_attached_to_existing', 'yes' );",
   "\tupdate_post_meta( $matched_id, '_vf_has_supplier', 'yes' );",
   "\tupdate_post_meta( $matched_id, '_vf_match_type', $match_type );",
   "\tupdate_post_meta( $matched_id, '_vf_last_matched_import_post_id', $new_post_id );",
   "}",
   "function petshop_xml_vf_create_new(",
   "\tint $post_id,",
   "\tbool $is_update,",
   "\tstring $vf_brand_raw,",
   "\tstring $brand_normalized,",
   "\tstring $vf_sku,",
   "\tstring $vf_barcode,",
   "\tfloat $vf_cost_xml,",
   "\tfloat $vf_personal_xml,",
   "\tint $vf_qty,",
   "\tstring $wc_slug,",
   "\tstring $vf_category",
   "): void {",
   "\t$pricing = new Petshop_Pricing_VF();",
   "\t$supplier_discount = $pricing->get_supplier_discount( $brand_normalized );",
   "\t$real_cost = $pricing->apply_supplier_discount( $vf_cost_xml, $brand_normalized );",
   "\t$real_personal = $pricing->apply_supplier_discount( $vf_personal_xml, $brand_normalized );",
   "\tupdate_post_meta( $post_id, '_vf_enabled', 'yes' );",
   "\tupdate_post_meta( $post_id, '_vf_cost', $real_cost );",
   "\tupdate_post_meta( $post_id, '_vf_personal_cost', $real_personal );",
   "\tupdate_post_meta( $post_id, '_vf_cost_xml', $vf_cost_xml );",
   "\tupdate_post_meta( $post_id, '_vf_personal_xml', $vf_personal_xml );",
   "\tupdate_post_meta( $post_id, '_vf_supplier_discount', $supplier_discount );",
   "\tupdate_post_meta( $post_id, '_vf_qty', $vf_qty );",
   "\tupdate_post_meta( $post_id, '_vf_supplier_sku', $vf_sku );",
   "\tupdate_post_meta( $post_id, '_vf_barcode', $vf_barcode );",
   "\tupdate_post_meta( $post_id, '_vf_brand_raw', $vf_brand_raw );",
   "\tupdate_post_meta( $post_id, '_vf_brand_normalized', $brand_normalized );",
   "\tupdate_post_meta( $post_id, '_vf_last_sync', current_time( 'mysql' ) );",
   "\tif ( $vf_barcode ) {",
   "\t\t$gtin = petshop_xml_gtin_normalize( $vf_barcode );",
   "\t\tupdate_post_meta( $post_id, '_ean', $gtin );",
   "\t\tupdate_post_meta( $post_id, '_global_unique_id', $gtin );",
   "\t}",
   "\tif ( ! $is_update && $vf_sku ) {",
   "\t\t$sku_owner = wc_get_product_id_by_sku( $vf_sku );",
   "\t\tif ( $sku_owner && (int) $sku_owner !== $post_id ) {",
   "\t\t\tupdate_post_meta( $post_id, '_vf_sku_conflict_with', (int) $sku_owner );",
   "\t\t\t$rr = (string) get_post_meta( $post_id, '_petshop_review_reason', true );",
   "\t\t\tupdate_post_meta( $post_id, '_petshop_review_reason', $rr ? $rr . ', sku_conflict' : 'sku_conflict' );",
   "\t\t\tpetshop_xml_log_structured( [",
   "\t\t\t\t'action'      => 'VF-SKU-CONFLICT',",
   "\t\t\t\t'post_id'     => $post_id,",
   "\t\t\t\t'vf_sku'      => $vf_sku,",
   "\t\t\t\t'conflict_id' => (int) $sku_owner,",
   "\t\t\t] );"
  ],
  "stock_sync": [
   "function petshop_xml_vf_stock_sync( int $post_id ): void {",
   "\t$vf_qty = (int) get_post_meta( $post_id, '_vf_qty', true );",
   "\tupdate_post_meta( $post_id, '_vf_last_sync', current_time( 'mysql' ) );",
   "\t$fulfillment = new Petshop_Fulfillment();",
   "\t$fulfillment->update_vf_qty( $post_id, $vf_qty );",
   "\tpetshop_xml_log( \"VF STOCK SYNC post {$post_id} | vf_qty={$vf_qty}\" );",
   "}",
   "function petshop_xml_vf_initial_import( int $post_id, bool $is_update ): void {",
   "\t$vf_brand_raw   = (string) get_post_meta( $post_id, '_vf_brand_raw', true );",
   "\t$vf_sku         = (string) get_post_meta( $post_id, '_vf_supplier_sku', true );",
   "\t$vf_barcode     = (string) get_post_meta( $post_id, '_vf_barcode', true );",
   "\t$vf_cost_xml    = (float)  get_post_meta( $post_id, '_vf_cost_xml', true );",
   "\t$vf_personal_xml = (float) get_post_meta( $post_id, '_vf_personal_xml', true );",
   "\t$vf_qty         = (int)    get_post_meta( $post_id, '_vf_qty', true );",
   "\t$vf_category    = (string) get_post_meta( $post_id, '_vf_category_raw', true );",
   "\t$vf_desc_base64 = (string) get_post_meta( $post_id, '_vf_description_base64', true );",
   "\t$post = get_post( $post_id );",
   "\t$product_name = $post ? $post->post_title : '';",
   "\t$rules = new Petshop_Import_Rules_VF();",
   "\t$decision = $rules->vf_should_import(",
   "\t\t$vf_brand_raw,",
   "\t\t$vf_sku,",
   "\t\t$vf_category,",
   "\t\t$vf_desc_base64,",
   "\t\t$product_name,",
   "\t\t$vf_personal_xml > 0 ? $vf_personal_xml : $vf_cost_xml",
   "\t);",
   "\tif ( ! $decision['import'] ) {",
   "\t\tif ( ! $is_update ) {",
   "\t\t\tpetshop_xml_log_structured( [",
   "\t\t\t\t'action'    => 'VF-REJECTED-NEW',",
   "\t\t\t\t'post_id'   => $post_id,",
   "\t\t\t\t'sku'       => $vf_sku,",
   "\t\t\t\t'brand'     => $vf_brand_raw,",
   "\t\t\t\t'reason'    => $decision['reason'],",
   "\t\t\t] );",
   "\t\t\tupdate_post_meta( $post_id, '_petshop_review_reason', 'vf_' . $decision['reason'] );",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', $decision['reason'] );",
   "\t\t\twp_trash_post( $post_id );",
   "\t\t} else {",
   "\t\t\tupdate_post_meta( $post_id, '_vf_skip_reason', $decision['reason'] );",
   "\t\t\tpetshop_xml_log( \"VF REJECT (existing) post {$post_id} | reason={$decision['reason']}\" );"
  ],
  "update_vf_qty": [
   "    public function update_vf_qty( int $post_id, int $qty ): void {",
   "        update_post_meta( $post_id, '_vf_qty', $qty );",
   "        $this->recalculate( $post_id );",
   "    }",
   "",
   "    /**",
   "     * v1.6.1: rašo AV meta (suderinamumui), bet `_stock` skaičiuojamas",
   "     * tik iš tiekėjų — AV kiekį rodymui prideda Petshop_AV_Limit.",
   "     */",
   "    public function update_own_stock( int $post_id, int $qty ): void {",
   "        update_post_meta( $post_id, '_own_stock_qty', $qty );",
   "        $this->recalculate( $post_id );",
   "    }",
   "",
   "    public function get_active_source( int $post_id ): string {",
   "        return (string) get_post_meta( $post_id, '_active_fulfillment_source', true ) ?: 'unknown';",
   "    }",
   "",
   "    public function get_suppliers(): array { return $this->suppliers; }",
   "}"
  ],
  "recalculate": [
   "    public function recalculate( int $post_id ): string {",
   "        $quantities = $this->get_all_quantities( $post_id );",
   "        foreach ( $this->suppliers as $source_key => $meta_key ) {",
   "            $qty = (int) ( $quantities[ $source_key ] ?? 0 );",
   "            if ( $qty > 0 ) {",
   "                $this->set_wc_stock( $post_id, $qty, $source_key );",
   "                return $source_key;",
   "            }",
   "        }",
   "        $this->set_wc_stock( $post_id, 0, 'out_of_stock' );",
   "        return 'out_of_stock';",
   "    }",
   "    public function get_all_quantities( int $post_id ): array {",
   "        $result = [];",
   "        foreach ( $this->suppliers as $source_key => $meta_key ) {",
   "            $result[ $source_key ] = (int) get_post_meta( $post_id, $meta_key, true );",
   "        }",
   "        return $result;",
   "    }",
   "    private function set_wc_stock( int $post_id, int $qty, string $source ): void {",
   "        update_post_meta( $post_id, '_manage_stock', 'yes' );",
   "        update_post_meta( $post_id, '_active_fulfillment_source', $source );",
   "        wc_update_product_stock( $post_id, $qty, 'set' );",
   "    }",
   "    public function update_zb_qty( int $post_id, int $qty ): void {",
   "        update_post_meta( $post_id, '_zb_qty', $qty );",
   "        $this->recalculate( $post_id );",
   "    }",
   "    public function update_vf_qty( int $post_id, int $qty ): void {",
   "        update_post_meta( $post_id, '_vf_qty', $qty );",
   "        $this->recalculate( $post_id );",
   "    }",
   "    public function update_own_stock( int $post_id, int $qty ): void {",
   "        update_post_meta( $post_id, '_own_stock_qty', $qty );",
   "        $this->recalculate( $post_id );",
   "    }",
   "    public function get_active_source( int $post_id ): string {",
   "        return (string) get_post_meta( $post_id, '_active_fulfillment_source', true ) ?: 'unknown';",
   "    }",
   "    public function get_suppliers(): array { return $this->suppliers; }",
   "}"
  ],
