   "169: add_action('woocommerce_cart_totals_before_order_total', 'petshop_free_shipping_progress', 5);",
   "170: function petshop_free_shipping_progress() {",
   "171:     if ( ! is_cart() ) return;",
   "172: ",
   "173:     $threshold = 30.00;",
   "174: ",
   "175:     $has_courier_only = false;",
   "176:     $total_weight     = 0;",
   "177:     foreach ( WC()->cart->get_cart() as $item ) {",
   "178:         $product_id = $item['product_id'];",
   "179:         /* Ta pati dviejų laukų problema kaip pristatymo filtre (2026-08-28):",
   "180:            varnele kortelėje raso `_ps_tik_kurjeriu`, o cia buvo tikrinamas",
   "181:            tik senasis `_fulfillment_courier_only`. Del to krepselyje",
   "182:            kurjeriui skirta preke vis tiek matydavo „iki nemokamo pristatymo",
   "183:            i pastomata\" — pazadas, kurio ivykdyti neimanoma. */",
   "184:         if ( get_post_meta( $product_id, '_fulfillment_courier_only', true ) === 'yes'",
   "185:              || get_post_meta( $product_id, '_ps_tik_kurjeriu', true ) === 'yes' ) {",
   "186:             $has_courier_only = true;",
   "187:             break;",
   "188:         }",
   "189:         $weight       = (float) get_post_meta( $product_id, '_weight', true );",
   "190:         $total_weight += $weight * $item['quantity'];",
   "191:     }",
   "192:     if ( $total_weight > 30 ) {",
   "193:         $has_courier_only = true;",
   "194:     }",
   "195:     /* S1716 (2026-09-24): tikroji tiesa — ar jau apskaičiuotuose pristatymo tarifuose yra paštomatas.",
   "196:        Venipak pluginas paštomatą išmeta ir dėl matmenų (pvz. ZB maišas 80 cm), ko varnelė/svoris nemato,",
   "197:        o krepšelis žadėdavo „nemokamą pristatymą į paštomatą“, kurio kasoje nebūdavo. */",
   "198:     if ( ! $has_courier_only && function_exists( 'WC' ) && WC()->shipping() ) {",
   "199:         $ps_paketai = WC()->shipping()->get_packages();",
